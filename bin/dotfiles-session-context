#!/usr/bin/env python3
"""Inject a brief work reminder through native session startup APIs."""
import argparse
import json
from pathlib import Path
import sys


def skill_context(path=None):
    path = path or Path.home()/'.config/agent-skills/context-efficiency/SKILL.md'
    content = Path(path).read_text()
    if not content.strip() or len(content) > 16000:
        raise ValueError('context-efficiency está vacía o supera 16000 caracteres')
    marker = '\n## Inicio de sesión\n'
    if marker not in content:
        raise ValueError('Falta el resumen de inicio de context-efficiency')
    summary = content.split(marker, 1)[1].split('\n## ', 1)[0].strip()
    if not summary or len(summary) > 900:
        raise ValueError('El resumen de inicio está vacío o supera 900 caracteres')
    return 'Criterios de trabajo:\n' + summary


def payload(agent):
    context = skill_context()
    if agent == 'codex':
        return {'hookSpecificOutput': {'hookEventName': 'SessionStart', 'additionalContext': context}}
    if agent == 'antigravity':
        return {'injectSteps': [{'systemMessage': {'systemMessage': context}}]}
    policy = Path.home()/'.config/agent-skills/AGENTS.md'
    if policy.is_file():
        context = policy.read_text() + '\nLas skills están disponibles en ~/.cursor/skills/<nombre>/SKILL.md.\n\n' + context
    return {'additional_context': context}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--agent', required=True, choices=('codex', 'cursor', 'antigravity'))
    args = parser.parse_args(argv)
    try:
        result = payload(args.agent)
    except (OSError, ValueError) as error:
        print('No se pudo cargar context-efficiency: '+str(error), file=sys.stderr)
        return 1
    print(json.dumps(result, ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
