{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "arch",
    "color": {
      "1": "#7aa2f7",
      "2": "#bb9af7"
    },
    "padding": {
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "#7aa2f7",
      "title": "#bb9af7"
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "#bb9af7",
        "at": "#565f89",
        "host": "#7dcfff"
      }
    },
    "separator",
    { "type": "os", "key": "  Sistema", "keyColor": "blue" },
    { "type": "host", "key": "󰌢  Equipo", "keyColor": "magenta" },
    { "type": "kernel", "key": "  Kernel", "keyColor": "blue" },
    { "type": "uptime", "key": "󰔟  Encendido", "keyColor": "yellow" },
    { "type": "packages", "key": "󰏖  Paquetes", "keyColor": "green" },
    { "type": "shell", "key": "  Shell", "keyColor": "magenta" },
    { "type": "display", "key": "󰍹  Pantalla", "keyColor": "cyan" },
    { "type": "wm", "key": "  Escritorio", "keyColor": "cyan" },
    { "type": "terminal", "key": "  Terminal", "keyColor": "magenta" },
    { "type": "terminalfont", "key": "  Fuente", "keyColor": "blue" },
    { "type": "cpu", "key": "  CPU", "keyColor": "green" },
    { "type": "gpu", "key": "󰢮  GPU", "keyColor": "green" },
    {
      "type": "memory",
      "key": "  Memoria",
      "keyColor": "yellow",
      "percent": { "type": 2 }
    },
    {
      "type": "disk",
      "key": "󰋊  Disco",
      "keyColor": "yellow",
      "folders": "/",
      "percent": { "type": 2 }
    },
    { "type": "localip", "key": "󰩟  Red local", "keyColor": "cyan" },
    { "type": "battery", "key": "󰁹  Batería", "keyColor": "green" },
    { "type": "locale", "key": "󰗊  Idioma", "keyColor": "blue" },
    "break",
    "colors"
  ]
}
