#!/usr/bin/env bash
set -euo pipefail

# Awesome exposes tags globally through EWMH. Ask it for this output's tags
# instead, so identically named tags on other screens never leak into the bar.
if [[ ${1:-} == --workspaces || ${1:-} == --tag ]]; then
    action=$1
    monitor=${2:-}
    [[ $monitor =~ ^[a-zA-Z0-9_.:-]+$ ]] || exit 2
    index=${3:-1}
    [[ $index =~ ^[1-4]$ ]] || exit 2
    if [[ $action == --tag ]]; then
        awesome-client "for s in screen do if s.outputs['$monitor'] then local t=s.tags[$index]; if t then t:view_only() end end end" >/dev/null
    else
        cache="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/dotfiles-polybar-tags/$monitor"
        if [[ ! -r $cache ]]; then
            awesome-client 'require("polybar-tags").start()' >/dev/null
        fi
        # GNU tail uses inotify here; -F also follows atomic replacements.
        exec tail -n 1 -F -- "$cache" 2>/dev/null
    fi
    exit
fi

# Resolve the CPU sensor by name because hwmon numbers can change on boot.
if [[ ${1:-} == --cpu-temperature ]]; then
    for chip in /sys/class/hwmon/hwmon*; do
        [[ -r $chip/name ]] || continue
        read -r sensor <"$chip/name" || continue
        [[ $sensor == k10temp ]] || continue
        for label in "$chip"/temp*_label; do
            [[ -r $label ]] || continue
            read -r name <"$label" || continue
            [[ $name == Tctl ]] || continue
            input=${label%_label}_input
            if read -r value <"$input" && [[ $value =~ ^[0-9]+$ ]]; then
                if ((value >= 70000)); then
                    printf '%%{F#d35f5e}%d°C%%{F-}\n' "$((value / 1000))"
                else
                    printf '%d°C\n' "$((value / 1000))"
                fi
                exit
            fi
        done
    done
    printf '—\n'
    exit
fi

if [[ ${1:-} == --microphone ]]; then
    if [[ -x $HOME/.local/bin/dotfiles-microphone ]]; then
        case ${2:-status} in
            status) exec "$HOME/.local/bin/dotfiles-microphone" bar ;;
            watch) exec "$HOME/.local/bin/dotfiles-microphone" bar-watch ;;
            menu) exec "$HOME/.local/bin/dotfiles-microphone" compact ;;
            toggle) exec "$HOME/.local/bin/dotfiles-microphone" toggle ;;
            *) exit 2 ;;
        esac
    elif [[ ${2:-status} == toggle ]]; then
        wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle
    else
        printf '\n'
        if [[ ${2:-status} == watch ]]; then sleep 30; fi
    fi
    exit
fi

if [[ ${1:-} == --volume ]]; then
    case ${2:-status} in
        up) wpctl set-volume --limit 1 @DEFAULT_AUDIO_SINK@ 5%+ ;;
        down) wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
        mute) wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle ;;
        status)
            # PipeWire may still be starting. Its diagnostic messages must
            # never become the visible label of this custom module.
            volume=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ 2>/dev/null) || volume=''
            awk '
                /MUTED/ {print "󰖁"; next}
                /^Volume: [0-9.]+/ {printf "%%{F#d35f5e}󰕾%%{F-} %d%%\n", $2 * 100 + 0.5; found=1; next}
                END {if (!found && $0 !~ /MUTED/) print "󰕾 —"}' <<<"$volume"
            ;;
        *) exit 2 ;;
    esac
    exit
fi

if [[ ${1:-} == --brightness ]]; then
    case ${2:-status} in
        up | down)
            card=$(find /sys/class/backlight -mindepth 1 -maxdepth 1 -print -quit)
            [[ -n $card ]] || exit 0
            current=$(<"$card/brightness")
            maximum=$(<"$card/max_brightness")
            step=$(((maximum + 19) / 20))
            if [[ $2 == up ]]; then target=$((current + step)); else target=$((current - step)); fi
            ((target > maximum)) && target=$maximum
            ((target < step)) && target=$step
            if ! brightnessctl --device="${card##*/}" --quiet set "$target" 2>/dev/null; then
                busctl --system call org.freedesktop.login1 /org/freedesktop/login1/session/auto \
                    org.freedesktop.login1.Session SetBrightness ssu backlight "${card##*/}" "$target"
            fi
            ;;
        status)
            brightnessctl --class=backlight --machine-readable info 2>/dev/null | awk -F, '{print $4}'
            ;;
        *) exit 2 ;;
    esac
    exit
fi

# Start one panel for each active output, including secondary monitors.
mapfile -t monitors < <(polybar --list-monitors | cut -d: -f1)
((${#monitors[@]})) || exit 0
WLAN_IFACE=""
BATTERY="$(find /sys/class/power_supply -maxdepth 1 -name 'BAT*' -printf '%f\n' 2>/dev/null | head -n1)"
ADAPTER="$(find /sys/class/power_supply -maxdepth 1 \( -name 'AC*' -o -name 'ADP*' \) -printf '%f\n' 2>/dev/null | head -n1)"
backlight_card="$(find /sys/class/backlight -mindepth 1 -maxdepth 1 -printf '%f\n' 2>/dev/null | head -n1)"
if [[ -n $backlight_card ]]; then
    export BACKLIGHT_CARD="$backlight_card"
else
    unset BACKLIGHT_CARD
fi

export WLAN_IFACE BATTERY ADAPTER

pid_dir="${XDG_RUNTIME_DIR:-/tmp/dotfiles-display-$UID}/dotfiles-polybar-pids"
mkdir -p "$pid_dir"
rm -f -- "$pid_dir"/*
pkill -x polybar 2>/dev/null || true

for monitor in "${monitors[@]}"; do
    while IFS='=' read -r key value; do
        export "$key=$value"
    done < <("$HOME/.local/bin/dotfiles-polybar-style" "$monitor")
    MONITOR=$monitor polybar "$([[ $monitor == "${monitors[0]}" ]] && printf top || printf secondary)" >>"${XDG_RUNTIME_DIR:-/tmp}/polybar.log" 2>&1 &
    printf '%s\n' "$!" >"$pid_dir/$monitor"
done
wait
