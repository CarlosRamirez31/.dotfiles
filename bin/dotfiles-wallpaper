#!/usr/bin/env bash

set -uo pipefail

wallpaper_dir=${DOTFILES_WALLPAPER_DIR:-"$HOME/Pictures/Wallpapers"}
default_wallpaper="$HOME/.config/wallpapers/mocha-aurora.png"
legacy_wallpaper="$HOME/.config/wallpapers/arch-bsod.png"
state_file=${XDG_STATE_HOME:-"$HOME/.local/state"}/dotfiles/wallpaper
declare -a wallpapers=()

load_wallpapers() {
    [[ -d $wallpaper_dir ]] || return 0
    mapfile -d '' -t wallpapers < <(
        find "$wallpaper_dir" -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
            -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
            -o -iname '*.avif' \) -print0 | sort -z
    )
}

apply_default() {
    feh --bg-fill "$default_wallpaper"
}

case ${1:-choose} in
    choose)
        if [[ ! -d $wallpaper_dir ]] ||
            ! find "$wallpaper_dir" -type f \
                \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
                -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
                -o -iname '*.avif' \) -print -quit | grep -q .; then
            apply_default
            exit
        fi
        exec "$HOME/.local/bin/dotfiles-wallpaper-picker" "$wallpaper_dir"
        ;;
    restore)
        saved=''
        [[ -r $state_file ]] && IFS= read -r saved <"$state_file" || true

        [[ $saved == "$legacy_wallpaper" ]] && saved=$default_wallpaper

        if [[ ! -f $saved ]]; then
            load_wallpapers
            saved=${wallpapers[0]:-}
        fi

        [[ -n $saved && -f $saved ]] || saved=$default_wallpaper
        [[ -f $saved ]] || exit 1
        feh --bg-fill "$saved"
        ;;
    *)
        printf 'Uso: %s [choose|restore]\n' "${0##*/}" >&2
        exit 2
        ;;
esac
