[Unit]
Description=Experimental personal voice input (separate from direct RNNoise)
After=pipewire-pulse.service wireplumber.service
Wants=pipewire-pulse.service wireplumber.service
PartOf=pipewire.service

[Service]
ExecStart=%h/.local/bin/dotfiles-microphone serve
Restart=no
TimeoutStopSec=10

[Install]
WantedBy=default.target
