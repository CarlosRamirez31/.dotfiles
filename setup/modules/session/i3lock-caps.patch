+        xkb_state, XKB_MOD_NAME_CAPS, XKB_STATE_MODS_LOCKED) > 0;
+    char *label = NULL;
+    if (asprintf(&label, "%s  |  Caps Lock: %s", answer, caps ? "ON" : "OFF") != -1) {
+        free(answer);
+        answer = label;
+    }
     return answer;
 }
 
