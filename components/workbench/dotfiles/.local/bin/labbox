#!/usr/bin/env bash
set -euo pipefail

script_path=$(realpath -- "${BASH_SOURCE[0]}")
repo_root=$(cd -- "$(dirname -- "$script_path")/../../../../.." && pwd -P)
containerfile="$repo_root/components/workbench/Containerfile"

usage() {
    cat <<'EOF'
Usage:
  labbox build kali|parrot|all
  labbox run kali|parrot [NAME]
  labbox create kali|parrot NAME
  labbox enter NAME
  labbox stop NAME
  labbox rm NAME
  labbox list

run     starts an ephemeral container and deletes it on exit
create  creates a persistent container and opens its shell
enter   starts or enters an existing persistent container

Containers share the host network so they inherit the Arch VM's VPN routes.
No host directory is mounted automatically.
EOF
}

die() {
    printf 'labbox: %s\n' "$*" >&2
    exit 2
}

validate_profile() {
    case $1 in
        kali | parrot) ;;
        *) die "unknown profile '$1' (expected kali or parrot)" ;;
    esac
}

validate_name() {
    [[ $1 =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || die "invalid container name '$1'"
}

image_for() {
    printf 'localhost/dotfiles-%s:latest' "$1"
}

base_for() {
    case $1 in
        kali) printf 'docker.io/kalilinux/kali-rolling:latest' ;;
        parrot) printf 'docker.io/parrotsec/security:latest' ;;
    esac
}

ensure_image() {
    local image
    image=$(image_for "$1")
    sudo podman image exists "$image" || die "image missing; run: labbox build $1"
}

container_options() {
    local name=$1
    printf '%s\n' \
        --name "$name" \
        --hostname "$name" \
        --network host \
        --cap-add NET_RAW \
        --security-opt no-new-privileges
}

build_profile() {
    local profile=$1
    local image base
    validate_profile "$profile"
    image=$(image_for "$profile")
    base=$(base_for "$profile")

    # Reuse a rootless copy of the official base when available. The final
    # lab image remains rootful, but this avoids downloading a multi-gigabyte
    # Parrot base twice during migration from the former Distrobox setup.
    if podman image exists "$base" && ! sudo podman image exists "$base"; then
        printf 'Copying cached base image into rootful Podman storage: %s\n' "$base"
        podman save "$base" | sudo podman load
    fi

    sudo podman build \
        --network host \
        --build-arg "BASE_IMAGE=$base" \
        --build-arg "LAB_PROFILE=$profile" \
        --file "$containerfile" \
        --ignorefile "$repo_root/components/workbench/containerignore" \
        --tag "$image" \
        "$repo_root"
}

command=${1:-}
case $command in
    build)
        profile=${2:-}
        (($# == 2)) || die 'usage: labbox build kali|parrot|all'
        if [[ $profile == all ]]; then
            build_profile kali
            build_profile parrot
        else
            build_profile "$profile"
        fi
        ;;
    run)
        profile=${2:-}
        (($# == 2 || $# == 3)) || die 'usage: labbox run kali|parrot [NAME]'
        validate_profile "$profile"
        ensure_image "$profile"
        name=${3:-"$profile-ephemeral-$(date +%Y%m%d-%H%M%S)-$$"}
        validate_name "$name"
        mapfile -t options < <(container_options "$name")
        sudo podman run --rm --interactive --tty "${options[@]}" "$(image_for "$profile")"
        ;;
    create)
        profile=${2:-}
        name=${3:-}
        (($# == 3)) || die 'usage: labbox create kali|parrot NAME'
        validate_profile "$profile"
        validate_name "$name"
        ensure_image "$profile"
        mapfile -t options < <(container_options "$name")
        sudo podman run --interactive --tty "${options[@]}" "$(image_for "$profile")"
        ;;
    enter)
        name=${2:-}
        (($# == 2)) || die 'usage: labbox enter NAME'
        validate_name "$name"
        if [[ $(sudo podman inspect --format '{{.State.Running}}' "$name" 2>/dev/null) == true ]]; then
            sudo podman exec --interactive --tty "$name" zsh -l
        else
            sudo podman start --attach --interactive "$name"
        fi
        ;;
    stop)
        name=${2:-}
        (($# == 2)) || die 'usage: labbox stop NAME'
        validate_name "$name"
        sudo podman stop "$name"
        ;;
    rm)
        name=${2:-}
        (($# == 2)) || die 'usage: labbox rm NAME'
        validate_name "$name"
        sudo podman rm "$name"
        ;;
    list)
        (($# == 1)) || die 'usage: labbox list'
        sudo podman ps --all --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
        ;;
    help | --help | -h | '') usage ;;
    *) die "unknown command '$command'; run: labbox --help" ;;
esac
