#!/usr/bin/env bash
set -euo pipefail

font_size=${DOTFILES_FONT_SIZE:-}
if [[ -z "$font_size" ]] && command -v dotfiles-display >/dev/null 2>&1; then
    font_size=$(dotfiles-display --font-size-at-pointer 2>/dev/null) || font_size=
fi
font_size=${font_size:-10}
if ! [[ "$font_size" =~ ^[0-9]+([.][0-9]+)?$ ]] || ! awk -v value="$font_size" 'BEGIN { exit !(value >= 8 && value <= 32) }'; then
    font_size=10
fi

# Preserve the existing display font setting: 10 maps to Kitty 15 pt,
# measured to match the previous terminal's 12 x 27 px cells on this X11 setup.
font_size=$(awk -v value="$font_size" 'BEGIN { printf "%g", value * 1.5 }')
exec kitty --override "font_size=$font_size" "$@"
