#!/usr/bin/env bash
set -uo pipefail

errors=0
warnings=0

if [[ -t 1 ]]; then
    green=$'\e[32m'
    yellow=$'\e[33m'
    red=$'\e[31m'
    bold=$'\e[1m'
    reset=$'\e[0m'
else
    green='' yellow='' red='' bold='' reset=''
fi

ok() { printf '%s✓%s %s\n' "$green" "$reset" "$*"; }
warn() {
    printf '%s!%s %s\n' "$yellow" "$reset" "$*"
    warnings=$((warnings + 1))
}
fail() {
    printf '%s✗%s %s\n' "$red" "$reset" "$*"
    errors=$((errors + 1))
}

printf '%sDotfiles desktop doctor%s\n\n' "$bold" "$reset"

essential_commands=(hyprland uwsm zsh alacritty nvim yazi rofi hyprpanel hyprlock hypridle)
optional_commands=(fastfetch thunar grim slurp swappy cliphist wl-copy blueman-manager nft openvpn)
optional_commands+=(restic podman labbox firefox keepassxc btop wf-recorder hyprpicker trash-put)

for command_name in "${essential_commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then
        ok "$command_name available"
    else
        fail "$command_name is missing"
    fi
done

for command_name in "${optional_commands[@]}"; do
    if command -v "$command_name" >/dev/null 2>&1; then
        ok "$command_name available"
    else
        warn "$command_name is not installed"
    fi
done

if command -v fc-match >/dev/null 2>&1; then
    jetbrains_family=$(fc-match -f '%{family[0]}' 'JetBrainsMono Nerd Font' 2>/dev/null)
    if [[ $jetbrains_family == 'JetBrainsMono Nerd Font' ]]; then
        ok 'JetBrainsMono Nerd Font available for terminal icons'
    else
        fail "JetBrainsMono Nerd Font resolves to ${jetbrains_family:-nothing}"
    fi

    emoji_family=$(fc-match -f '%{family[0]}' 'Noto Color Emoji' 2>/dev/null)
    if [[ $emoji_family == 'Noto Color Emoji' ]]; then
        ok 'Noto Color Emoji available for Starship symbols'
    else
        fail "Noto Color Emoji resolves to ${emoji_family:-nothing}"
    fi

    lexend_family=$(fc-match -f '%{family[0]}' Lexend 2>/dev/null)
    if [[ $lexend_family == Lexend ]]; then
        ok 'Lexend available for HyprPanel'
    else
        fail "Lexend resolves to ${lexend_family:-nothing}"
    fi
else
    fail 'fontconfig is missing; cannot validate desktop fonts'
fi

current_shell=$(getent passwd "$(id -un)" | cut -d: -f7)
if [[ ${current_shell##*/} == zsh ]]; then
    ok "Zsh is the login shell"
else
    fail "Login shell is $current_shell (expected Zsh)"
fi

managed_paths=(
    "$HOME/.zshrc"
    "$HOME/.config/hypr/hyprland.lua"
    "$HOME/.config/alacritty/alacritty.toml"
    "$HOME/.config/nvim/init.lua"
    "$HOME/.config/yazi/yazi.toml"
    "$HOME/.config/xdg-desktop-portal/portals.conf"
    "$HOME/.config/fastfetch/config.jsonc"
)
for managed_path in "${managed_paths[@]}"; do
    if [[ -L $managed_path && -e $managed_path ]]; then
        ok "Managed link: ${managed_path#"$HOME"/}"
    elif [[ -e $managed_path ]]; then
        warn "Not managed by Stow: ${managed_path#"$HOME"/}"
    else
        fail "Missing config: ${managed_path#"$HOME"/}"
    fi
done

for service in NetworkManager.service nftables.service; do
    if systemctl is-enabled --quiet "$service" 2>/dev/null; then
        ok "$service enabled"
    else
        warn "$service is not enabled"
    fi
done

for timer in paccache.timer fstrim.timer; do
    if systemctl is-enabled --quiet "$timer" 2>/dev/null; then
        ok "$timer enabled"
    else
        warn "$timer is not enabled"
    fi
done

virtualization=$(systemd-detect-virt --vm 2>/dev/null || true)
if [[ $virtualization == none ]]; then
    if systemctl is-enabled --quiet bluetooth.service 2>/dev/null; then
        ok 'bluetooth.service enabled'
    else
        warn 'bluetooth.service is not enabled'
    fi
else
    ok "Bluetooth service optional in VM ($virtualization)"
fi

for socket in gnome-keyring-daemon.socket gcr-ssh-agent.socket; do
    if systemctl --user is-enabled --quiet "$socket" 2>/dev/null; then
        ok "$socket enabled"
    else
        warn "$socket is not enabled"
    fi
done

if [[ -s $HOME/.config/dotfiles/backup.conf ]]; then
    ok 'Restic backup destination configured'
else
    printf '· Restic awaits a destination: dotfiles-backup setup REPOSITORY\n'
fi

if git config --global --get user.email >/dev/null 2>&1; then
    ok 'Private Git identity configured'
else
    printf '· Git identity remains private and awaits setup.\n'
fi

if [[ -n ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    config_errors=$(hyprctl configerrors 2>/dev/null || true)
    if [[ -n $config_errors ]]; then
        fail "Hyprland configuration errors:\n$config_errors"
    else
        ok 'Active Hyprland configuration has no errors'
    fi

    for service in dotfiles-cliphist-text.service dotfiles-cliphist-image.service; do
        if systemctl --user is-active --quiet "$service"; then
            ok "$service active"
        else
            warn "$service is not active"
        fi
    done
    if systemctl --user is-active --quiet dotfiles-hypridle.service; then
        ok 'dotfiles-hypridle.service active'
    else
        warn 'dotfiles-hypridle.service is not active'
    fi
else
    warn 'Hyprland is not active; live compositor checks were skipped'
fi

printf '\n%sResult:%s %d error(s), %d warning(s).\n' "$bold" "$reset" "$errors" "$warnings"
if ((errors > 0)); then
    printf 'Fix the errors above, then run dotfiles-doctor again.\n'
    exit 1
fi
printf 'The essential desktop configuration is ready.\n'
