#!/usr/bin/env bash

set -uo pipefail

# Display managers can give Hyprland a minimal PATH. Rofi launches desktop
# entries directly, so expose the portable per-user command directory here.
case ":${PATH:-}:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac

# Rofi parses Desktop Entries in native code and keeps an on-disk cache.
exec rofi \
    -show drun \
    -show-icons \
    -drun-use-desktop-cache \
    -drun-reload-desktop-cache \
    -run-command '{cmd}'
