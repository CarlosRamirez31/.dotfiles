#!/usr/bin/env bash

set -uo pipefail

# Hyprland 0.56.x and VMware's vmwgfx currently disagree on GPU buffer
# imports. This local fallback also fixes an already-running session; on a
# physical machine GTK keeps its normal accelerated renderer.
if [[ -z ${GSK_RENDERER:-} && -r /sys/class/dmi/id/sys_vendor ]] \
    && grep -qi vmware /sys/class/dmi/id/sys_vendor; then
    export GSK_RENDERER=cairo
fi

# Rofi's drun mode parses Desktop Entries in native code and keeps an on-disk
# cache. uwsm-app talks to UWSM's persistent daemon instead of starting the
# Python CLI for every selection.
exec /usr/bin/rofi \
    -show drun \
    -show-icons \
    -drun-use-desktop-cache \
    -run-command '/usr/bin/uwsm-app -- {cmd}'
