#!/usr/bin/env bash

set -uo pipefail

# Display managers can provide a minimal PATH. Rofi launches desktop entries
# directly, so expose the portable per-user command directory here.
case ":${PATH:-}:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac

# Rofi parses Desktop Entries in native code and keeps an on-disk cache.
exec "$HOME/.local/bin/dotfiles-app-launch" -- rofi \
    -show drun \
    -show-icons \
    -drun-use-desktop-cache \
    -drun-reload-desktop-cache \
    -run-command '{cmd}'
