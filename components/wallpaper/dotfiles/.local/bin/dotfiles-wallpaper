#!/usr/bin/env bash

set -uo pipefail

wallpaper_dir=${DOTFILES_WALLPAPER_DIR:-"$HOME/Pictures/Wallpapers"}
default_wallpaper="$HOME/.config/wallpapers/arch-bsod.png"
waypaper_state=${XDG_STATE_HOME:-"$HOME/.local/state"}/waypaper/state.ini
declare -a wallpapers=()

if [[ -d $wallpaper_dir ]]; then
    mapfile -d '' -t wallpapers < <(
        find "$wallpaper_dir" -maxdepth 1 -type f \
            \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
            -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
            -o -iname '*.avif' \) -print0 | sort -z
    )
fi

start_daemon() {
    awww query >/dev/null 2>&1 && return 0
    if ! pgrep -x awww-daemon >/dev/null 2>&1; then
        awww-daemon >"${XDG_RUNTIME_DIR:-/tmp}/awww-dotfiles.log" 2>&1 &
    fi

    local attempt=0
    while ((attempt < 20)); do
        awww query >/dev/null 2>&1 && return 0
        sleep 0.1
        ((attempt += 1))
    done
    return 1
}

apply_default() {
    start_daemon || return 1
    awww img "$default_wallpaper" --transition-type none
}

image=${wallpapers[0]:-}

case ${1:-choose} in
    choose)
        if [[ -z $image ]]; then
            apply_default
            exit
        fi
        exec "$HOME/.local/bin/dotfiles-wallpaper-picker" "$wallpaper_dir"
        ;;
    restore)
        if [[ -z $image ]]; then
            apply_default
            exit
        fi
        start_daemon || exit 1
        saved=''
        if [[ -r $waypaper_state ]]; then
            saved=$(sed -n 's/^wallpaper = //p' "$waypaper_state" | head -n 1)
            saved=${saved/#\~/$HOME}
        fi

        saved_exists=false
        for candidate in "${wallpapers[@]}"; do
            if [[ $candidate == "$saved" ]]; then
                saved_exists=true
                break
            fi
        done

        if [[ $saved_exists == true ]]; then
            waypaper --backend awww --restore >/dev/null 2>&1 ||
                waypaper --backend awww --wallpaper "$image" --fill fill
        else
            waypaper --backend awww --wallpaper "$image" --fill fill
        fi
        ;;
    *)
        printf 'Uso: %s [choose|restore]\n' "${0##*/}" >&2
        exit 2
        ;;
esac
