{
  "bar.layouts": {
    "0": {
      "left": ["dashboard", "windowtitle", "media", "updates"],
      "middle": ["workspaces"],
      "right": ["volume", "network", "battery", "cpu", "clock", "hypridle", "notifications"]
    },
    "1": {
      "left": ["dashboard", "workspaces", "windowtitle"],
      "middle": ["media"],
      "right": ["volume", "clock", "notifications"]
    },
    "2": {
      "left": ["dashboard", "workspaces", "windowtitle"],
      "middle": ["media"],
      "right": ["volume", "clock", "notifications"]
    }
