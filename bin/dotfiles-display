                #display-panel headerbar { background: #1e1e2e; color: #cdd6f4; border: 0; box-shadow: none; }
                #display-panel .section-title { color: #cba6f7; font-weight: bold; font-size: 14px; }
                #display-panel .muted { color: #a6adc8; }
                #display-panel .monitor-row { background: #262637; border: 1px solid #36364b; border-radius: 12px; padding: 12px; }
                #display-panel button { background: #313244; color: #cdd6f4; border: 1px solid #45475a; border-radius: 8px; box-shadow: none; text-shadow: none; padding: 8px 14px; }
                #display-panel button:hover { background: #45475a; border-color: #cba6f7; }
                #display-panel button.suggested-action { background: #cba6f7; color: #181825; border-color: #cba6f7; font-weight: bold; }
                #display-panel button.suggested-action:hover { background: #dcc4ff; }
                #display-panel check, #display-panel radio { background: #181825; border-color: #585b70; }
                #display-panel check:checked, #display-panel radio:checked { background: #cba6f7; color: #181825; }
                #display-panel scrolledwindow { border: 0; }
            ''')
            Gtk.Settings.get_default().set_property('gtk-application-prefer-dark-theme', True)
            Gtk.StyleContext.add_provider_for_screen(self.get_screen(), self.css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            header = Gtk.HeaderBar(title='Pantallas', subtitle='Tu espacio de trabajo')
            header.set_show_close_button(True)
            self.set_titlebar(header)
            self.outputs = outputs
            self.drag = None
            self.pending = None
            self.preview_timer = None
            self.output_widgets = []
            self.live_labels = {}
            self.connect('delete-event', self.close)
            root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, margin=16)
            viewport = Gtk.ScrolledWindow()
            viewport.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
            viewport.add(root)
            self.add(viewport)
            heading = Gtk.Label(label='Organiza tus monitores', xalign=0)
            heading.get_style_context().add_class('section-title')
            root.pack_start(heading, False, False, 0)
            hint = Gtk.Label(label='Arrastra las pantallas para ordenarlas. Los selectores se activan al pulsar Aplicar.', xalign=0, wrap=True)
            hint.get_style_context().add_class('muted')
            root.pack_start(hint, False, False, 0)
            scroll = Gtk.ScrolledWindow()
            self.canvas = Gtk.DrawingArea()
            self.canvas.set_size_request(760, 180)
            scroll.set_min_content_height(190)
            self.canvas.add_events(Gdk.EventMask.BUTTON_PRESS_MASK | Gdk.EventMask.BUTTON_RELEASE_MASK | Gdk.EventMask.POINTER_MOTION_MASK)
            self.canvas.connect('draw', self.draw)
            self.canvas.connect('button-press-event', self.press)
            self.canvas.connect('motion-notify-event', self.motion)
            self.canvas.connect('button-release-event', self.release)
            scroll.add_with_viewport(self.canvas)
            root.pack_start(scroll, True, True, 0)
            controls = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
            self.selector = Gtk.ComboBoxText()
            self.pages = Gtk.Stack()
            self.pages.set_homogeneous(False)
            self.selected_output = None
            self.scale_widgets = {}
            self.font_size_widgets = {}
            self.bar_widgets = {}
            self.syncing = False
            controls.pack_start(Gtk.Label(label='Selecciona una pantalla para configurarla', xalign=0), False, False, 0)
            controls.pack_start(self.selector, False, False, 0)
            controls.pack_start(self.pages, True, True, 0)
            root.pack_start(controls, True, True, 0)
            self.primary_buttons = []
            group = None
            right = max((o['x'] + size(o)[0] for o in outputs if o['enabled']), default=0)
            for number, output in enumerate(outputs, 1):
                if not output['mode'] and output['modes']:
                    output.update(mode=output['modes'][0], x=right)
                    right += size(output)[0]
                self.selector.append(output['name'], f"{number}. {display_name(output)} · {output['name']}")
                page = Gtk.Grid(column_spacing=22, row_spacing=6)
                page.get_style_context().add_class('monitor-row')
                live = Gtk.Label(label=active_description(output), xalign=0)
                live.get_style_context().add_class('muted')
                page.attach(live, 0, 0, 3, 1)
                self.live_labels[output['name']] = live
                enabled = Gtk.CheckButton(label='Usar esta pantalla')
                enabled.set_active(output['enabled'])
                enabled.connect('toggled', self.enable, output)
                page.attach(enabled, 0, 1, 1, 1)
                primary = Gtk.RadioButton.new_with_label_from_widget(group, 'Pantalla principal')
                group = primary
                self.primary_buttons.append((primary, output))
                page.attach(primary, 1, 1, 2, 1)
                modes = Gtk.ComboBoxText()
                for index, mode in enumerate(output['modes']):
                    modes.append_text(mode + (' · Máxima' if index == 0 else '') +
                                      (' · Preferida' if mode == output.get('preferred') else ''))
                if output['mode'] in output['modes']:
                    modes.set_active(output['modes'].index(output['mode']))
                rates = Gtk.ComboBoxText()
                self.fill_rates(rates, output)
                modes.connect('changed', self.mode, output, rates)
                rates.connect('changed', self.rate, output)
                page.attach(Gtk.Label(label='Resolución', xalign=0), 0, 2, 1, 1)
                page.attach(modes, 1, 2, 1, 1)
                maximum = Gtk.Button(label='Máxima')
                maximum.set_sensitive(bool(output['modes']))
                maximum.connect('clicked', self.maximum, output, modes, rates)
                page.attach(maximum, 2, 2, 1, 1)
                page.attach(Gtk.Label(label='Frecuencia', xalign=0), 0, 3, 1, 1)
                page.attach(rates, 1, 3, 2, 1)
                scale = Gtk.ComboBoxText()
                values = sorted(set([100, 110, 125, 150, 175, 200, output.get('scale', 100)]))
                for value in values:
                    scale.append(f'{value:g}', f'{value:g} %' + (' · Tamaño original' if value == 100 else ''))
                scale.set_active_id(f"{output.get('scale', 100):g}")
                scale.connect('changed', self.scaling, output)
                self.scale_widgets[output['name']] = scale
                page.attach(Gtk.Label(label='Escala de aplicaciones', xalign=0), 0, 4, 1, 1)
                page.attach(scale, 1, 4, 2, 1)
                font_size = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 8, 32, 0.1)
                font_size.set_digits(1)
                font_size.set_draw_value(True)
                font_size.set_value_pos(Gtk.PositionType.RIGHT)
                font_size.set_value(output.get('font_size', 10))
                font_size.connect('value-changed', self.font_sizing, output)
                self.font_size_widgets[output['name']] = font_size
                page.attach(Gtk.Label(label='Tamaño de fuente (pt)', xalign=0), 0, 5, 1, 1)
                page.attach(font_size, 1, 5, 2, 1)
                bar = Gtk.ComboBoxText()
                for value in (75, 90, 100, 110, 125, 150, 175, 200):
                    bar.append(str(value), str(value) + ' %')
                bar.set_active_id(str(output.get('polybar_scale', 100)))
                bar.connect('changed', self.bar_scaling, output)
                self.bar_widgets[output['name']] = bar
                page.attach(Gtk.Label(label='Tamaño de Polybar', xalign=0), 0, 6, 1, 1)
                page.attach(bar, 1, 6, 2, 1)
                note = Gtk.Label(label='La escala y el tamaño de fuente se aplican al abrir aplicaciones desde Awesome, según el monitor del puntero. Cierra y vuelve a abrirlas para aplicar cambios. Polybar usa su ajuste propio.', xalign=0, wrap=True)
                note.get_style_context().add_class('muted')
                page.attach(note, 0, 7, 3, 1)
                self.pages.add_named(page, output['name'])
                self.output_widgets.append((output, enabled, primary, modes, rates))
            self.selector.connect('changed', self.select_monitor)
            if outputs:
                self.selector.set_active(0)
            chosen = next((button for button, o in self.primary_buttons if o['primary']), group)
            if chosen:
                chosen.set_active(True)
            for button, output in self.primary_buttons:
                button.connect('toggled', self.primary, output)
            self.message = Gtk.Label(xalign=0, wrap=True)
            root.pack_start(self.message, False, False, 0)
            refresh = Gtk.Button(label='Actualizar estado real')
            refresh.connect('clicked', self.refresh_live)
            header.pack_end(refresh)
            self.connect('focus-in-event', self.refresh_live)
            actions = Gtk.Box(spacing=10)
            lid = Gtk.Button(label='Tapa y energía…')
            lid.connect('clicked', self.lid_settings)
            actions.pack_start(lid, False, False, 0)
            for title, callback in [('Extender en fila', self.extend), ('Duplicar', self.mirror), ('Aplicar', self.commit)]:
                button = Gtk.Button(label=title)
                button.connect('clicked', callback)
                if title == 'Aplicar':
                    button.get_style_context().add_class('suggested-action')
                    actions.pack_end(button, False, False, 0)
                else:
                    actions.pack_start(button, False, False, 0)
            root.pack_start(actions, False, False, 0)
            recover = Gtk.Button(label='Recuperar imagen de los monitores')
            recover.set_tooltip_text('Reactiva juntas las salidas externas sin guardar otra distribución.')
            recover.connect('clicked', self.recover_image)
            root.pack_start(recover, False, False, 0)
            self.recover_button = recover
            self.editing_widgets = [self.canvas, controls, actions]
            self.confirmation = Gtk.Box(spacing=12)
            self.confirmation.get_style_context().add_class('monitor-row')
            self.confirmation_label = Gtk.Label(xalign=0, wrap=True)
            self.confirmation.pack_start(self.confirmation_label, True, True, 0)
            revert = Gtk.Button(label='Restaurar')
            revert.connect('clicked', self.finish_preview, False)
            self.confirmation.pack_start(revert, False, False, 0)
            keep = Gtk.Button(label='Conservar')
            keep.get_style_context().add_class('suggested-action')
            keep.connect('clicked', self.finish_preview, True)
            self.confirmation.pack_start(keep, False, False, 0)
            root.pack_start(self.confirmation, False, False, 0)
            self.confirmation.set_no_show_all(True)
            self.connect('destroy', Gtk.main_quit)
            self.connect('destroy', lambda *_: Gtk.StyleContext.remove_provider_for_screen(self.get_screen(), self.css))
            self.show_all()

        def select_monitor(self, combo):
            name = combo.get_active_id()
            if name:
                self.selected_output = name
                self.pages.set_visible_child_name(name)
                self.changed()

        def scaling(self, combo, output):
            if self.syncing or not combo.get_active_id():
                return
            old_size = size(output)
            output['scale'] = float(combo.get_active_id())
            reflow(self.outputs, output, old_size)
            self.changed()

        def font_sizing(self, slider, output):
            if self.syncing:
                return
            output['font_size'] = round(slider.get_value() * 10) / 10
            self.changed()

        def bar_scaling(self, combo, output):
            if not self.syncing and combo.get_active_id():
                output['polybar_scale'] = int(combo.get_active_id())

        def update_live(self, outputs):
            actual = {o['name']: o for o in outputs}
            for name, label in self.live_labels.items():
                label.set_text(active_description(actual.get(name)))

        def refresh_live(self, *_):
            try:
                self.update_live(query(current=True))
            except (OSError, subprocess.SubprocessError) as error:
                for label in self.live_labels.values():
                    label.set_text('No se pudo comprobar el estado actual')
                self.message.set_text('No se pudo leer la configuración activa: ' + str(error))
            return False

        def changed(self):
            self.canvas.queue_draw()

        def lid_settings(self, _):
            dialog = Gtk.Dialog(title='Tapa y energía', transient_for=self, modal=True)
            dialog.set_default_size(560, 440)
            dialog.set_name('lid-settings')
            css = Gtk.CssProvider()
            css.load_from_data(b'''
                #lid-settings { background: #181825; color: #cdd6f4; }
                #lid-settings .lid-card { background: #313244; border-radius: 12px; padding: 16px; }
                #lid-settings .lid-title { color: #cba6f7; font-size: 22px; font-weight: bold; }
                #lid-settings button.suggested-action { background: #cba6f7; color: #181825; }
            ''')
            Gtk.StyleContext.add_provider_for_screen(dialog.get_screen(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            box = dialog.get_content_area()
            box.set_spacing(16)
            box.set_border_width(24)
            title = Gtk.Label(label='Al cerrar la tapa', xalign=0)
            title.get_style_context().add_class('lid-title')
            box.pack_start(title, False, False, 0)
            box.pack_start(Gtk.Label(label='Elige cómo se comporta tu laptop en cada situación.', xalign=0, wrap=True), False, False, 0)
            grid = Gtk.Grid(column_spacing=24, row_spacing=14)
            grid.get_style_context().add_class('lid-card')
            box.pack_start(grid, False, False, 0)
            choices = [('suspend', 'Suspender'), ('ignore', 'Seguir funcionando'),
                       ('lock', 'Bloquear sesión'), ('hibernate', 'Hibernar'), ('poweroff', 'Apagar')]
            status = Gtk.Label(xalign=0, wrap=True)
            combos = []
            try:
                current = lid_policy()
            except (OSError, subprocess.SubprocessError):
                current = [None] * 3
                status.set_text('No se pudo leer la configuración. Cierra este menú y vuelve a intentarlo.')
            for index, (icon, label) in enumerate([
                    ('battery-good-symbolic', 'Con batería'),
                    ('ac-adapter-symbolic', 'Conectada a corriente'),
                    ('video-display-symbolic', 'Con monitores externos')]):
                row = Gtk.Box(spacing=10)
                row.pack_start(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.LARGE_TOOLBAR), False, False, 0)
                row.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
                grid.attach(row, 0, index, 1, 1)
                combo = Gtk.ComboBoxText()
                for value, text in choices:
                    combo.append(value, text)
                if current[index] and current[index] not in dict(choices):
                    combo.append(current[index], 'Actual: ' + current[index])
                if current[index]:
                    combo.set_active_id(current[index])
                grid.attach(combo, 1, index, 1, 1)
                combos.append(combo)
            lid = Gtk.CheckButton(label='Usar solo los monitores externos con la tapa cerrada')
            try:
                option = json.loads(OPTIONS.read_text()).get('external_only_when_closed', True)
            except (OSError, ValueError, AttributeError):
                option = True
            lid.set_active(bool(option))
            lid.connect('toggled', self.lid_option, status)
            box.pack_start(lid, False, False, 0)
            box.pack_start(Gtk.Label(label='Con monitores externos se usa la tercera opción.\nLa hibernación requiere estar configurada en el sistema.', xalign=0, wrap=True), False, False, 0)
            box.pack_start(status, False, False, 0)
            dialog.add_button('Cerrar', Gtk.ResponseType.CLOSE)
            save = dialog.add_button('Guardar cambios', Gtk.ResponseType.APPLY)
            save.get_style_context().add_class('suggested-action')
            save.set_sensitive(all(current))
            busy = [False]

            def finish(error):
                busy[0] = False
                save.set_sensitive(True)
                status.set_text(error or 'Cambios guardados y activos.')
                return False

            def response(_, response_id):
                if busy[0]:
                    return
                if response_id != Gtk.ResponseType.APPLY:
                    dialog.destroy()
                    return
                auth = Gtk.Dialog(title='Autorizar cambios', transient_for=dialog, modal=True)
                auth.set_name('lid-auth')
                auth.add_buttons('Cancelar', Gtk.ResponseType.CANCEL, 'Guardar', Gtk.ResponseType.OK)
                content = auth.get_content_area()
                content.set_border_width(20)
                content.set_spacing(12)
                content.add(Gtk.Label(label='Introduce tu contraseña para cambiar la política de energía.', wrap=True))
                entry = Gtk.Entry(visibility=False, activates_default=True)
                entry.set_input_purpose(Gtk.InputPurpose.PASSWORD)
                content.add(entry)
                auth.set_default_response(Gtk.ResponseType.OK)
                auth.show_all()
                answer = auth.run()
                password = entry.get_text()
                entry.set_text('')
                auth.destroy()
                if answer != Gtk.ResponseType.OK:
                    return
                actions = [combo.get_active_id() for combo in combos]
                busy[0] = True
                save.set_sensitive(False)
                status.set_text('Guardando…')
                def worker():
                    error = None
                    try:
                        configure_lid(actions, password=password)
                    except subprocess.CalledProcessError:
                        error = 'No se pudo guardar. Verifica tu contraseña y los permisos de administración.'
                    except (OSError, subprocess.SubprocessError, ValueError) as exc:
                        error = 'No se pudo completar el cambio: ' + str(exc)
                    GLib.idle_add(finish, error)
                threading.Thread(target=worker, daemon=True).start()

            dialog.connect('response', response)
            dialog.connect('delete-event', lambda *_: busy[0])
            dialog.connect('destroy', lambda *_: Gtk.StyleContext.remove_provider_for_screen(self.get_screen(), css))
            dialog.show_all()

        def lid_option(self, button, status=None):
            message = status if status is not None else self.message
            try:
                OPTIONS.parent.mkdir(parents=True, exist_ok=True)
                temporary = OPTIONS.with_suffix('.tmp')
                temporary.write_text(json.dumps({'external_only_when_closed': button.get_active()}) + '\n')
                temporary.replace(OPTIONS)
                message.set_text('Preferencia de pantallas guardada. Se aplicará al cerrar el panel de pantallas.')
            except OSError as error:
                message.set_text('No se pudo guardar: ' + str(error))

        def enable(self, button, output):
            output['enabled'] = button.get_active()
            self.changed()

        def primary(self, button, output):
            if button.get_active():
                for item in self.outputs:
                    item['primary'] = item is output
                self.changed()

        def maximum(self, _, output, modes, rates):
            modes.set_active(0)
            available = output.get('rates', {}).get(output['mode'], [])
            if available:
                rates.set_active_id(max(available, key=float))

        def fill_rates(self, combo, output):
            values = output.get('rates', {}).get(output['mode'], [])
            selected = output.get('rate')
            if selected not in values:
                selected = values[0] if values else None
            output.pop('rate', None)
            if selected:
                output['rate'] = selected
            combo.remove_all()
            for value in values:
                combo.append(value, value + ' Hz')
            if selected:
                combo.set_active_id(selected)
            combo.set_sensitive(bool(values))

        def rate(self, combo, output):
            value = combo.get_active_id()
            if value:
                output['rate'] = value
            self.changed()

        def mode(self, combo, output, rates):
            index = combo.get_active()
            if index >= 0:
                old_size = size(output)
                mode = output['modes'][index]
                if mode != output['mode']:
                    output.pop('rate', None)
                output['mode'] = mode
                self.fill_rates(rates, output)
                if not self.syncing:
                    reflow(self.outputs, output, old_size)
            self.changed()

        def rectangles(self):
            enabled = [o for o in self.outputs if o['enabled'] and o['mode']]
            left = min((o['x'] for o in enabled), default=0)
            top = min((o['y'] for o in enabled), default=0)
            extent_w = max((o['x'] - left + size(o)[0] for o in enabled), default=1)
            extent_h = max((o['y'] - top + size(o)[1] for o in enabled), default=1)
            if not self.drag:
                self.preview_scale = min(.18, max(1, self.canvas.get_allocated_width()-64)/extent_w,
                                         max(1, self.canvas.get_allocated_height()-64)/extent_h)
            scale = self.preview_scale
            offset_x = (self.canvas.get_allocated_width() - extent_w * scale) / 2
            offset_y = (self.canvas.get_allocated_height() - extent_h * scale) / 2
            if self.drag:
                left, top, offset_x, offset_y = self.drag_transform
            else:
                self.drag_transform = (left, top, offset_x, offset_y)
            for o in enabled:
                w, h = size(o)
                yield o, (o['x'] - left) * scale + offset_x, (o['y'] - top) * scale + offset_y, w * scale, h * scale

        def draw(self, widget, cr):
            cr.set_source_rgb(.12, .12, .18)
            cr.paint()
            rectangles = list(self.rectangles())
            for index, (o, x, y, w, h) in enumerate(rectangles, 1):
                cr.save()
                gap = min(5, w/10, h/10)
                x, y, w, h = x+gap, y+gap, w-2*gap, h-2*gap
                radius = min(12, w/4, h/4)
                from math import pi
                cr.new_sub_path()
                for cx, cy, start in [(x+w-radius, y+radius, -pi/2), (x+w-radius, y+h-radius, 0),
                                       (x+radius, y+h-radius, pi/2), (x+radius, y+radius, pi)]:
                    cr.arc(cx, cy, radius, start, start+pi/2)
                cr.close_path()
                cr.set_source_rgb(*((.26, .23, .37) if o['primary'] else (.19, .20, .28)))
                cr.fill_preserve()
                cr.set_source_rgb(*((.80, .65, .97) if o['name'] == self.selected_output else (.38, .41, .53)))
                cr.set_line_width(2)
                cr.stroke_preserve()
                cr.clip()
                for text, font_size, baseline, color in [
                        (str(index), 30, y+h/2-6, (.80, .65, .97)),
                        (display_name(o) + (' · Principal' if o['primary'] else ''), 12, y+h/2+18, (.90, .90, .96)),
                        (o['mode'], 11, y+h/2+38, (.65, .68, .78))]:
                    cr.set_source_rgb(*color)
                    cr.set_font_size(font_size)
                    extents = cr.text_extents(text)
                    cr.move_to(x+(w-extents[2])/2-extents[0], baseline)
                    cr.show_text(text)
                cr.restore()

        def press(self, _, event):
            if event.button != 1:
                return
            for o, x, y, w, h in reversed(list(self.rectangles())):
                if x <= event.x <= x+w and y <= event.y <= y+h:
                    self.selector.set_active_id(o['name'])
                    self.drag = (o, event.x, event.y, o['x'], o['y'])
                    break

        def motion(self, _, event):
            if self.drag:
                o, x, y, ox, oy = self.drag
                o['x'], o['y'] = round(ox+(event.x-x)/self.preview_scale), round(oy+(event.y-y)/self.preview_scale)
                self.changed()

        def release(self, *_):
            if self.drag:
                output = self.drag[0]
                snap_output(self.outputs, output, self.drag[4])
                self.drag = None
                self.changed()

        def extend(self, *_):
            right = 0
            for output in self.outputs:
                if output['enabled']:
                    output.update(x=right, y=0)
                    right += size(output)[0]
            self.changed()

        def mirror(self, *_):
            enabled = [o for o in self.outputs if o['enabled']]
            common = set.intersection(*(set(o['modes']) for o in enabled)) if enabled else set()
            if not common:
                self.message.set_text('Estas pantallas no tienen una resolución común para duplicar.')
                return
            mode = max(common, key=lambda value: int(value.split('x')[0])*int(value.split('x')[1]))
            for output in enabled:
                if output['mode'] != mode:
                    output.pop('rate', None)
                output.update(mode=mode, scale=100, x=0, y=0)
                self.scale_widgets[output['name']].set_active_id('100')
            for output, _, _, modes, rates in self.output_widgets:
                modes.set_active(output['modes'].index(output['mode']))
                self.fill_rates(rates, output)
            self.changed()

        def commit(self, *_):
            if self.pending is not None:
                return
            try:
                validate_layout(self.outputs)
                before = query()
                apply(self.outputs)
                actual = query(current=True)
                verify_applied(self.outputs, actual)
                self.update_live(actual)
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                if 'before' in locals():
                    self.restore(before)
                    self.sync_outputs()
                self.message.set_text('No se pudo aplicar: ' + str(error))
                return
            self.pending = before
            self.remaining = 20
            for widget in self.editing_widgets:
                widget.set_sensitive(False)
            self.confirmation.set_no_show_all(False)
            self.confirmation.show_all()
            self.confirmation_label.set_text('Prueba tus monitores. Se restaura en 20 segundos.')
            def tick():
                self.remaining -= 1
                self.confirmation_label.set_text(f'¿Se ven bien? Se restaura en {self.remaining} segundos.')
                if self.remaining <= 0:
                    self.preview_timer = None
                    self.finish_preview(None, False)
                    return False
                return True
            self.preview_timer = GLib.timeout_add_seconds(1, tick)

        def recover_image(self, *_):
            if self.pending is not None:
                self.finish_preview(None, False)
                return
            try:
                apply(query(), force_reset=True)
                self.sync_outputs()
                self.message.set_text('Salidas externas reactivadas juntas. Comprueba la imagen en cada monitor.')
            except (OSError, ValueError, subprocess.SubprocessError) as error:
                self.message.set_text('No se pudo recuperar la imagen: ' + str(error))

        def finish_preview(self, _, keep):
            if self.pending is None:
                return
            before, self.pending = self.pending, None
            if self.preview_timer is not None:
                GLib.source_remove(self.preview_timer)
                self.preview_timer = None
            if keep:
                try:
                    actual = query()
                    if {o['name'] for o in actual} != {o['name'] for o in before}:
                        raise ValueError('Las pantallas conectadas cambiaron durante la prueba.')
                    verify_applied(self.outputs, actual)
                    save(actual)
                    self.message.set_text('Configuración guardada para este conjunto de pantallas.')
                except (OSError, ValueError, subprocess.SubprocessError) as error:
                    self.restore(before)
                    self.message.set_text('No se pudo guardar: ' + str(error))
            else:
                self.restore(before)
                self.message.set_text('Se restauró la configuración anterior.')
            self.confirmation.hide()
            self.confirmation.set_no_show_all(True)
            for widget in self.editing_widgets:
                widget.set_sensitive(True)
            self.sync_outputs()

        def sync_outputs(self):
            try:
                self.syncing = True
                actual = {o['name']: o for o in query()}
                self.update_live(actual.values())
                for output, enabled, primary, modes, rates in self.output_widgets:
                    if output['name'] not in actual:
                        continue
                    output.update(actual[output['name']])
                    enabled.set_active(output['enabled'])
                    primary.set_active(output['primary'])
                    modes.remove_all()
                    for index, mode in enumerate(output['modes']):
                        modes.append_text(mode + (' · Máxima' if index == 0 else '') +
                                      (' · Preferida' if mode == output.get('preferred') else ''))
                    if output['mode'] in output['modes']:
                        modes.set_active(output['modes'].index(output['mode']))
                    self.fill_rates(rates, output)
                    self.scale_widgets[output['name']].set_active_id(f"{output.get('scale', 100):g}")
                    self.font_size_widgets[output['name']].set_value(output.get('font_size', 10))
                    self.bar_widgets[output['name']].set_active_id(str(output.get('polybar_scale', 100)))
                self.syncing = False
                self.changed()
            except (OSError, subprocess.SubprocessError) as error:
                self.syncing = False
                self.message.set_text('No se pudo actualizar el panel: ' + str(error))

        def restore(self, before):
            try:
                connected = {o['name'] for o in query()}
                available = [o for o in before if o['name'] in connected]
                apply(available)
            except (ValueError, subprocess.SubprocessError):
                automatic(query())

        def close(self, *_):
            if self.pending is not None:
                self.finish_preview(None, False)
            return False

    panel = Panel()
    if '--lid-settings' in sys.argv:
        GLib.idle_add(panel.lid_settings, None)
    Gtk.main()


def main():
    if '--lid-policy' in sys.argv:
        configure_lid(sys.argv[sys.argv.index('--lid-policy') + 1:])
        return
    if '--scale-at-pointer' in sys.argv:
        print(f'{scale_at_pointer():g}')
        return
    if '--font-size-at-pointer' in sys.argv:
        print(f'{font_size_at_pointer():g}')
        return
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/dotfiles-display-{os.getuid()}'))
    runtime.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (runtime / 'dotfiles-display.lock').open('w') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            return
        auto = '--auto' in sys.argv and '--recover' not in sys.argv
        hardware_stamp = runtime / 'dotfiles-display-hardware-topology'
        hardware = hardware_topology() if auto else None
        if hardware is not None:
            hardware = 'apps-scale-v6:' + hardware
        if hardware is not None and hardware_stamp.exists() and hardware_stamp.read_text() == hardware:
            return
        cleaned = disable_disconnected_outputs() if auto else False
        outputs = query(current=auto and hardware is None)
        if '--status' in sys.argv:
            print(json.dumps(outputs, ensure_ascii=False, indent=2))
        elif '--recover' in sys.argv:
            report = []
            for args in [['xrandr', '--query'], ['xrandr', '--listproviders'], ['xrandr', '--listmonitors']]:
                result = subprocess.run(args, capture_output=True, text=True, timeout=15)
                report.append(' '.join(args) + '\n' + result.stdout + result.stderr)
            CONFIG.parent.mkdir(parents=True, exist_ok=True)
            (CONFIG.parent / 'display-diagnostics.log').write_text('\n'.join(report))
            apply(outputs, force_reset=True)
            print('Salidas reactivadas juntas. Diagnóstico guardado en ' + str(CONFIG.parent / 'display-diagnostics.log'))
        elif '--auto' in sys.argv:
            # Act on connection changes, rather than repeatedly forcing a saved
            # layout over the live session every five seconds.
            topology = key(outputs)
            stamp = runtime / 'dotfiles-display-topology'
            if cleaned or not stamp.exists() or stamp.read_text() != topology:
                automatic(outputs)
                stamp.write_text(topology)
            if hardware is not None:
                hardware_stamp.write_text(hardware)
        else:
            gui(outputs)


if __name__ == '__main__':
    try:
        main()
    except (subprocess.SubprocessError, OSError, ValueError) as error:
        print(f'Pantallas: {error}', file=sys.stderr)
        sys.exit(1)
