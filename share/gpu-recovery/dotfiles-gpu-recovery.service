[Unit]
Description=Watch and recover Lenovo LOQ NVIDIA GPE10 wake loop
After=systemd-udev-trigger.service
ConditionPathExists=/sys/firmware/acpi/interrupts/gpe10
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/python3 -u /usr/local/libexec/dotfiles-gpu-recovery
ExecStopPost=/usr/bin/python3 /usr/local/libexec/dotfiles-gpu-recovery --restore
Restart=on-failure
RestartSec=20
TimeoutStopSec=10
RuntimeDirectory=dotfiles-gpu-recovery
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=restart
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/sys/firmware/acpi/interrupts/gpe10

[Install]
WantedBy=multi-user.target
