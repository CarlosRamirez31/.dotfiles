#!/usr/bin/env bash
set -euo pipefail

root=${COUCOU_HOME:-"$HOME/.local/opt/coucou"}
executable="$root/squashfs-root/usr/bin/coucou"
if [[ ! -x $executable ]]; then
    printf 'Coucou no está instalado en %s\n' "$root" >&2
    exit 127
fi

# Prefer Arch's WebKit/GTK/GStreamer, then fall back to libraries bundled with
# the AppImage. The executable is launched directly, so reproduce AppRun's
# library search path for dependencies such as libgtk-layer-shell.
export LD_LIBRARY_PATH="/usr/lib:$root/squashfs-root/usr/lib:$root/squashfs-root/usr/lib64${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export COUCOU_HERMES_BRIDGE=1
export COUCOU_POLYBAR_CSS="${XDG_CONFIG_HOME:-$HOME/.config}/coucou/polybar.css"
if [[ -f $root/polybar-theme.so ]]; then
    export LD_PRELOAD="$root/polybar-theme.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi
exec "$executable" "$@"
