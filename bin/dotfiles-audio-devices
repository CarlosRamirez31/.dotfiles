#!/usr/bin/env python3
"""Enumerate and select current Pulse/PipeWire outputs, ports and profiles."""
import json
import os
import subprocess
import sys


def pulse(*args):
    return subprocess.run(('pactl', *args), check=True, capture_output=True, text=True,
                          timeout=4, env={**os.environ, 'LC_ALL': 'C'}).stdout.strip()


def listing(kind):
    return json.loads(pulse('--format=json', 'list', kind))


def clean(value):
    return ' '.join(str(value).split())[:130]


def available(value):
    return value not in (False, 'no', 'not available')


def ports(sink):
    values = sink.get('ports', {})
    return values if isinstance(values, dict) else {item['name']: item for item in values}


def internal_stream(stream):
    props = stream.get('properties', {})
    return (str(props.get('node.virtual', '')).lower() in ('true', '1')
            or props.get('application.name') == 'dotfiles-microphone'
            or props.get('node.name', '').startswith(('dotfiles_voice_', 'input.dotfiles_personal_voice',
                                                      'input.dotfiles_microphone'))
            or props.get('target.object') == 'dotfiles_personal_voice_bus')


def outputs():
    default = pulse('get-default-sink')
    rows = []
    for sink in listing('sinks'):
        if sink['name'] == 'dotfiles_personal_voice_bus':
            continue
        identifier = str(int(sink['index']))
        connectors = [(key, port) for key, port in ports(sink).items()
                      if available(port.get('availability'))]
        if connectors:
            for key, port in connectors:
                rows.append(('port', identifier, key,
                             int(sink['name'] == default and sink.get('active_port') == key),
                             clean(sink['description']) + ' · ' + clean(port['description'])))
        else:
            rows.append(('sink', identifier, '-', int(sink['name'] == default), clean(sink['description'])))
    for card in listing('cards'):
        for key, profile in card.get('profiles', {}).items():
            if profile.get('sinks', 0) > 0 and available(profile.get('available')):
                rows.append(('profile', str(int(card['index'])), key, int(card.get('active_profile') == key),
                             clean(card.get('properties', {}).get('device.description', card['name'])) + ' · ' + clean(profile['description'])))
    return rows


def inputs():
    default = pulse('get-default-source')
    rows = []
    for source in listing('sources'):
        if source.get('monitor_of_sink') not in (None, 4294967295, '4294967295') or source['name'].endswith('.monitor'):
            continue
        identifier = str(int(source['index']))
        connectors = [(key, port) for key, port in ports(source).items()
                      if available(port.get('availability'))]
        if connectors:
            for key, port in connectors:
                rows.append(('source-port', identifier, key,
                             int(source['name'] == default and source.get('active_port') == key),
                             clean(port['description'])))
        else:
            rows.append(('source', identifier, '-', int(source['name'] == default), clean(source['description'])))
    return rows


def route(sink):
    pulse('set-default-sink', sink['name'])
    failed = False
    for stream in listing('sink-inputs'):
        if internal_stream(stream):
            continue
        try:
            pulse('move-sink-input', str(int(stream['index'])), sink['name'])
        except subprocess.SubprocessError:
            # Streams may disappear while the output is changing.
            failed = any(item['index'] == stream['index'] for item in listing('sink-inputs')) or failed
    if failed:
        raise ValueError('Output selected; some applications could not be moved.')


def apply(kind, identifier, key):
    if kind in ('source', 'source-port'):
        source = next((item for item in listing('sources') if str(item['index']) == identifier), None)
        if not source or source.get('monitor_of_sink') not in (None, 4294967295, '4294967295') or source['name'].endswith('.monitor'):
            raise ValueError('This input is no longer available.')
        if kind == 'source-port':
            port = ports(source).get(key)
            if not port or not available(port.get('availability')):
                raise ValueError('This input connector is unavailable.')
            pulse('set-source-port', source['name'], key)
        pulse('set-default-source', source['name'])
        for stream in listing('source-outputs'):
            if internal_stream(stream):
                continue
            pulse('move-source-output', str(int(stream['index'])), source['name'])
    elif kind in ('sink', 'port'):
        sink = next((item for item in listing('sinks') if str(item['index']) == identifier), None)
        if not sink or sink.get('name') == 'dotfiles_personal_voice_bus':
            raise ValueError('This output is no longer connected.')
        if kind == 'port':
            port = ports(sink).get(key)
            if not port or not available(port.get('availability')):
                raise ValueError('This connector is unavailable.')
            pulse('set-sink-port', sink['name'], key)
        route(sink)
    elif kind == 'profile':
        card = next((item for item in listing('cards') if str(item['index']) == identifier), None)
        profile = card and card.get('profiles', {}).get(key)
        if not profile or not profile.get('sinks', 0) or not available(profile.get('available')):
            raise ValueError('This playback profile is unavailable.')
        pulse('set-card-profile', card['name'], key)
    else:
        raise ValueError('Unknown audio control.')


def main():
    if len(sys.argv) == 1:
        for row in outputs(): print(*row, sep='\t')
    elif sys.argv[1:] == ['inputs']:
        for row in inputs(): print(*row, sep='\t')
    elif len(sys.argv) == 4:
        apply(*sys.argv[1:])
    else:
        raise ValueError('Invalid audio command.')


if __name__ == '__main__':
    try:
        main()
    except (OSError, subprocess.SubprocessError, ValueError, KeyError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
