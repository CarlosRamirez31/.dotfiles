#!/usr/bin/env bash
set -euo pipefail
if [[ ${CONTAINER_ID:-} != dev ]]; then exec dotfiles-dev-exec lazydocker "$@"; fi
source "$HOME/.local/libexec/dotfiles-container-env"
dotfiles_container_env "$@"
export PATH="$HOME/.local/libexec/lazydocker:$PATH"
if [[ -x /usr/bin/lazydocker ]]; then exec /usr/bin/lazydocker "$@"; fi
exec "$HOME/.local/libexec/lazydocker/lazydocker" "$@"
