#!/usr/bin/env bash
set -euo pipefail

config_dir=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles
config_file="$config_dir/backup.conf"
exclude_file="$config_dir/backup-excludes"
state_dir=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/backup

# A weekly cycle starts on Monday at 10:00 in the local time zone.
weekly_cycle() {
    local monday
    monday=$(date -d "$(date +%F) -$(( $(date +%u) - 1 )) days 10:00" +%s)
    if (( $(date +%s) < monday )); then
        monday=$(date -d "$(date -d "@$monday" +%F) -7 days 10:00" +%s)
    fi
    printf '%s\n' "$monday"
}

finish_cycle() {
    mkdir -p -- "$state_dir"
    printf '%s\n' "${DOTFILES_BACKUP_CYCLE:-$(weekly_cycle)}" >"$state_dir/finished-cycle"
}

backup_header() {
    printf '\033[2J\033[H\n\033[1;35m  ◇  TU RESPALDO SEMANAL\033[0m\n\n'
    printf '  Tus archivos, protegidos.\n'
    printf '\033[2m  La contraseña solo se usa durante la copia.\033[0m\n\n'
}

choose_backup_action() {
    local choice
    local allow_start=${1:-false}
    printf '  [2] Reintentar más tarde · en 2 horas\n'
    printf '  [3] Cancelar esta semana\n\n'
    while true; do
        choice=
        if ! read -rt 120 -p '  Elige una opción › ' choice; then
            choice=2
        fi
        case $choice in
            1) if $allow_start; then return 0; fi ;;
            2|'') printf '\n  Te lo recordaré dentro de 2 horas.\n'; return 2 ;;
            3)
                finish_cycle
                printf '\n  Cancelado por esta semana.\n  Volveré el lunes a las 10 a. m.\n'
                return 3
                ;;
            *) printf '  Escribe el número de una opción.\n' ;;
        esac
    done
}

usage() {
    printf 'Usage: %s {setup REPOSITORY|run|popup|scheduled-popup|scheduled-run|preview|snapshots|check|restore [SNAPSHOT] TARGET}\n' "${0##*/}"
}

load_config() {
    if [[ ! -s $config_file ]]; then
        printf 'Backup is not configured. Run: dotfiles-backup setup REPOSITORY\n' >&2
        exit 1
    fi
    # This is a private, user-owned shell configuration so arrays and $HOME
    # remain usable without introducing a second configuration language.
    # shellcheck disable=SC1090
    source "$config_file"
    : "${RESTIC_REPOSITORY:?RESTIC_REPOSITORY is missing}"
    # Passwords are entered through the terminal, never loaded from a file.
    unset RESTIC_PASSWORD RESTIC_PASSWORD_FILE RESTIC_PASSWORD_COMMAND
    export RESTIC_REPOSITORY
    if ! declare -p BACKUP_PATHS >/dev/null 2>&1; then
        BACKUP_PATHS=("$HOME")
    elif ((${#BACKUP_PATHS[@]} == 0)); then
        BACKUP_PATHS=("$HOME")
    fi
}

require_terminal() {
    [[ -t 0 ]] || {
        printf 'Introduce la contraseña desde una terminal; usa dotfiles-backup popup.\n' >&2
        exit 1
    }
}

prepare_destination() {
    if [[ -n ${BACKUP_DISK_UUID:-} ]]; then
        local mounted
        mounted=$(findmnt -rn -S "UUID=$BACKUP_DISK_UUID" -o TARGET || true)
        if [[ -z $mounted ]]; then
            printf '  Conectando con tu disco de respaldo…\n'
            mkdir -p -- "$state_dir"
            udisksctl mount -b "/dev/disk/by-uuid/$BACKUP_DISK_UUID" >"$state_dir/mount.log" 2>&1 || {
                printf '\n  No pude abrir tu disco de respaldo.\n  Comprueba que esté conectado y desbloqueado.\n' >&2
                return 1
            }
            mounted=$(findmnt -rn -S "UUID=$BACKUP_DISK_UUID" -o TARGET)
        fi
        [[ $RESTIC_REPOSITORY == "$mounted"/* ]] || {
            printf 'El destino configurado no corresponde al disco de respaldo.\n' >&2
            return 1
        }
    fi
}

run_backup() {
    load_config
    require_terminal
    mkdir -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles-backup"
    exec 8>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles-backup/run.lock"
    flock -n 8 || {
        printf 'Ya hay un respaldo en curso.\n' >&2
        return 1
    }
    prepare_destination
    printf '\033[2m  Disco de respaldo listo\033[0m\n\n'
    local create_repository=false confirmation
    if [[ $RESTIC_REPOSITORY == /* && ! -e $RESTIC_REPOSITORY/config ]]; then
        create_repository=true
        printf '  Respaldo nuevo. Elige una contraseña\n  y guardala en un lugar seguro.\n\n'
    fi
    read -rt 120 -sp '  Contraseña › ' RESTIC_PASSWORD
    printf '\n'
    [[ -n $RESTIC_PASSWORD ]] || {
        printf 'La contraseña no puede estar vacia.\n' >&2
        return 1
    }
    if $create_repository; then
        read -rt 120 -sp '  Repite      › ' confirmation
        printf '\n'
        [[ $RESTIC_PASSWORD == "$confirmation" ]] || {
            unset RESTIC_PASSWORD confirmation
            printf 'Las contraseñas no coinciden.\n' >&2
            return 1
        }
        unset confirmation
    fi
    # Share the password only in process memory for backup and retention.
    export RESTIC_PASSWORD
    trap 'unset RESTIC_PASSWORD' EXIT
    if $create_repository; then restic init; fi
    local extra_excludes=()
    if [[ $RESTIC_REPOSITORY == "$HOME"/* ]]; then
        extra_excludes+=(--exclude "$RESTIC_REPOSITORY")
    fi
    restic backup "${BACKUP_PATHS[@]}" --exclude-caches \
        --exclude-file "$exclude_file" "${extra_excludes[@]}"
    restic forget --keep-daily 7 --keep-weekly 4 --keep-monthly 6 --prune
    unset RESTIC_PASSWORD
}

case ${1:-} in
    setup)
        repository=${2:-}
        [[ -n $repository ]] || {
            usage >&2
            exit 2
        }
        require_terminal
        mkdir -p -- "$config_dir"
        umask 077
        {
            printf 'RESTIC_REPOSITORY=%q\n' "$repository"
            printf 'BACKUP_PATHS=(%q)\n' "$HOME"
        } >"$config_file"
        chmod 600 "$config_file"
        load_config
        require_terminal
        restic init
        systemctl --user daemon-reload
        systemctl --user enable --now dotfiles-backup.timer
        printf 'Backup configured. A floating terminal will request your password weekly. Start now with: dotfiles-backup popup\n'
        ;;
    run)
        umask 077
        run_backup
        ;;
    scheduled-popup)
        umask 077
        export DOTFILES_BACKUP_CYCLE
        DOTFILES_BACKUP_CYCLE=$(weekly_cycle)
        if [[ -f $state_dir/finished-cycle ]] &&
            [[ $(cat "$state_dir/finished-cycle") == "$DOTFILES_BACKUP_CYCLE" ]]; then
            exit 0
        fi
        exec "$0" popup
        ;;
    popup)
        mkdir -p "${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles-backup"
        exec 9>"${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/dotfiles-backup/popup.lock"
        flock -n 9 || exit 0
        "$HOME/.local/bin/dotfiles-terminal" --class DotfilesBackup \
            --option window.padding.x=20 --option window.padding.y=16 \
            --option window.dimensions.columns=64 --option window.dimensions.lines=20 \
            --title 'Respaldo · Beambollow' -e "$0" scheduled-run
        ;;
    scheduled-run)
        umask 077
        require_terminal
        backup_header
        printf '  ¿Hacemos una copia de tus archivos?\n\n'
        printf '  [1] Iniciar respaldo ahora\n'
        if ! choose_backup_action true; then exit 0; fi
        backup_header
        # A child shell preserves errexit inside run_backup and reports failures.
        if "$0" run; then
            finish_cycle
            printf '\n\033[1;32m  ✓  Tus archivos ya están respaldados.\033[0m\n'
            printf '  Próximo respaldo: lunes a las 10 a. m.\n\n'
            read -rt 120 -p '  Pulsa Enter para cerrar › ' _ || true
        else
            printf '\n\033[1;35m  Dejamos tu respaldo pendiente.\033[0m\n'
            printf '  Puedes conectar el disco y volver más tarde.\n\n'
            # The next attempt is scheduled even if the window is closed.
            choose_backup_action || true
        fi
        ;;
    preview)
        backup_header
        printf '  ¿Hacemos una copia de tus archivos?\n\n'
        printf '  [1] Iniciar respaldo ahora\n'
        printf '  [2] Reintentar más tarde · en 2 horas\n'
        printf '  [3] Cancelar esta semana\n\n'
        printf '\033[2m  Vista previa · no inicia una copia.\033[0m\n\n'
        read -rt 120 -p '  Enter para cerrar › ' _ || true
        ;;
    snapshots)
        load_config
        require_terminal
        restic snapshots
        ;;
    check)
        load_config
        require_terminal
        restic check
        ;;
    restore)
        snapshot=${2:-latest}
        target=${3:-}
        [[ -n $target ]] || {
            usage >&2
            exit 2
        }
        target=$(realpath -m -- "$target")
        home_path=$(realpath -m -- "$HOME")
        if [[ $target == / || $target == "$home_path" || $home_path == "$target"/* ]]; then
            printf 'Restore requires a separate empty directory, not the home or its ancestors.\n' >&2
            exit 2
        fi
        if [[ -e $target ]] && { [[ ! -d $target ]] || [[ -n $(find "$target" -mindepth 1 -maxdepth 1 -print -quit) ]]; }; then
            printf 'Restore destination must be an empty directory.\n' >&2
            exit 2
        fi
        load_config
        require_terminal
        mkdir -p -- "$target"
        restic restore "$snapshot" --target "$target"
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
