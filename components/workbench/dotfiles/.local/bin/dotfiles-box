#!/usr/bin/env bash
set -euo pipefail

usage() {
    printf 'Usage: %s {create|enter|stop|remove|list} [dev|pentest]\n' "${0##*/}"
    printf '       %s setup pentest\n' "${0##*/}"
}

prepare_kali_tmpfiles() {
    # Distrobox intentionally shares the host /tmp. Kali's systemd package
    # currently tries to chown that directory and its X11 socket directories
    # during the first apt transaction, which rootless Podman must reject.
    # Mask only those tmpfiles rules: Arch already manages the shared paths.
    podman unshare sh -eu -c '
        container_name=$1
        container_root=$(podman mount "$container_name")
        trap '\''podman unmount "$container_name" >/dev/null 2>&1 || true'\'' EXIT
        mkdir -p "$container_root/etc/tmpfiles.d"
        ln -sfn /dev/null "$container_root/etc/tmpfiles.d/tmp.conf"
        ln -sfn /dev/null "$container_root/etc/tmpfiles.d/x11.conf"
        podman unmount "$container_name" >/dev/null
        trap - EXIT
    ' sh "$name"
}

setup_pentest() {
    distrobox enter --name "$name" -- /bin/bash -lc '
        set -euo pipefail
        export DEBIAN_FRONTEND=noninteractive

        sudo apt-get update
        sudo apt-get install -y \
            zsh starship fastfetch eza fzf zoxide vivid bat ripgrep fd-find \
            zsh-autosuggestions zsh-syntax-highlighting \
            git curl wget unzip zip make gcc cmake nodejs npm \
            python3 python3-pip python3-venv neovim tree-sitter-cli \
            wl-clipboard jq lazygit \
            nmap ffuf gobuster feroxbuster sqlmap nikto whatweb \
            netcat-openbsd socat bind9-dnsutils whois \
            smbclient enum4linux-ng seclists wordlists

        if ! command -v fd >/dev/null 2>&1 && command -v fdfind >/dev/null 2>&1; then
            sudo ln -sfn "$(command -v fdfind)" /usr/local/bin/fd
        fi
        if ! command -v bat >/dev/null 2>&1 && command -v batcat >/dev/null 2>&1; then
            sudo ln -sfn "$(command -v batcat)" /usr/local/bin/bat
        fi

        # LazyVim records viewed news in its config directory. Use a temporary
        # copy for unattended setup so provisioning never dirties the dotfiles
        # repository; plugins and parsers still install in the user data path.
        temporary_config=$(mktemp -d)
        trap '\''rm -rf -- "$temporary_config"'\'' EXIT
        cp -aL "$HOME/.config/nvim" "$temporary_config/nvim"
        XDG_CONFIG_HOME=$temporary_config nvim --headless "+Lazy! sync" +qa
        XDG_CONFIG_HOME=$temporary_config nvim --headless \
            "+lua require('\''config.treesitter'\'').install()" +qa
        rm -rf -- "$temporary_config"
        trap - EXIT
    '

    printf 'Pentest environment ready. Enter it with: dotfiles-box enter pentest\n'
}

profile=${2:-dev}
case $profile in
    dev)
        name=dotfiles-dev
        image=docker.io/library/archlinux:latest
        ;;
    pentest)
        name=dotfiles-pentest
        image=docker.io/kalilinux/kali-rolling:latest
        ;;
    *)
        printf 'Profile must be dev or pentest.\n' >&2
        exit 2
        ;;
esac

case ${1:-} in
    create)
        distrobox create --yes --name "$name" --image "$image"
        if [[ $profile == pentest ]]; then
            prepare_kali_tmpfiles
            setup_pentest
        fi
        printf 'Container ready. Enter it with: dotfiles-box enter %s\n' "$profile"
        ;;
    setup)
        if [[ $profile != pentest ]]; then
            printf 'The setup command is currently available for the pentest profile only.\n' >&2
            exit 2
        fi
        prepare_kali_tmpfiles
        setup_pentest
        ;;
    enter)
        distrobox enter "$name"
        ;;
    stop)
        distrobox stop --yes "$name"
        ;;
    remove)
        read -rp "Remove $name and its installed packages? [y/N] " answer
        [[ $answer == [yY] ]] || exit 0
        distrobox rm --yes "$name"
        ;;
    list)
        distrobox list
        ;;
    *)
        usage >&2
        exit 2
        ;;
esac
