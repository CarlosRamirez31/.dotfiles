#!/usr/bin/env python3
"""Print Polybar dimensions for one output, independently of desktop zoom."""
import json
import math
import os
from pathlib import Path
import sys


def style(appearance):
    # Application UI scale is injected into launched apps; Polybar has its own size control.
    try:
        value = float(appearance.get('polybar_scale', 100)) if isinstance(appearance, dict) else 100
        factor = value / 100 if math.isfinite(value) else 1
    except (TypeError, ValueError):
        factor = 1
    factor = max(.375, min(2, factor))
    values = {'POLYBAR_HEIGHT': str(max(12, round(30 * factor))),
              'POLYBAR_BORDER': str(max(1, round(7 * factor))),
              'POLYBAR_LINE': str(max(1, round(3 * factor)))}
    for index, (family, size, offset) in enumerate([
            ('JetBrainsMono Nerd Font:style=Bold', 12.5, 3),
            ('JetBrainsMono Nerd Font', 19, 5),
            ('JetBrainsMono Nerd Font:style=Bold', 13, 3),
            ('Iosevka Nerd Font:antialias=true', 13, 0),
            ('JetBrainsMono Nerd Font:style=Bold', 9, 2),
            ('JetBrainsMono Nerd Font:style=Bold', 15, 3)]):
        values[f'POLYBAR_FONT_{index}'] = f'{family}:size={size * factor:g};{round(offset * factor)}'
    return values


def main():
    runtime = Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/dotfiles-display-{os.getuid()}'))
    try:
        state = json.loads((runtime / 'dotfiles-display-appearance.json').read_text())
    except (OSError, ValueError):
        state = {}
    appearance = state.get(sys.argv[1], {}) if isinstance(state, dict) else {}
    for key, value in style(appearance).items():
        print(key + '=' + value)


if __name__ == '__main__':
    main()
