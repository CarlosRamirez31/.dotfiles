# BESTerlockscreen-style Betterlockscreen theme for Awesome/X11.
# The lock layout is Betterlockscreen's native clock + unlock indicator.
i3lockcolor_bin="i3lock"
fx_list=(dim)
dim_level=48
wallpaper_cmd="feh --bg-fill"
quiet=true

# Native Betterlockscreen composition, tinted to match Mocha Aurora.
loginbox=00000000
loginshadow=00000000
locktext=""
font="JetBrainsMono Nerd Font"
ringcolor=cba6f7ff
insidecolor=11111b66
separatorcolor=00000000
ringvercolor=89dcebff
insidevercolor=11111bcc
ringwrongcolor=f38ba8ff
insidewrongcolor=f38ba8cc
time_format="%H:%M"
timecolor=e4d2ffff
greetercolor=cdd6f4ff
layoutcolor=a6adc8ff
keyhlcolor=cba6f7ff
bshlcolor=f38ba8ff
veriftext="Verifying..."
verifcolor=89dcebff
wrongtext="Wrong password"
wrongcolor=f38ba8ff
modifcolor=cba6f7ff
bgcolor=11111bff

# Keep the clock above the center artwork and the native unlock indicator below.
lockargs+=(--time-pos="x+w/2:y+h*0.19" --time-align=0 --time-size=64)
lockargs+=(--date-str="%A, %d %B" --date-pos="x+w/2:y+h*0.19+29"
    --date-align=0 --date-size=14 --date-color=cdd6f4ff --date-font="$font")
lockargs+=(--ind-pos="x+w/2:y+h*0.79" --radius=27 --ring-width=4)
lockargs+=(--layout-pos="ix:iy+56" --layout-align=0)
lockargs+=(--verif-pos="ix:iy+49" --verif-align=0 --wrong-pos="ix:iy+49" --wrong-align=0)
