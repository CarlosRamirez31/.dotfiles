# Display managers source this for X11 sessions. Limit the overrides to
# Awesome so the session environment remains predictable.
case ${DESKTOP_SESSION:-${XDG_SESSION_DESKTOP:-}} in
    *awesome*)
        export XDG_CURRENT_DESKTOP=awesome
        export XDG_SESSION_DESKTOP=awesome
        export XDG_SESSION_TYPE=x11
        export XCURSOR_THEME=Bibata-Modern-Classic
        export XCURSOR_SIZE=24
        # Applications should use Awesome's borderless window management
        # instead of painting their own titlebar controls.
        export GTK_CSD=0
        ;;
esac
