#!/usr/bin/env bash
set -euo pipefail

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
pid_file="$runtime_dir/dotfiles-wf-recorder.pid"

if [[ -s $pid_file ]]; then
    recorder_pid=$(<"$pid_file")
    if [[ $recorder_pid =~ ^[0-9]+$ ]] && kill -0 "$recorder_pid" 2>/dev/null; then
        kill -INT "$recorder_pid"
        rm -f -- "$pid_file"
        notify-send -a Recorder 'Grabación finalizada'
        exit 0
    fi
    rm -f -- "$pid_file"
fi

videos_dir=$(xdg-user-dir VIDEOS 2>/dev/null || true)
[[ -n $videos_dir ]] || videos_dir="$HOME/Videos"
output_dir="$videos_dir/Recordings"
output="$output_dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
mkdir -p -- "$output_dir"

recorder_args=(-f "$output")
if [[ ${1:-area} == area ]]; then
    geometry=$(slurp) || exit 0
    [[ -n $geometry ]] || exit 0
    recorder_args=(-g "$geometry" "${recorder_args[@]}")
fi

nohup wf-recorder "${recorder_args[@]}" >"$runtime_dir/dotfiles-wf-recorder.log" 2>&1 &
printf '%s\n' "$!" >"$pid_file"
notify-send -a Recorder 'Grabación iniciada' 'Usa Alt+Shift+R para detenerla.'
