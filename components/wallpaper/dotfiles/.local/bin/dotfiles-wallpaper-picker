#!/usr/bin/env bash
set -euo pipefail

wallpaper_dir=${1:-"$HOME/Pictures/Wallpapers"}
state_dir=${XDG_STATE_HOME:-"$HOME/.local/state"}/dotfiles
state_file="$state_dir/wallpaper"
cache_dir=${XDG_CACHE_HOME:-"$HOME/.cache"}/dotfiles-wallpaper/thumbnails

[[ -d $wallpaper_dir ]] || exit 0
mapfile -d '' -t wallpapers < <(
    find "$wallpaper_dir" -maxdepth 1 -type f \
        \( -iname '*.jpg' -o -iname '*.jpeg' -o -iname '*.png' \
        -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.bmp' \
        -o -iname '*.avif' \) -print0 | sort -z
)
((${#wallpapers[@]} > 0)) || exit 0
install -d -m 0700 -- "$cache_dir"

thumbnail_for() {
    local wallpaper=$1 metadata digest thumbnail temporary
    metadata=$(stat -Lc '%n:%Y:%s' -- "$wallpaper")
    digest=$(printf '%s' "$metadata" | sha256sum | awk '{print $1}')
    thumbnail="$cache_dir/$digest.png"
    if [[ ! -s $thumbnail ]]; then
        temporary=$(mktemp "$cache_dir/$digest.XXXXXX.png")
        rm -f -- "$temporary"
        if ! magick "${wallpaper}[0]" -auto-orient -thumbnail '480x270^' \
            -gravity center -extent 480x270 "$temporary"; then
            rm -f -- "$temporary"
            printf '%s' "$wallpaper"
            return
        fi
        mv -- "$temporary" "$thumbnail"
    fi
    printf '%s' "$thumbnail"
}

thumbnail_size() {
    local geometry width height window_width window_height cell_width cell_height size

    geometry=$(xrandr --current 2>/dev/null | awk '/\*/ { print $1; exit }') || true
    [[ $geometry =~ ^([0-9]+)x([0-9]+) ]] || {
        printf '%s' 180
        return
    }
    width=${BASH_REMATCH[1]}
    height=${BASH_REMATCH[2]}
    window_width=$((width * 84 / 100))
    window_height=$((height * 84 / 100))
    cell_width=$(((window_width - 96) / 4))
    cell_height=$(((window_height - 150) / 2))
    size=$((cell_width - 20))
    ((cell_height - 54 < size)) && size=$((cell_height - 54))
    ((size < 96)) && size=96
    printf '%s' "$size"
}

icon_size=$(thumbnail_size)
selected=$(
    for wallpaper in "${wallpapers[@]}"; do
        printf '%s\0display\x1f%s\x1ficon\x1f%s\n' \
            "$wallpaper" "$(basename -- "$wallpaper")" "$(thumbnail_for "$wallpaper")"
    done | rofi -dmenu -i -show-icons \
        -theme "$HOME/.config/rofi/wallpaper.rasi" \
        -theme-str "element-icon { size: ${icon_size}px; }" \
        -p '󰸉  Elegir wallpaper'
) || exit 0

[[ -f $selected ]] || exit 0
feh --bg-fill -- "$selected"
install -d -m 0700 -- "$state_dir"
temporary=$(mktemp "$state_file.XXXXXX")
printf '%s\n' "$selected" >"$temporary"
chmod 0600 -- "$temporary"
mv -- "$temporary" "$state_file"
notify-send -a Wallpaper -i "$selected" 'Wallpaper aplicado' "$(basename -- "$selected")"
