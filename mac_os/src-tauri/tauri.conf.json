{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mac_os",
  "version": "0.1.0",
  "identifier": "com.dotfiles.microphone",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "mac_os",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../runtime/personal-voice/worker.py": "personal-voice/worker.py",
      "../runtime/personal-voice/artifacts.json": "personal-voice/artifacts.json",
      "../runtime/adapters/personal_voice/nomo_adapter.py": "adapters/personal_voice/nomo_adapter.py",
      "../runtime/ports/personal_voice.py": "ports/personal_voice.py",
      "../runtime/ports/result.py": "ports/result.py"
    }
  }
}
