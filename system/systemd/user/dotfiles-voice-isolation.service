[Unit]
Description=RNNoise microphone voice isolation
After=pipewire.service pipewire-pulse.service wireplumber.service
Wants=pipewire.service pipewire-pulse.service wireplumber.service
PartOf=pipewire.service

[Service]
Environment=LADSPA_PATH=/usr/lib/ladspa:%h/.local/lib/ladspa
EnvironmentFile=-%h/.config/voice-isolation/environment
RuntimeDirectory=dotfiles-voice-isolation
ExecStartPre=%h/.local/libexec/dotfiles-voice-isolation prepare
ExecStart=/usr/bin/pipewire -c %t/dotfiles-voice-isolation/filter-chain.conf
ExecStartPost=%h/.local/libexec/dotfiles-voice-isolation activate
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
