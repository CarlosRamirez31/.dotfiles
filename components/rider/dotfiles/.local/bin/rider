#!/usr/bin/env bash
set -euo pipefail
if [[ ${CONTAINER_ID:-} != dev ]]; then
    exec dotfiles-dev-exec rider "$@"
fi

if [[ ! -x /opt/rider/current/bin/rider ]]; then
    printf 'Rider no está instalado en dev. Ejecuta ./install.sh rider.\n' >&2
    exit 1
fi
case ${1:-} in
    --version | --help) exec /opt/rider/current/bin/rider "$@" ;;
esac

rider_log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/rider-dev"
mkdir -p -- "$rider_log_dir"
# setsid forks once and exits; PID 1 adopts/reaps the GUI process. No waiting
# shell, background supervisor, terminal streams or persistent PID files.
nohup setsid --fork -- /opt/rider/current/bin/rider "$@" \
    </dev/null >>"$rider_log_dir/launcher.log" 2>&1
