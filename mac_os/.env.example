# Explicit opt-in: MIC_ENV_FILE=/absolute/path/to/.env pnpm tauri dev
# Process variables override this file. No secrets; no interpolation or inline comments.
MIC_LOG_RETENTION_DAYS=30
MIC_LOG_CLEANUP_SECONDS=3600
MIC_MAX_PENDING=16
MIC_MAX_OPERATIONS=10000
MIC_EVENT_BATCH=64
MIC_MODEL_LOAD_SECONDS=120
MIC_INFERENCE_SECONDS=2
MIC_ENROLL_SECONDS=60
MIC_MAX_VOICE_PROFILES=32
MIC_VOICE_THRESHOLD=0.7
MIC_STARTUP_SECONDS=30
MIC_SHUTDOWN_SECONDS=5
MIC_SSE_RECONNECT_MS=1500
# MIC_VOICE_RUNTIME=/absolute/path/to/private/runtime

# Local HTTP route prefix; shared with React through the service handshake.
MIC_API_VERSION=v1
