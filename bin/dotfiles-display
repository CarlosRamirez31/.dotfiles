#!/usr/bin/env python3
"""Configure any number of RandR outputs; restore layouts on hotplug."""
import copy
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import threading

CONFIG = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'dotfiles/displays.json'
OPTIONS = CONFIG.with_name('display-options.json')


def read_json(path):
    try:
        value = json.loads(path.read_text())
        return value if isinstance(value, dict) else {}
    except (OSError, ValueError):
        return {}


def appearance_key(output):
    return output.get('identity') or output['name']


def bar_state_path():
    return Path(os.environ.get('XDG_RUNTIME_DIR', f'/tmp/dotfiles-display-{os.getuid()}')) / 'dotfiles-display-appearance.json'


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value, indent=2) + '\n')
    temporary.replace(path)


def lid_closed():
    for state in Path('/proc/acpi/button/lid').glob('*/state'):
        try:
            if re.search(r'\bclosed\b', state.read_text()):
                return True
        except OSError:
            pass
    return False


def docked(outputs):
    try:
        enabled = json.loads(OPTIONS.read_text()).get('external_only_when_closed', True)
    except (OSError, ValueError, AttributeError):
        enabled = True
    return bool(enabled and lid_closed() and any(
        not internal(o) and o['modes'] for o in outputs))


def internal(output):
    return output['name'].startswith(('eDP', 'LVDS', 'DSI'))


def lid_policy():
    result = subprocess.run(['systemd-analyze', 'cat-config', 'systemd/logind.conf'],
                            capture_output=True, text=True, check=True, timeout=10)
    values = {'HandleLidSwitch': 'suspend', 'HandleLidSwitchDocked': 'ignore'}
    section = ''
    for line in result.stdout.splitlines():
        line = line.strip()
        if line.startswith('['):
            section = line
        elif section == '[Login]' and '=' in line and not line.startswith(('#', ';')):
            key, value = line.split('=', 1)
            values[key.strip()] = value.strip()
    battery = values['HandleLidSwitch']
    return [battery, values.get('HandleLidSwitchExternalPower') or battery,
            values['HandleLidSwitchDocked']]


def configure_lid(actions, password=None):
    """Set logind policy independently of the X11 session, using sudo."""
    allowed = {'ignore', 'suspend', 'hibernate', 'lock', 'poweroff'}
    if len(actions) != 3 or any(action not in allowed for action in actions):
        raise ValueError('--lid-policy requiere tres acciones: batería, corriente y monitores externos. '
                         'Opciones: ignore, suspend, hibernate, lock, poweroff.')
    settings = ('HandleLidSwitch', 'HandleLidSwitchExternalPower', 'HandleLidSwitchDocked')
    def privileged(args):
        if password is None:
            subprocess.run(['sudo'] + args, check=True)
        else:
            subprocess.run(['sudo', '-S', '-p', ''] + args, input=password + '\n',
                           capture_output=True, text=True, check=True, timeout=45)
    with tempfile.TemporaryDirectory(prefix='dotfiles-lid-') as directory:
        policy = Path(directory) / '90-dotfiles-lid.conf'
        policy.write_text('[Login]\n' + ''.join(f'{key}={value}\n' for key, value in zip(settings, actions)))
        privileged(['install', '-D', '-m', '644', str(policy),
                    '/etc/systemd/logind.conf.d/90-dotfiles-lid.conf'])
    privileged(['systemctl', 'kill', '--kill-whom=main', '--signal=HUP',
                'systemd-logind.service'])
    if lid_policy() != actions:
        raise ValueError('Otra configuración del sistema tiene prioridad. No se pudieron activar estas opciones.')
    print('Política de tapa aplicada: batería={}, corriente={}, monitores externos={}.'.format(*actions))


def query(current=False):
    # Periodic checks must not probe connectors: probing can resume a sleeping
    # discrete GPU. Explicit panel/recovery requests still refresh the hardware.
    result = subprocess.run(['xrandr', '--current' if current else '--query', '--verbose'],
                            capture_output=True, text=True, check=True, timeout=10)
    outputs = []
    current = None
    edid = False
    transform_rows = 0
    verbose_mode = None
    for line in result.stdout.splitlines():
        match = re.match(r'^(\S+) connected\b(.*)', line)
        if match:
            edid = False
            transform_rows = 0
            verbose_mode = None
            name, details = match.groups()
            geometry = re.search(r'(\d+)x(\d+)\+(-?\d+)\+(-?\d+)', details)
            current = dict(name=name, primary=' primary ' in ' ' + details + ' ', enabled=bool(geometry),
                           x=int(geometry[3]) if geometry else 0, y=int(geometry[4]) if geometry else 0,
                           mode=f'{geometry[1]}x{geometry[2]}' if geometry else '', modes=[],
                           rates={}, edid='', preferred=None, scale=100)
            outputs.append(current)
        elif line and not line[0].isspace():
            current = None
        elif current is not None:
            if line.strip().startswith('Transform:'):
                current['transform'] = [float(v) for v in line.split(':', 1)[1].split()]
                transform_rows = 2
                continue
            if transform_rows:
                current['transform'].extend(float(v) for v in line.split())
                transform_rows -= 1
                continue
            verbose = re.match(r'^\s+(\d+x\d+)\s+\(0x[0-9a-f]+\)\s+.*MHz(.*)', line)
            if verbose:
                verbose_mode = (verbose[1], verbose[2])
                if verbose[1] not in current['modes']:
                    current['modes'].append(verbose[1])
                if '+preferred' in verbose[2] and current['preferred'] is None:
                    current['preferred'] = verbose[1]
                if '*current' in verbose[2]:
                    current['mode'] = verbose[1]
                continue
            vertical = re.search(r'^\s+v:.*clock\s+([0-9.]+)Hz', line)
            if vertical and verbose_mode:
                mode_name, flags = verbose_mode
                rate = vertical[1]
                rates = current['rates'].setdefault(mode_name, [])
                if rate not in rates:
                    rates.append(rate)
                if '*current' in flags:
                    current['rate'] = rate
                verbose_mode = None
                continue
            if line.strip() == 'EDID:':
                edid = True
                continue
            if edid and re.fullmatch(r'\s+[0-9a-fA-F]{32}\s*', line):
                current['edid'] += line.strip().lower()
                continue
            edid = False
            mode = re.match(r'^\s+(\d+x\d+)\s+(.+)', line)
            if mode:
                if mode[1] not in current['modes']:
                    current['modes'].append(mode[1])
                rates = current['rates'].setdefault(mode[1], [])
                # RandR can separate a preferred marker from its rate by spaces.
                tokens = re.findall(r'(\d+(?:\.\d+)?)([*+]*(?:\s+\+)?)', mode[2])
                for rate, flags in tokens:
                    if rate not in rates:
                        rates.append(rate)
                    if '*' in flags:
                        current.update(mode=mode[1], rate=rate)
                    if '+' in flags and current['preferred'] is None:
                        current['preferred'] = mode[1]
    preferences = read_json(CONFIG.with_name('display-appearance.json'))
    bar_state = read_json(bar_state_path())
    for output in outputs:
        output['modes'].sort(key=mode_size, reverse=True)
        for rates in output['rates'].values():
            rates.sort(key=float, reverse=True)
        transform = output.pop('transform', [1, 0, 0, 0, 1, 0, 0, 0, 1])
        if len(transform) == 9 and transform[0] > 0 and transform[4] > 0:
            output['transform_scale'] = round(100 / transform[0], 2)
        if output['edid']:
            raw = bytes.fromhex(output.pop('edid'))
            output['identity'] = hashlib.sha256(raw).hexdigest()
            for offset in (54, 72, 90, 108):
                block = raw[offset:offset+18]
                if block.startswith(b'\x00\x00\x00\xfc\x00'):
                    output['model'] = block[5:].decode('ascii', errors='replace').strip()
                    break
        else:
            output.pop('edid')
        saved = preferences.get(appearance_key(output), {})
        active = bar_state.get(output['name'], {})
        if active.get('identity') != output.get('identity'):
            active = {}
        output['scale'] = active.get('scale', saved.get('scale', 100))
        old_font_scale = active.get('font_scale', saved.get('font_scale', 100))
        output['font_size'] = active.get('font_size', saved.get('font_size', old_font_scale / 10))
        output['polybar_scale'] = active.get('polybar_scale', saved.get('polybar_scale', 100))
    return outputs


def hardware_topology():
    """Read cached kernel connector state without asking Xorg to probe GPUs."""
    try:
        states = [(str(path), path.read_text().strip(),
                   hashlib.sha256(path.with_name('edid').read_bytes()).hexdigest()
                   if path.with_name('edid').exists() else '')
                  for path in sorted(Path('/sys/class/drm').glob('card*-*/status'))]
        if states:
            return json.dumps([states, lid_closed()])
    except OSError:
        pass
    return None


def disable_disconnected_outputs():
    """Release CRTCs left active after unplugging a Reverse PRIME monitor."""
    result = subprocess.run(['xrandr', '--current'], capture_output=True,
                            text=True, check=True, timeout=10)
    lines = result.stdout.splitlines()
    # Keep a visible connected output as an anchor during automatic cleanup.
    if not any(re.match(r'^\S+ connected\b.*\d+x\d+\+-?\d+\+-?\d+', line)
               for line in lines):
        return False
    stale = [match[1] for line in lines
             if (match := re.match(r'^(\S+) disconnected\s+\d+x\d+\+-?\d+\+-?\d+', line))]
    if not stale:
        return False
    args = ['xrandr', '--current']
    for name in stale:
        args.extend(['--output', name, '--off'])
    subprocess.run(args, capture_output=True, text=True, check=True, timeout=15)
    return True


def mode_size(mode):
    width, height = map(int, mode.split('x'))
    return width * height, width, height


def size(output):
    mode = output['mode'] or output['modes'][0]
    return tuple(map(int, mode.split('x')))


def reflow(outputs, output, old_size):
    """Keep neighboring screens attached when logical dimensions change."""
    if not output['enabled']:
        return
    width, height = size(output)
    for other in outputs:
        if other is output or not other['enabled']:
            continue
        if other['x'] >= output['x'] + old_size[0]:
            other['x'] += width - old_size[0]
        if other['y'] >= output['y'] + old_size[1]:
            other['y'] += height - old_size[1]


def display_name(output):
    return output.get('model') or ('Pantalla de la laptop' if internal(output) else output['name'])


def normalize(outputs):
    enabled = [o for o in outputs if o['enabled']]
    if not enabled:
        raise ValueError('Activa al menos una pantalla.')
    left, top = min(o['x'] for o in enabled), min(o['y'] for o in enabled)
    primary = next((o for o in enabled if o['primary']), enabled[0])
    for output in outputs:
        output['primary'] = output is primary
        if output['enabled']:
            output['x'] -= left
            output['y'] -= top
    return outputs


def validate_layout(outputs):
    enabled = [o for o in outputs if o['enabled']]
    if not enabled:
        raise ValueError('Activa al menos una pantalla.')
    for o in enabled:
        if not 75 <= o.get('polybar_scale', 100) <= 200:
            raise ValueError('Selecciona un tamaño de Polybar entre 75 % y 200 %.')
        if not 100 <= o.get('scale', 100) <= 200:
            raise ValueError('Selecciona una escala entre 100 % y 200 %.')
        if not 8 <= o.get('font_size', 10) <= 32:
            raise ValueError('Selecciona un tamaño de fuente entre 8 y 32 puntos.')
        if o['mode'] not in o['modes']:
            raise ValueError('Selecciona una resolución disponible para ' + o['name'])
        if o.get('rate') and o.get('rates') and o['rate'] not in o['rates'].get(o['mode'], []):
            raise ValueError('Selecciona una frecuencia disponible para ' + o['name'])
    neighbors = {o['name']: set() for o in enabled}
    for i, a in enumerate(enabled):
        aw, ah = size(a)
        for b in enabled[i+1:]:
            bw, bh = size(b)
            dx = min(a['x']+aw, b['x']+bw) - max(a['x'], b['x'])
            dy = min(a['y']+ah, b['y']+bh) - max(a['y'], b['y'])
            mirrored = (a['x'], a['y'], aw, ah) == (b['x'], b['y'], bw, bh)
            if dx > 0 and dy > 0 and not mirrored:
                raise ValueError('Hay pantallas superpuestas. Sepáralas o usa Duplicar.')
            if mirrored or (dx == 0 and dy > 0) or (dy == 0 and dx > 0):
                neighbors[a['name']].add(b['name'])
                neighbors[b['name']].add(a['name'])
    seen, pending = set(), [enabled[0]['name']]
    while pending:
        name = pending.pop()
        if name not in seen:
            seen.add(name)
            pending.extend(neighbors[name] - seen)
    if len(seen) != len(enabled):
        raise ValueError('Hay pantallas separadas por un hueco. Junta sus bordes para poder pasar el mouse.')


def snap_output(outputs, output, original_y):
    enabled = [o for o in outputs if o['enabled']]
    others = [o for o in enabled if o is not output]
    if not others:
        return
    # Reordering a horizontal row moves its neighbors too, instead of leaving
    # the old slot empty or stacking one output over another.
    if (all(o['y'] == original_y for o in others)
            and abs(output['y']-original_y) < min(size(o)[1] for o in enabled)):
        ordered = sorted(enabled, key=lambda o: o['x'] + size(o)[0]/2)
        right = min(o['x'] for o in enabled)
        for o in ordered:
            o['x'] = right
            right += size(o)[0]
        return
    w, h = size(output)
    candidates = []
    for other in others:
        ow, oh = size(other)
        y = min(max(output['y'], other['y']-h+1), other['y']+oh-1)
        x = min(max(output['x'], other['x']-w+1), other['x']+ow-1)
        candidates.extend([(other['x']-w, y), (other['x']+ow, y),
                           (x, other['y']-h), (x, other['y']+oh)])
    for x, y in sorted(candidates, key=lambda p: (p[0]-output['x'])**2+(p[1]-output['y'])**2):
        trial = copy.deepcopy(outputs)
        next(o for o in trial if o['name'] == output['name']).update(x=x, y=y)
        try:
            validate_layout(trial)
        except ValueError:
            continue
        output.update(x=x, y=y)
        return


def layout_args(outputs):
    args = ['xrandr']
    for output in normalize(copy.deepcopy(outputs)):
        args += ['--output', output['name']]
        if output['enabled']:
            args += ['--mode', output['mode'], '--pos', f"{output['x']}x{output['y']}"]
            # Keep the output mapped 1:1 to its native framebuffer rectangle.
            # Application UI scaling is passed to launched apps separately.
            args += ['--transform', 'none']
            if output.get('rate'):
                args += ['--rate', output['rate']]
            if output['primary']:
                args += ['--primary']
        else:
            args += ['--off']
    return args + ['--dpi', '96']


def active_description(output):
    if not output or not output['enabled']:
        return 'Activo ahora: pantalla apagada'
    rate = output.get('rate')
    return 'Activo ahora: ' + output['mode'] + (' · ' + rate + ' Hz' if rate else ' · Hz no disponibles') + f" · aplicaciones {output.get('scale', 100):g} %"


def output_at_pointer():
    outputs = query(current=True)
    result = subprocess.run(['xdotool', 'getmouselocation', '--shell'],
                            capture_output=True, text=True, check=True, timeout=3)
    position = dict(line.split('=', 1) for line in result.stdout.splitlines() if '=' in line)
    x, y = int(position['X']), int(position['Y'])
    for output in outputs:
        if not output['enabled']:
            continue
        width, height = size(output)
        if output['x'] <= x < output['x'] + width and output['y'] <= y < output['y'] + height:
            return output
    return None


def scale_at_pointer():
    """Return the application UI factor saved for the output under the pointer."""
    output = output_at_pointer()
    if output is None:
        return 1
    factor = output.get('scale', 100) / 100
    # A 10% increase is barely visible for small UI fonts. Give the first
    # step above 100% a perceptible 20% effective increase.
    return 1.2 if 1 < factor < 1.2 else factor


def font_size_at_pointer():
    """Return the independent font size in points for the output under pointer."""
    output = output_at_pointer()
    return output.get('font_size', 10) if output else 10


def verify_applied(requested, actual):
    """Check the running modes before offering to keep or save a layout."""
    live = {o['name']: o for o in actual}
    for output in requested:
        screen = live.get(output['name'])
        if screen is None or (output.get('identity') and output['identity'] != screen.get('identity')):
            raise ValueError('Las pantallas conectadas cambiaron durante la prueba.')
        if output['enabled'] != screen['enabled']:
            raise ValueError('No se confirmó el estado de ' + output['name'])
        if output['enabled']:
            if abs(screen.get('transform_scale', 100) - 100) > .2:
                raise ValueError('No se eliminó el zoom de imagen de ' + output['name'])
            if abs(output.get('scale', 100) - screen.get('scale', 100)) > .2:
                raise ValueError('No se confirmó la escala de aplicaciones de ' + output['name'])
            if output['mode'] != screen['mode']:
                raise ValueError('No se confirmó la resolución de ' + output['name'])
            if output.get('rate') and (not screen.get('rate') or
                    abs(float(output['rate']) - float(screen['rate'])) > .05):
                raise ValueError('No se confirmó la frecuencia de ' + output['name'])


def desktop_state(restore=False):
    """Keep Awesome clients on their outputs/tags across the brief reset."""
    if not shutil.which('awesome-client'):
        return
    if restore:
        code = '''if awesome._dotfiles_restore_displays then
            require('gears').timer.start_new(0.3, function()
                if awesome._dotfiles_restore_displays then
                    awesome._dotfiles_restore_displays()
                    awesome._dotfiles_restore_displays = nil
                end
                return false
            end)
        end'''
    else:
        code = '''local screens, clients = {}, {}
        for s in screen do
            local output = next(s.outputs)
            if output then
                local selected = {}
                for i,t in ipairs(s.tags) do if t.selected then table.insert(selected,i) end end
                screens[output] = selected
            end
        end
        for _,c in ipairs(client.get()) do
            local tags = {}
            for _,t in ipairs(c:tags()) do table.insert(tags,t.index) end
            local geometry=c:geometry()
            geometry.x=geometry.x-c.screen.geometry.x
            geometry.y=geometry.y-c.screen.geometry.y
            table.insert(clients,{c=c,output=next(c.screen.outputs),tags=tags,
                floating=c.floating,geometry=geometry})
        end
        awesome._dotfiles_restore_displays = function()
            local outputs = {}
            for s in screen do for name in pairs(s.outputs) do outputs[name]=s end end
            for _,v in ipairs(clients) do
                local s=outputs[v.output]
                if v.c.valid and s then
                    v.c:move_to_screen(s)
                    local tags={}
                    for _,i in ipairs(v.tags) do if s.tags[i] then table.insert(tags,s.tags[i]) end end
                    if #tags>0 then v.c:tags(tags) end
                    if v.floating then
                        v.geometry.x=v.geometry.x+s.geometry.x
                        v.geometry.y=v.geometry.y+s.geometry.y
                        v.c:geometry(v.geometry)
                    end
                end
            end
            for name,selected in pairs(screens) do
                local s=outputs[name]
                if s and #selected>0 and s.tags[selected[1]] then
                    s.tags[selected[1]]:view_only()
                    for i=2,#selected do if s.tags[selected[i]] then s.tags[selected[i]].selected=true end end
                end
            end
        end'''
    try:
        subprocess.run(['awesome-client', code], capture_output=True, text=True, timeout=5, check=False)
    except (OSError, subprocess.SubprocessError):
        pass


def run_layout(outputs, rebuild=False):
    if rebuild:
        # Keep one target output as an anchor while the others are off.
        # Shrinking the framebuffer releases stale images before scaling the
        # combined layout, including systems with external screens only.
        anchor = next(o for o in outputs if o['enabled'] and o['modes'])
        interim = copy.deepcopy(outputs)
        for output in interim:
            output.update(enabled=output['name'] == anchor['name'], primary=output['name'] == anchor['name'])
            if output['enabled']:
                output.update(x=0, y=0, mode=output['mode'] or output['modes'][0])
        args = layout_args(interim)
        width, height = size(next(o for o in interim if o['enabled']))
        subprocess.run(args, check=True, capture_output=True, text=True, timeout=15)
        subprocess.run(['xrandr', '--fb', f'{width}x{height}'], check=True,
                       capture_output=True, text=True, timeout=15)
    # One invocation enables all external outputs together, including rollback.
    subprocess.run(layout_args(outputs), check=True, capture_output=True, text=True, timeout=15)


def apply(outputs, force_reset=False):
    validate_layout(outputs)
    target = normalize(copy.deepcopy(outputs))
    before = query()
    previous = {o['name']: o for o in before}
    for output in target:
        live = previous.get(output['name'])
        if live is None or (output.get('identity') and output.get('identity') != live.get('identity')):
            raise ValueError('Las pantallas conectadas cambiaron. Vuelve a abrir el panel.')
        if output['enabled']:
            if output['mode'] not in live['modes']:
                raise ValueError('La resolución ya no está disponible para ' + output['name'])
            rates = live.get('rates', {}).get(output['mode'], [])
            requested = output.get('rate')
            if rates and requested and requested not in rates:
                raise ValueError('La frecuencia ya no está disponible para ' + output['name'])
            if not requested and output['mode'] == live.get('mode') and live.get('rate'):
                output['rate'] = live['rate']
    subprocess.run(layout_args(target) + ['--dryrun'], check=True,
                   capture_output=True, text=True, timeout=15)
    multiple_external_outputs = max(sum(not internal(o) and o['enabled'] for o in items)
                                    for items in (before, target)) >= 2
    rebuild = (force_reset or
               (multiple_external_outputs and any(internal(o) and o['modes'] for o in target)))
    if rebuild:
        desktop_state()
    applied = target
    try:
        run_layout(target, rebuild=rebuild)
    except (OSError, subprocess.SubprocessError) as error:
        applied = before
        try:
            run_layout(before, rebuild=rebuild and any(internal(o) and o['modes'] for o in before))
        except (OSError, ValueError, StopIteration, subprocess.SubprocessError) as rollback:
            raise ValueError('Falló el cambio y no se pudo restaurar la imagen: ' + str(rollback)) from error
        raise ValueError('No se pudo aplicar el cambio; se restauró la configuración anterior.') from error
    finally:
        if rebuild:
            desktop_state(restore=True)
        refresh_bar(applied)


def refresh_bar(outputs=None):
    if outputs is not None:
        write_json(bar_state_path(), {o['name']: {
            'identity': o.get('identity'), 'scale': o.get('scale', 100),
            'font_size': o.get('font_size', 10),
            'polybar_scale': o.get('polybar_scale', 100)} for o in outputs})
    wallpaper = Path.home() / '.local/bin/dotfiles-wallpaper'
    if wallpaper.is_file():
        subprocess.Popen([str(wallpaper), 'restore'], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
    launcher = Path.home() / '.local/bin/dotfiles-polybar'
    if launcher.is_file():
        subprocess.Popen([str(launcher)], stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)


def key(outputs):
    return '|'.join(sorted(o['name'] + (':' + o['identity'] if o.get('identity') else '') for o in outputs)) + ('|lid-closed' if docked(outputs) else '')


def load():
    try:
        return json.loads(CONFIG.read_text())
    except (OSError, ValueError):
        return {}


def save(outputs):
    path = CONFIG.with_name('display-appearance.json')
    appearance = read_json(path)
    for output in outputs:
        appearance[appearance_key(output)] = {'scale': output.get('scale', 100),
                                              'font_size': output.get('font_size', 10),
                                              'polybar_scale': output.get('polybar_scale', 100)}
    write_json(path, appearance)
    profiles = load()
    profiles[key(outputs)] = normalize(copy.deepcopy(outputs))
    CONFIG.parent.mkdir(parents=True, exist_ok=True)
    temporary = CONFIG.with_suffix('.tmp')
    temporary.write_text(json.dumps(profiles, indent=2) + '\n')
    temporary.replace(CONFIG)


def automatic(outputs):
    if not outputs:
        return
    external_only = docked(outputs)
    stored = load().get(key(outputs))
    if stored:
        by_name = {o['name']: o for o in stored}
        for output in outputs:
            previous = by_name.get(output['name'], {})
            if previous.get('mode') in output['modes']:
                output.update({k: previous[k] for k in ('enabled', 'primary', 'mode', 'x', 'y')})
                rate = previous.get('rate')
                if rate in output.get('rates', {}).get(output['mode'], []):
                    output['rate'] = rate
                else:
                    output.pop('rate', None)
    else:
        right = max((o['x'] + size(o)[0] for o in outputs if o['enabled']), default=0)
        for output in outputs:
            if external_only and internal(output):
                continue
            if not output['enabled'] and output['modes']:
                output.update(enabled=True, mode=output['modes'][0], x=right, y=0)
                right += size(output)[0]
            # A newly seen external monitor may already be running at the
            # EDID preferred 60 Hz even though it also offers 144 Hz.
            if not internal(output) and output['enabled']:
                rates = output.get('rates', {}).get(output['mode'], [])
                if rates:
                    output['rate'] = max(rates, key=float)
    if external_only:
        for output in outputs:
            if internal(output):
                output.update(enabled=False, primary=False)
        # A saved profile may have disabled every external screen. Never
        # leave the session without a usable output when closing the lid.
        if not any(o['enabled'] for o in outputs):
            external = next(o for o in outputs if not internal(o) and o['modes'])
            external.update(enabled=True, mode=external['mode'] or external['modes'][0], x=0, y=0)
    normalize(outputs)
    try:
        validate_layout(outputs)
    except ValueError:
        # Removing the internal panel can leave a hole in a saved arrangement.
        right = 0
        for output in sorted((o for o in outputs if o['enabled']), key=lambda o: (o['x'], o['y'])):
            output.update(x=right, y=0)
            right += size(output)[0]
    if outputs != query():
        apply(outputs)


def gui(outputs):
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib

    class Panel(Gtk.Window):
        def __init__(self):
            super().__init__(title='Pantallas')
            self.set_wmclass('dotfiles-displays', 'DotfilesDisplays')
            self.set_role('dotfiles-displays')
            self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
            self.set_position(Gtk.WindowPosition.CENTER)
            pointer = Gdk.Display.get_default().get_default_seat().get_pointer()
            _, px, py = pointer.get_position()
            area = Gdk.Display.get_default().get_monitor_at_point(px, py).get_workarea()
            self.set_default_size(min(900, area.width - 24), min(820, max(380, area.height - 90)))
            self.set_name('display-panel')
            self.css = Gtk.CssProvider()
            self.css.load_from_data(b'''
                decoration { border: 0; box-shadow: none; margin: 0; border-radius: 0; background: transparent; }
                menu, menuitem, popover, popover contents { background-color: #20202e; color: #cdd6f4; }
                menuitem label { color: #cdd6f4; font-family: JetBrainsMono Nerd Font, monospace; font-weight: 500; }
                menuitem:hover { background-color: #39394f; }
                #lid-settings, #lid-auth { background: #171722; color: #cdd6f4;
                    font-family: JetBrainsMono Nerd Font, monospace; font-size: 14px; font-weight: 500; }
                #lid-settings label, #lid-auth label { color: #cdd6f4; }
                #lid-settings button, #lid-auth button { background: #303040; color: #cdd6f4;
                    border: 1px solid #39394f; border-radius: 8px; box-shadow: none;
                    text-shadow: none; padding: 6px 12px; font-weight: 600; }
                #lid-settings button:hover, #lid-auth button:hover { background: #39394f; border-color: #cba6f7; }
                #lid-settings button.suggested-action, #lid-auth button.suggested-action { background: #cba6f7; color: #171722; }
                #lid-settings button.suggested-action label, #lid-auth button.suggested-action label { color: #171722; }
