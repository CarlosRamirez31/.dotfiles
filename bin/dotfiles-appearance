#!/usr/bin/env python3
"""Appearance preferences, reversible previews and the Awesome desktop editor."""
import argparse
import contextlib
import fcntl
import json
import math
import os
from pathlib import Path
import re
import subprocess
import sys
import time
import uuid

CONFIG_HOME = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
RUNTIME = Path(os.environ.get("XDG_RUNTIME_DIR", f"/tmp/dotfiles-{os.getuid()}")) / "dotfiles-appearance"
SAVED = CONFIG_HOME / "dotfiles/appearance.json"
BASE = CONFIG_HOME / "picom/picom.conf"
DEFAULTS = dict(gap=5, border=0, accent="#cba6f7", corners=10, shadows=True,
                shadow_radius=18, shadow_opacity=22, fading=True, inactive_opacity=100)
RANGES = dict(gap=(0, 100), border=(0, 20), corners=(0, 99), shadow_radius=(0, 100),
              shadow_opacity=(0, 100), inactive_opacity=(0, 100))
PICOM = dict(corners="corner-radius", shadows="shadow", shadow_radius="shadow-radius",
             shadow_opacity="shadow-opacity", fading="fading", inactive_opacity="inactive-opacity")
PRESETS = {
    "Equilibrado": DEFAULTS,
    "Suave": dict(DEFAULTS, gap=8, border=1, corners=14, inactive_opacity=96),
    "Sin efectos": dict(DEFAULTS, corners=0, shadows=False, fading=False),
}


def validate(value):
    if not isinstance(value, dict) or set(value) - set(DEFAULTS):
        raise ValueError("Configuración de apariencia no válida")
    result = dict(DEFAULTS, **value)
    for key, (low, high) in RANGES.items():
        if type(result[key]) is not int or not low <= result[key] <= high:
            raise ValueError(f"Valor fuera de rango: {key}")
    for key in ("shadows", "fading"):
        if type(result[key]) is not bool:
            raise ValueError(f"Valor no válido: {key}")
    if not isinstance(result["accent"], str) or not re.fullmatch(r"#[0-9a-fA-F]{6}", result["accent"]):
        raise ValueError("El color debe usar el formato #RRGGBB")
    return result


def read(path, fallback=None):
    try:
        return json.loads(path.read_text())
    except FileNotFoundError:
        return fallback


def write(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_name(path.name + ".tmp")
    temp.write_text(json.dumps(value, indent=2) + "\n")
    temp.replace(path)


@contextlib.contextmanager
def locked():
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    with (RUNTIME / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def saved():
    return validate(read(SAVED, DEFAULTS))


def current():
    return validate(read(RUNTIME / "live.json", saved()))


def picom_config(base, settings):
    settings = validate(settings)
    result = base
    for key, option in PICOM.items():
        value = settings[key]
        if key in ("shadow_opacity", "inactive_opacity"):
            value = value / 100
        literal = str(value).lower()
        line = f"{option} = {literal};"
        pattern = rf"(?m)^\s*{re.escape(option)}\s*=\s*[^;]+;"
        result = re.sub(pattern, lambda _: line, result) if re.search(pattern, result) else result + "\n" + line
    return result + "\n"


def command(args, timeout=12):
    result = subprocess.run(args, capture_output=True, text=True, timeout=timeout)
    if result.returncode or "Error during execution:" in result.stdout:
        raise RuntimeError((result.stderr or result.stdout).strip() or "No se pudo aplicar el cambio")
    return result.stdout


def wm(settings):
    settings = validate(settings)
    command(["awesome-client", 'require("appearance").apply(%d, %d, "%s")' %
             (settings["gap"], settings["border"], settings["accent"])])


def compositor(settings):
    RUNTIME.mkdir(mode=0o700, parents=True, exist_ok=True)
    candidate = RUNTIME / "candidate.conf"
    candidate.write_text(picom_config(BASE.read_text(), settings))
    command(["picom", "--config", str(candidate), "--diagnostics"])
    target = RUNTIME / "picom.conf"
    candidate.replace(target)
    subprocess.run(["pkill", "-u", str(os.getuid()), "-x", "picom"], check=False)
    # Wait for the previous compositor to release the X11 selection.
    for _ in range(40):
        result = subprocess.run(["pgrep", "-u", str(os.getuid()), "-x", "picom"], capture_output=True, text=True)
        running = []
        for pid in result.stdout.split():
            try:
                if Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[0] != "Z":
                    running.append(pid)
            except FileNotFoundError:
                pass
        if not running:
            break
        time.sleep(0.05)
    with (RUNTIME / "picom.log").open("a") as log:
        process = subprocess.Popen(["picom", "--config", str(target)], stdout=log, stderr=log, start_new_session=True)
    time.sleep(0.3)
    if process.poll() is not None:
        raise RuntimeError("Picom no pudo iniciar. Revisa " + str(RUNTIME / "picom.log"))


def apply_live(settings, force=False):
    previous = current()
    if force or any(previous[k] != settings[k] for k in PICOM):
        compositor(settings)
    wm(settings)
    write(RUNTIME / "live.json", settings)


def preview(settings):
    settings = validate(settings)
    with locked():
        if (RUNTIME / "preview.json").exists():
            raise ValueError("Cancela o guarda la prueba actual antes de iniciar otra")
        token = uuid.uuid4().hex
        previous = current()
        marker = dict(token=token, previous=previous, deadline=time.time() + 20, applied=False)
        write(RUNTIME / "preview.json", marker)
        subprocess.Popen([sys.executable, str(Path(__file__).resolve()), "--watch", token],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        try:
            apply_live(settings)
            marker["applied"] = True
            write(RUNTIME / "preview.json", marker)
        except Exception:
            apply_live(previous, force=True)
            (RUNTIME / "preview.json").unlink(missing_ok=True)
            raise
        return token


def revert(token=None):
    with locked():
        marker = read(RUNTIME / "preview.json")
        if not marker or (token and marker["token"] != token):
            return False
        apply_live(validate(marker["previous"]), force=not marker.get("applied", False))
        (RUNTIME / "preview.json").unlink(missing_ok=True)
        return True


def commit(settings):
    settings = validate(settings)
    with locked():
        before = current()
        try:
            apply_live(settings)
            write(SAVED, settings)
        except Exception:
            apply_live(before, force=True)
            raise
        (RUNTIME / "preview.json").unlink(missing_ok=True)


def watch(token):
    while True:
        marker = read(RUNTIME / "preview.json")
        if not marker or marker["token"] != token:
            return
        remaining = marker["deadline"] - time.time()
        if remaining <= 0:
            revert(token)
            return
        time.sleep(min(1, remaining))


def gui(test_hook=None):
    import concurrent.futures
    import gi
    gi.require_version("Gtk", "3.0")
    from gi.repository import Gtk, Gdk, GLib

    class Panel(Gtk.ApplicationWindow):
        def __init__(self, app, visible=True):
            super().__init__(application=app, title="Apariencia")
            self.set_wmclass("dotfiles-appearance", "DotfilesAppearance")
            self.set_role("dotfiles-appearance")
            self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.set_default_size(750, 490)
            self.set_name("appearance")
            self.pool = concurrent.futures.ThreadPoolExecutor(max_workers=1)
            self.widgets, self.token, self.working, self.closing = {}, None, False, False
            self.original = current()
            self.values = dict(self.original)
            css = Gtk.CssProvider()
            css.load_from_data(b"""
                decoration { border: 0; box-shadow: none; margin: 0; background: transparent; border-radius: 0; }
                menu, menuitem, popover, popover contents { background-color: #11151a;
