ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG LAB_PROFILE
ENV DEBIAN_FRONTEND=noninteractive
ENV SHELL=/usr/bin/zsh
ENV EDITOR=nvim
ENV VISUAL=nvim

COPY components/workbench/container/install.sh /usr/local/libexec/dotfiles-lab-install
RUN /usr/local/libexec/dotfiles-lab-install "${LAB_PROFILE}" \
    && rm -f /usr/local/libexec/dotfiles-lab-install

COPY components/shell/dotfiles/.zshenv /root/.zshenv
COPY components/shell/dotfiles/.zshrc /root/.zshrc
COPY components/shell/dotfiles/.config/zsh /root/.config/zsh
COPY components/shell/dotfiles/.config/starship.toml /root/.config/starship.toml
COPY components/shell/dotfiles/.config/bat /root/.config/bat
COPY components/fastfetch/dotfiles/.config/fastfetch /root/.config/fastfetch
COPY components/nvim/dotfiles/.config/nvim /root/.config/nvim

# Keep the editor fully usable even when the lab starts without internet.
RUN nvim --headless "+Lazy! sync" +qa \
    && nvim --headless "+lua require('config.treesitter').install()" +qa

WORKDIR /root
CMD ["zsh", "-l"]
