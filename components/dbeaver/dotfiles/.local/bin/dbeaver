#!/usr/bin/env bash
set -euo pipefail
if [[ ${CONTAINER_ID:-} != dev ]]; then
    # shellcheck disable=SC2016 # Arguments expand inside dev.
    exec distrobox enter --name dev -- sh -c \
        'cd -- "$1" && shift && exec "$@"' dbeaver "$PWD" "${BASH_SOURCE[0]}" "$@"
fi
log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/dbeaver-dev"
mkdir -p -- "$log_dir"
nohup setsid --fork -- /usr/bin/dbeaver "$@" </dev/null >>"$log_dir/launcher.log" 2>&1
