#!/usr/bin/env bash
set -euo pipefail

export LC_ALL=C

status() {
    local devices
    devices=$(nmcli -t -f TYPE,STATE device 2>/dev/null || true)
    if [[ $devices == *'ethernet:connected'* ]]; then
        printf '%%{F#a3be8c}󰈀%%{F-}\n'
    elif [[ $devices == *'wifi:connected'* ]]; then
        printf '%%{F#a3be8c}%%{F-}\n'
    else
        printf '%%{F#d35f5e}󰖪%%{F-}\n'
    fi
}

menu() {
    local reply
    # awesome-client can exit successfully even when the evaluated Lua failed.
    # Only skip the standalone menu when Awesome confirms it opened the popup.
    if command -v awesome-client >/dev/null 2>&1 &&
        reply=$(awesome-client 'local ok = pcall(function() require("quickmenus").toggle("network") end); return ok' 2>/dev/null) &&
        [[ $reply == *'boolean true'* ]]; then
        return 0
    fi

    local active_device wifi_enabled choice ssid password networks profile uuid profile_name
    if ! nmcli -t -f RUNNING general status >/dev/null 2>&1; then
        rofi -e 'No se puede acceder a NetworkManager. Vuelve a intentarlo en unos segundos.'
        return 0
    fi
    wifi_enabled=$(nmcli -t -f WIFI general status 2>/dev/null || true)
    active_device=$(nmcli -t -f DEVICE,TYPE,STATE device 2>/dev/null | awk -F: '$2 == "wifi" && $3 == "connected" {print $1; exit}' || true)
    choice=$(printf '%s\n' \
        'Conectar o cambiar Wi-Fi' \
        'Desconectar Wi-Fi' \
        'Olvidar una red Wi-Fi' \
        "$([[ $wifi_enabled == enabled ]] && printf 'Apagar Wi-Fi' || printf 'Encender Wi-Fi')" |
        rofi -dmenu -i -p 'Redes Wi-Fi') || return 0

    case "$choice" in
        '') return 0 ;;
        'Conectar o cambiar Wi-Fi')
            if ! nmcli radio wifi on >/dev/null 2>&1 || ! nmcli device wifi rescan >/dev/null 2>&1; then
                rofi -e 'No se pudo activar o buscar Wi-Fi. Revisa el adaptador y el modo avión.'
                return 0
            fi
            if ! networks=$(nmcli --escape no -g SSID device wifi list 2>/dev/null | awk 'NF && !seen[$0]++'); then
                rofi -e 'No se pudieron buscar las redes. Vuelve a intentarlo en unos segundos.'
                return 0
            fi
            if [[ -z $networks ]]; then
                rofi -e 'No se encontraron redes Wi-Fi disponibles.'
                return 0
            fi
            ssid=$(printf '%s\n' "$networks" | rofi -dmenu -i -p 'Elige una red') || return 0
            [[ -n $ssid ]] || return 0
            if nmcli device wifi connect "$ssid" >/dev/null 2>&1; then
                return 0
            fi
            password=$(rofi -dmenu -password -p "Clave de $ssid") || return 0
            [[ -n $password ]] || return 0
            if ! nmcli --wait 20 device wifi connect "$ssid" password "$password" >/dev/null 2>&1; then
                rofi -e 'No se pudo conectar. Comprueba la contraseña y vuelve a intentarlo.'
            fi
            return
            ;;
        'Desconectar Wi-Fi')
            [[ -n $active_device ]] && nmcli device disconnect "$active_device"
            return
            ;;
        'Olvidar una red Wi-Fi')
            local -a profiles=()
            while IFS= read -r uuid; do
                [[ -n $uuid ]] || continue
                profile_name=$(nmcli -g NAME connection show uuid "$uuid" 2>/dev/null || true)
                [[ -n $profile_name ]] && profiles+=("$uuid  $profile_name")
            done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null | awk -F: '$NF == "802-11-wireless" {print $1}')
            profile=$(printf '%s\n' "${profiles[@]}" | rofi -dmenu -i -p 'Elige la red que quieres olvidar') || return 0
            [[ -n $profile ]] || return 0
            uuid=${profile%%  *}
            nmcli connection delete uuid "$uuid"
            return
            ;;
        'Apagar Wi-Fi')
            nmcli radio wifi off
            return
            ;;
        'Encender Wi-Fi')
            nmcli radio wifi on
            return
            ;;
    esac
}

if [[ ${1:-} == --status ]]; then
    status
else
    menu
fi
