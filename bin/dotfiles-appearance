                #appearance { background: #0d1117; color: #b4b9d8;
                    font-family: JetBrainsMono Nerd Font, monospace; font-weight: 500; font-size: 13px;
                    border: 0; border-radius: 0; box-shadow: none; }
                #appearance label { color: #b4b9d8; }
                #appearance headerbar { background: #0d1117; color: #b4b9d8;
                    box-shadow: none; border: 0; border-radius: 0; min-height: 30px; }
