#!/usr/bin/env python3
"""Install the shared programming skills without starting models or changing approvals."""
import argparse
import datetime
import json
import inspect
import os
from pathlib import Path
import shutil
import shlex
import subprocess
import tempfile

NAMES = ('surgical-edits', 'anti-overengineering', 'repo-scaffold', 'appsec-guardrail', 'software-architect', 'context-efficiency')
NATIVE_NAMES = NAMES + ('oil-ui',)
BEGIN, END = '<!-- dotfiles-programming:start -->', '<!-- dotfiles-programming:end -->'


def merge_policy(existing, policy):
    block = BEGIN + '\n' + policy.rstrip() + '\n' + END
    if BEGIN in existing or END in existing:
        if existing.count(BEGIN) != 1 or existing.count(END) != 1:
            raise ValueError('Bloque de preferencias incompleto; conserva el archivo y revisa sus marcadores.')
        before, rest = existing.split(BEGIN, 1)
        _, after = rest.split(END, 1)
        return before + block + after
    return existing.rstrip() + ('\n\n' if existing.strip() else '') + block + '\n'


def write_policy(path, policy, backups):
    original = path.read_text() if path.exists() else ''
    content = merge_policy(original, policy)
    if content == original:
        return
    if path.exists():
        backups.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, backups / (str(path).replace('/', '_') + '.bak'))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content)


def link(source, target):
    if target.is_symlink() and target.resolve() == source.resolve():
        return
    if target.exists() or target.is_symlink():
        raise ValueError('Ya existe una skill ajena; no se sobrescribe: ' + str(target))
    target.parent.mkdir(parents=True, exist_ok=True)
    target.symlink_to(source.resolve(), target_is_directory=True)


def hub_json(*args):
    return json.loads(subprocess.check_output(['agent-hub', 'work', *args, '--json'], text=True))


def install_hub(source, backups):
    profiles = hub_json('profile', 'list')
    backups.mkdir(parents=True, exist_ok=True)
    (backups / 'hub-profiles.json').write_text(json.dumps(profiles, ensure_ascii=False, indent=2) + '\n')
    for name in NAMES:
        hub_json('skill', 'register', name, '--file', str(source / name / 'SKILL.md'), '--scope', 'global')
    # Base commands, models, containers, approvals and permission ceilings are inherited.
    by_id = {p['id']: p for p in profiles}
    specifications = [('antigravity', 'antigravity-architect', 'Arquitectura pragmática: diseño y cambios estructurales', 'architecture', 'software-architect')]
    allowed = {'version','id','provider','description','capabilities','specializations','skills','tools','priority_domains','context_max_chars','cost_class','roles','command','resume_command','format','model','enabled','container','adapter','permissions'}
    for base, ident, description, domain, skill in specifications:
        if base not in by_id:
            print('Perfil base no instalado; omitido:', base)
            continue
        if ident in by_id:
            print('Perfil existente conservado:', ident)
            continue
        profile = {k: v for k, v in by_id[base].items() if k in allowed}
        profile.update(id=ident, description=description)
        profile['skills'] = list(dict.fromkeys(profile.get('skills', []) + [skill]))
        profile['specializations'] = list(dict.fromkeys(profile.get('specializations', []) + [domain]))
        profile['priority_domains'] = list(dict.fromkeys(profile.get('priority_domains', []) + [domain]))
        with tempfile.NamedTemporaryFile(mode='w', suffix='.json') as output:
            json.dump(profile, output)
            output.flush()
            hub_json('profile', 'register', '--file', output.name)
    print('Agent Hub: seis skills globales y perfiles especializados registrados.')


def install_cursor_context(home, backups):
    path = home / '.cursor/hooks.json'
    data = json.loads(path.read_text()) if path.exists() else {'version': 1, 'hooks': {}}
    command = shlex.join([str(Path(__file__).resolve().with_name('dotfiles-cursor-context'))])
    entries = data.setdefault('hooks', {}).setdefault('sessionStart', [])
    entry = {'command': command}
    if entry in entries:
        return
    if path.exists():
        backups.mkdir(parents=True, exist_ok=True)
        shutil.copy2(path, backups / 'cursor-hooks.json.bak')
    entries.append(entry)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')
    path.chmod(0o600)


def architecture_hooks(data, agent, guard):
    """Migrate only our exact command handlers; keep mixed groups and other hooks."""
    commands = {shlex.join([guard, '--agent', agent]),
                shlex.join([guard, '--agent', agent, '--event', 'SessionStart'])}

    def managed(handler):
        try:
            return shlex.join(shlex.split(handler.get('command', ''))) in commands
        except ValueError:
            return False

    hooks = data.setdefault('dotfiles-architecture' if agent == 'antigravity' else 'hooks', {})
    old_event = 'preToolUse' if agent == 'cursor' else 'PreToolUse'
    if old_event in hooks:
        kept = []
        for entry in hooks[old_event]:
            if agent == 'cursor':
                if not managed(entry):
                    kept.append(entry)
            else:
                remaining = [handler for handler in entry.get('hooks', []) if not managed(handler)]
                if remaining or not entry.get('hooks'):
                    kept.append(dict(entry, hooks=remaining) if entry.get('hooks') else entry)
        if kept:
            hooks[old_event] = kept
        else:
            del hooks[old_event]
    command = shlex.join([guard, '--agent', agent, '--event', 'SessionStart'])
    handler = {'type': 'command', 'command': command, 'timeout': 5}
    if agent == 'cursor':
        data.setdefault('version', 1)
        entry = {'command': command}
    elif agent == 'codex':
        entry = {'hooks': [handler]}
    else:
        entry = handler
    entries = hooks.setdefault('sessionStart' if agent == 'cursor' else 'SessionStart', [])
    if entry not in entries:
        entries.append(entry)
    return data


def install_architecture_guards(home, backups):
    guard = str(Path(__file__).resolve().with_name('dotfiles-architecture-guard'))
    for agent, path in (
        ('codex', Path(os.environ.get('CODEX_HOME', str(home/'.codex')))/'hooks.json'),
        ('cursor', home/'.cursor/hooks.json'),
        ('antigravity', home/'.gemini/config/hooks.json')):
        original = path.read_text() if path.exists() else ''
        data = architecture_hooks(json.loads(original) if original else {}, agent, guard)
        if original and json.loads(original) == data:
            continue
        if path.exists():
            backups.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, backups/(agent+'-before-architecture.json.bak'))
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\n')


def install_session_context(home, backups):
    helper = str(Path(__file__).resolve().with_name('dotfiles-session-context'))
    for agent, path in (
        ('codex', Path(os.environ.get('CODEX_HOME', str(home/'.codex')))/'hooks.json'),
        ('antigravity', home/'.gemini/config/hooks.json')):
        data = json.loads(path.read_text()) if path.exists() else {}
        hooks = data.setdefault('hooks', {}) if agent == 'codex' else data.setdefault('dotfiles-context-efficiency', {})
        handler = {'type': 'command', 'command': shlex.join([helper, '--agent', agent]), 'timeout': 5}
        entry = {'hooks': [handler]} if agent == 'codex' else handler
        if agent == 'codex':
            handler['additionalContextLimit'] = 5000
        entries = hooks.setdefault('SessionStart', [])
        if entry in entries:
            continue
        if path.exists():
            backups.mkdir(parents=True, exist_ok=True)
            shutil.copy2(path, backups/(agent+'-before-session-context.json.bak'))
        entries.append(entry)
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(json.dumps(data, ensure_ascii=False, indent=2)+'\n')
        path.chmod(0o600)


def remove_hermes_programming(home, names):
    """Quarantine only programming components distributed by this installer."""
    home = Path(home)
    policy_path = home/'SOUL.md'
    original = policy_path.read_text() if policy_path.exists() else ''
    begin, end = '<!-- dotfiles-programming:start -->', '<!-- dotfiles-programming:end -->'
    updated = original
    if begin in original or end in original:
        if original.count(begin) != 1 or original.count(end) != 1:
            raise ValueError('Bloque de preferencias incompleto; no se cambia Hermes.')
        before, rest = original.split(begin, 1)
        _, after = rest.split(end, 1)
        updated = before + after
    paths = [home/'skills/programming'/name for name in names]
    paths += [home/'plugins'/name for name in ('dotfiles-architecture', 'dotfiles-context-efficiency')]
    paths = [path for path in paths if path.exists() or path.is_symlink()]
    if not paths and updated == original:
        return None
    backup = home/'backups'/('remove-programming-'+datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f'))
    backup.mkdir(parents=True)
    if updated != original:
        shutil.copy2(policy_path, backup/'SOUL.md')
        policy_path.write_text(updated)
    for path in paths:
        saved = backup/path.relative_to(home)
        saved.parent.mkdir(parents=True, exist_ok=True)
        shutil.move(str(path), str(saved))
    return str(backup)


def uninstall_hermes_programming(container):
    code = ('import datetime,json,shutil\nfrom pathlib import Path\n' +
            inspect.getsource(remove_hermes_programming) +
            "\nprint(json.dumps({'backup':remove_hermes_programming('/opt/hermes/.hermes'," + repr(NATIVE_NAMES) + ")}))")
    subprocess.run(['podman', 'exec', '-i', '--', container, 'python3', '-c', code], check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--source', type=Path, default=Path.home() / '.config/agent-skills')
    parser.add_argument('--hub', action='store_true', help='registrar skills y perfiles en Agent Hub')
    parser.add_argument('--hermes', metavar='CONTAINER', help=argparse.SUPPRESS)
    parser.add_argument('--remove-hermes-programming', metavar='CONTAINER', help='retirar solo skills, bloque y plugins de programación administrados; conservar Hermes académico')
    parser.add_argument('--architecture-only', action='store_true', help='sincronizar solo preferencias y hooks de arquitectura locales; sin perfiles, enlaces ni contenedores')
    args = parser.parse_args()
    if args.hermes:
        parser.error('Hermes es solo académico: ya no se instala programación. Usa --remove-hermes-programming CONTAINER para retirar la instalación anterior.')
    if args.remove_hermes_programming:
        if args.architecture_only or args.hub:
            parser.error('--remove-hermes-programming es una operación independiente')
        uninstall_hermes_programming(args.remove_hermes_programming)
        return
    if args.architecture_only and args.hub:
        parser.error('--architecture-only no se combina con --hub')
    source = args.source.resolve()
    if args.architecture_only:
        home = Path.home()
        backups = Path(os.environ.get('XDG_STATE_HOME', str(home/'.local/state'))) / 'dotfiles/agent-skills' / datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
        policy = (source/'AGENTS.md').read_text()
        for dest in (Path(os.environ.get('CODEX_HOME', str(home/'.codex')))/'AGENTS.md', home/'.gemini/config/AGENTS.md'):
            write_policy(dest, policy, backups)
        install_architecture_guards(home, backups)
        print('Preferencias y contexto de arquitectura locales sincronizados; sin cambios en permisos, perfiles ni contenedores.')
        return
    for name in NATIVE_NAMES:
        if not (source / name / 'SKILL.md').is_file():
            parser.error('Skill no encontrada: ' + name)
    home = Path.home()
    # Check collisions before changing any native skill links.
    for base in (home / '.agents/skills', home / '.gemini/config/skills', home / '.cursor/skills'):
        for name in NATIVE_NAMES:
            dest = base / name
            if (dest.exists() or dest.is_symlink()) and dest.resolve() != (source / name).resolve():
                parser.error('Skill existente conservada: ' + str(dest))
    for base in (home / '.agents/skills', home / '.gemini/config/skills', home / '.cursor/skills'):
        for name in NATIVE_NAMES:
            link(source / name, base / name)
    backups = Path(os.environ.get('XDG_STATE_HOME', str(home / '.local/state'))) / 'dotfiles/agent-skills' / datetime.datetime.now().strftime('%Y%m%d-%H%M%S-%f')
    policy = (source / 'AGENTS.md').read_text()
    for dest in (Path(os.environ.get('CODEX_HOME', str(home / '.codex'))) / 'AGENTS.md', home / '.gemini/config/AGENTS.md'):
        write_policy(dest, policy, backups)
    install_cursor_context(home, backups)
    install_session_context(home, backups)
    install_architecture_guards(home, backups)
    if args.hub:
        install_hub(source, backups)
    print('Codex, Cursor y Antigravity: seis skills de programación, Oil UI y preferencias instaladas.')


if __name__ == '__main__':
    main()
