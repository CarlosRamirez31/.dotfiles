[Desktop Entry]
Type=Application
TryExec=kitty
Exec=/usr/bin/bash -lc "exec ~/.local/bin/dotfiles-terminal"
Icon=kitty
Terminal=false
Categories=System;TerminalEmulator;
Name=Kitty
GenericName=Terminal
Comment=A fast, cross-platform, OpenGL terminal emulator
StartupNotify=true
StartupWMClass=kitty
Actions=New;

[Desktop Action New]
Name=New Terminal
Exec=/usr/bin/bash -lc "exec ~/.local/bin/dotfiles-terminal"
