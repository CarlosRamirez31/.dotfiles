configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "Oranchelo";
    terminal: "dotfiles-terminal";
    run-command: "{cmd}";
    display-drun: "";
    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
}

* {
    font: "JetBrainsMono Nerd Font SemiBold 11";
}

@theme "theme"
