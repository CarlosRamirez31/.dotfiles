#!/usr/bin/env python3
"""List and adjust the playback streams grouped by application."""
import hashlib
import json
import os
import subprocess
import sys


def pulse(*args):
    return subprocess.run(("pactl", *args), check=True, capture_output=True, text=True, timeout=3,
                          env={**os.environ, "LC_ALL": "C"}).stdout


def applications():
    groups = {}
    for stream in json.loads(pulse("--format=json", "list", "sink-inputs")):
        props = stream.get("properties", {})
        name = props.get("application.name") or props.get("application.process.binary") or "Audio"
        key = (props.get("application.id") or props.get("application.process.binary") or name, name)
        group = groups.setdefault(key, [])
        group.append(stream)
    return groups


def main():
    groups = applications()
    for (app, name), streams in sorted(groups.items(), key=lambda item: item[0][1].casefold()):
        identifier = hashlib.sha256(f"{app}\0{name}".encode()).hexdigest()[:24]
        if len(sys.argv) == 1:
            channels = [int(channel["value_percent"].rstrip("%")) for stream in streams
                        for channel in stream.get("volume", {}).values()]
            volume = round(sum(channels) / len(channels)) if channels else 0
            print(identifier, int(all(stream.get("mute") for stream in streams)), volume,
                  " ".join(name.split())[:90], sep="\t")
        elif len(sys.argv) == 3 and sys.argv[1] == identifier:
            value = sys.argv[2]
            if value == "mute":
                target = "0" if all(stream.get("mute") for stream in streams) else "1"
                operation = "set-sink-input-mute"
            elif value.isascii() and value.isdecimal() and len(value) <= 3 and int(value) <= 100:
                target, operation = value + "%", "set-sink-input-volume"
            else:
                return 2
            result = 0
            for stream in streams:
                try:
                    pulse(operation, str(int(stream["index"])), target)
                except subprocess.SubprocessError:
                    result = 1
            return result
    return int(len(sys.argv) != 1)


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, subprocess.SubprocessError, ValueError, KeyError):
        sys.exit(1)
