#!/usr/bin/env bash

set -uo pipefail

declare -a app_names=()
declare -a app_icons=()
declare -a app_files=()
declare -A seen_entries=()

locale_name=${LC_MESSAGES:-${LANG:-}}
locale_name=${locale_name%%.*}
locale_name=${locale_name%%@*}
locale_language=${locale_name%%_*}

data_home=${XDG_DATA_HOME:-$HOME/.local/share}
data_dirs=${XDG_DATA_DIRS:-/usr/local/share:/usr/share}
IFS=: read -r -a system_data_dirs <<<"$data_dirs"
application_dirs=("$data_home/applications")
for data_dir in "${system_data_dirs[@]}"; do
    application_dirs+=("$data_dir/applications")
done

for application_dir in "${application_dirs[@]}"; do
    [[ -d $application_dir ]] || continue

    while IFS= read -r -d '' desktop_file; do
        relative_name=${desktop_file#"$application_dir/"}
        [[ -z ${seen_entries[$relative_name]+present} ]] || continue
        seen_entries[$relative_name]=1

        in_desktop_entry=false
        entry_type=""
        entry_name=""
        localized_name=""
        language_name=""
        entry_icon="application-x-executable"
        hidden=false
        no_display=false

        while IFS= read -r line || [[ -n $line ]]; do
            line=${line%$'\r'}

            if [[ $line == "[Desktop Entry]" ]]; then
                in_desktop_entry=true
                continue
            fi
            if [[ $line == \[*\] ]]; then
                [[ $in_desktop_entry == true ]] && break
                continue
            fi
            [[ $in_desktop_entry == true && $line == *=* ]] || continue

            key=${line%%=*}
            value=${line#*=}
            case $key in
                Type) entry_type=$value ;;
                Name) entry_name=$value ;;
                Icon) entry_icon=$value ;;
                Hidden) [[ ${value,,} == true ]] && hidden=true ;;
                NoDisplay) [[ ${value,,} == true ]] && no_display=true ;;
            esac

            if [[ -n $locale_name && $key == "Name[$locale_name]" ]]; then
                localized_name=$value
            elif [[ -n $locale_language && $key == "Name[$locale_language]" ]]; then
                language_name=$value
            fi
        done <"$desktop_file"

        [[ $entry_type == Application ]] || continue
        [[ $hidden == false && $no_display == false ]] || continue

        display_name=${localized_name:-${language_name:-$entry_name}}
        [[ -n $display_name ]] || continue

        app_names+=("$display_name")
        app_icons+=("$entry_icon")
        app_files+=("$desktop_file")
    done < <(find "$application_dir" -type f -name '*.desktop' -print0 2>/dev/null)
done

if (( ${#app_files[@]} == 0 )); then
    notify-send "Applications" "No se encontraron archivos .desktop." 2>/dev/null || true
    exit 1
fi

selected_index=$(
    for index in "${!app_names[@]}"; do
        printf '%s\0icon\x1f%s\n' "${app_names[$index]}" "${app_icons[$index]}"
    done | /usr/bin/rofi \
        -dmenu \
        -i \
        -no-custom \
        -show-icons \
        -format i \
        -p "Buscar una aplicación"
)
rofi_status=$?

[[ $rofi_status -eq 0 && $selected_index =~ ^[0-9]+$ ]] || exit 0
(( selected_index < ${#app_files[@]} )) || exit 1

selected_file=${app_files[$selected_index]}
log_file=${XDG_RUNTIME_DIR:-/tmp}/dotfiles-app-launcher.log

if ! launch_error=$(/usr/bin/gio launch "$selected_file" 2>&1); then
    {
        printf '[%(%Y-%m-%d %H:%M:%S)T] %s\n' -1 "$selected_file"
        printf '%s\n' "$launch_error"
    } >>"$log_file"
    notify-send \
        "No se pudo abrir ${app_names[$selected_index]}" \
        "Revisa $log_file" 2>/dev/null || true
    exit 1
fi
