{
  "scalingPriority": "hyprland",
  "terminal": "/usr/bin/ghostty",
  "wallpaper.enable": false,
  "notifications.position": "top right",
  "notifications.active_monitor": true,
  "notifications.displayedTotal": 4,
  "notifications.timeout": 4500,
  "notifications.autoDismiss": true,
  "notifications.showActionsOnHover": true,
  "menus.transition": "slide_down",
  "menus.transitionTime": 0,
  "menus.dashboard.shortcuts.enabled": false,
  "menus.dashboard.directories.enabled": false,
  "menus.dashboard.controls.enabled": true,
  "menus.dashboard.stats.enabled": true,
  "menus.dashboard.stats.interval": 5000,
  "menus.dashboard.stats.enable_gpu": false,
  "menus.clock.weather.enabled": false,
  "bar.layouts": {
    "0": {
      "left": ["dashboard", "windowtitle"],
      "middle": ["workspaces"],
      "right": ["volume", "network", "ram", "cpu", "clock", "notifications"]
    },
    "1": {
      "left": ["dashboard", "windowtitle"],
      "middle": ["workspaces"],
      "right": ["volume", "network", "ram", "cpu", "clock", "notifications"]
    },
    "2": {
      "left": ["dashboard", "windowtitle"],
      "middle": ["workspaces"],
      "right": ["volume", "network", "ram", "cpu", "clock", "notifications"]
    }
  },
  "bar.launcher.icon": "󰊠",
  "bar.launcher.rightClick": "/usr/bin/bash -lc '$HOME/.local/bin/dotfiles-app-launcher'",
  "bar.launcher.middleClick": "/usr/bin/ghostty",
  "bar.clock.format": "%H:%M",
  "bar.clock.icon": "󰥔",
  "bar.network.showWifiInfo": true,
  "bar.notifications.show_total": true,
  "bar.windowtitle.icon": true,
  "bar.windowtitle.truncation": true,
