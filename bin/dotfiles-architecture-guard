#!/usr/bin/env python3
"""Provide architecture context at session startup, without deciding permissions."""
import argparse
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import sys

loader = importlib.machinery.SourceFileLoader('directory_memory', str(Path(__file__).resolve().with_name('dotfiles-project-context')))
spec = importlib.util.spec_from_loader(loader.name, loader)
memory = importlib.util.module_from_spec(spec)
loader.exec_module(memory)

REMINDER = (
    'Arquitectura orientativa: explora, consulta upstream, adquiere repositorios autorizados '
    '(clonar escribe), verifica herramientas, obtén baseline y prepara documentación sin exigir registro previo. '
    'Contrasta el área pertinente con el código; defined no demuestra cobertura. '
    'La arquitectura ausente, draft o con decisiones pendientes solo genera un aviso, nunca un bloqueo: '
    '«Falta definir o actualizar la arquitectura de esta parte. Puedes continuar con la tarea '
    'o definir la arquitectura primero». Ofrece ambas opciones sin exigir confirmación por rutina. '
    'Si el usuario pidió implementar, continúa con el cambio mínimo razonable e indica los supuestos; '
    'si elige definir primero, prepara ese diseño. Pregunta solo por información imprescindible no inferible. '
    'Si la memoria no es escribible, conserva la actualización pendiente fuera del código en una ruta '
    'autorizada e informa su ubicación; puedes continuar aunque no se haya definido ni persistido arquitectura. '
    'No amplíes permisos ni fabriques arquitectura. Se mantienen los controles nativos de secretos, '
    'credenciales, publicación/push, destrucción, rutas, dinero y servicios externos.'
)


def context(payload, root=None):
    """Read metadata only: no command parsing, execution, receipts or inferred approval."""
    roots = payload.get('workspacePaths') or payload.get('workspace_roots') or []
    cwd = Path(payload.get('cwd') or (roots[0] if roots else os.getcwd())).expanduser().resolve()
    # Agent Hub may attach the source's architecture to an explicitly associated workspace.
    managed = os.environ.get('DOTFILES_WORKSPACE_DIRECTORY')
    source = os.environ.get('DOTFILES_PROJECT_DIRECTORY')
    if managed and source and cwd.is_relative_to(Path(managed).resolve()):
        cwd = Path(source).resolve()
    storage = Path(root or memory.default_root(cwd)).expanduser().resolve()
    try:
        info = memory.describe(memory.existing(cwd, storage))
        doc = info['documents']['architecture']
    except (OSError, ValueError, KeyError, TypeError):
        return REMINDER + '\nMemoria externa ausente o inaccesible para ' + str(cwd) + (
            '. Es un problema de registro/lectura, no evidencia de una decisión de diseño pendiente. '
            'Consulta dotfiles-project-context show si está disponible; init solo si la ruta está autorizada y es escribible.'
        )
    return REMINDER + '\nReferencia externa (lee solo el contenido pertinente y contrástalo): ' + str(doc['path']) + (
        '\nEstado: ' + str(info['architecture_status']) + '; revisión: ' + str(doc['revision']) +
        '. Si cambia la revisión, vuelve a consultar el área afectada. No se ha acreditado su lectura ni su cobertura.'
    )


def check(payload, agent='codex', root=None, receipts=None):
    """Compatibility for old Hermes pre_tool_call plugins: never gate a tool.

    Old plugins interpret any truthy return value as action=block. The installer
    no longer distributes programming to Hermes; remove the old plugin when possible.
    """
    return None


def reply(agent, message):
    """SessionStart contracts only; no permission decision or tool auto-approval."""
    if not message:
        return {}
    if agent == 'codex':
        return {'hookSpecificOutput': {'hookEventName': 'SessionStart', 'additionalContext': message}}
    if agent == 'cursor':
        return {'additional_context': message}
    if agent == 'antigravity':
        return {'injectSteps': [{'systemMessage': {'systemMessage': message}}]}
    raise ValueError('Hermes académico queda excluido de los hooks de programación.')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--agent', choices=('codex', 'cursor', 'antigravity'), required=True)
    parser.add_argument('--event', choices=('SessionStart', 'PreToolUse'), default='PreToolUse')
    args = parser.parse_args(argv)
    if args.event == 'PreToolUse':
        # Compatibility during migration. Cursor/Antigravity have no neutral
        # PreToolUse response contract; remove those handlers, never emit allow.
        if args.agent != 'codex':
            print('Migra el handler de arquitectura a SessionStart con dotfiles-agent-skills.', file=sys.stderr)
            return 1
        print('{}')
        return 0
    try:
        payload = json.loads(sys.stdin.read(1024*1024))
        if not isinstance(payload, dict):
            raise ValueError('payload')
        message = context(payload)
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        message = REMINDER + '\nNo se pudo consultar la referencia externa; revisa el contexto pertinente.'
    print(json.dumps(reply(args.agent, message), ensure_ascii=False))
    return 0


if __name__ == '__main__':
    sys.exit(main())
