#!/usr/bin/env bash
set -euo pipefail

mode=${1:-full}
pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
[[ -n $pictures_dir ]] || pictures_dir="$HOME/Pictures"
output_dir="$pictures_dir/Screenshots"
output="$output_dir/$(date +%Y-%m-%d_%H-%M-%S).png"
mkdir -p -- "$output_dir"

case $mode in
    full)
        maim "$output"
        ;;
    area)
        geometry=$(slop -f '%x %y %w %h') || exit 0
        [[ -n $geometry ]] || exit 0
        read -r x y width height <<<"$geometry"
        maim -g "${width}x${height}+${x}+${y}" "$output"
        ;;
    edit)
        flameshot gui --path "$output"
        [[ -s $output ]] || exit 0
        ;;
    *)
        printf 'Usage: %s {full|area|edit}\n' "${0##*/}" >&2
        exit 2
        ;;
esac

xclip -selection clipboard -t image/png -i <"$output"
notify-send -a Screenshot -i "$output" 'Captura guardada' "$(basename -- "$output")"
