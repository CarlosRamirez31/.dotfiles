#!/usr/bin/env python3
"""Capture a window on an isolated X11 connection; never touch Awesome's Cairo device."""
import os
from pathlib import Path
import subprocess
import sys


def capture(window, output):
    if not window.isascii() or not window.isdecimal() or not 0 < int(window) <= 0xffffffff:
        raise ValueError('Invalid window ID')
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise ValueError('Missing session runtime directory')
    directory = Path(runtime) / 'dotfiles-window-previews'
    output = Path(output)
    if output.parent.resolve() != directory.resolve() or output.suffix != '.png':
        raise ValueError('Invalid snapshot destination')
    process = subprocess.Popen(['maim', '-i', window], stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
    try:
        result = subprocess.run(['magick', '-limit', 'memory', '64MiB', '-limit', 'map', '64MiB',
                                 '-limit', 'disk', '0', 'png:-', '-thumbnail', '320x200>',
                                 '-strip', 'png:' + str(output)], stdin=process.stdout,
                                stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
        process.stdout.close()
        code = process.wait(timeout=2)
        if code or result.returncode:
            output.unlink(missing_ok=True)
            return 1
        return 0
    except Exception:
        process.kill()
        process.wait()
        output.unlink(missing_ok=True)
        raise


if __name__ == '__main__':
    try:
        if len(sys.argv) != 3:
            raise ValueError('Expected window ID and output path')
        sys.exit(capture(*sys.argv[1:]))
    except (OSError, ValueError, subprocess.SubprocessError):
        sys.exit(1)
