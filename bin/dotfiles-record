#!/usr/bin/env bash
set -euo pipefail

runtime_dir=${XDG_RUNTIME_DIR:-/tmp}
pid_file="$runtime_dir/dotfiles-x11-recorder.pid"

if [[ -s $pid_file ]]; then
    recorder_pid=$(<"$pid_file")
    if [[ $recorder_pid =~ ^[0-9]+$ ]] && kill -0 "$recorder_pid" 2>/dev/null; then
        recorder_command=$(ps -p "$recorder_pid" -o args= 2>/dev/null || true)
        if [[ $recorder_command == *ffmpeg* && $recorder_command == *x11grab* ]]; then
            kill -INT "$recorder_pid"
            rm -f -- "$pid_file"
            notify-send -a Recorder 'Grabación finalizada'
            exit 0
        fi
    fi
    rm -f -- "$pid_file"
fi

videos_dir=$(xdg-user-dir VIDEOS 2>/dev/null || true)
[[ -n $videos_dir ]] || videos_dir="$HOME/Videos"
output_dir="$videos_dir/Recordings"
output="$output_dir/$(date +%Y-%m-%d_%H-%M-%S).mp4"
mkdir -p -- "$output_dir"

input_args=()
if [[ ${1:-area} == area ]]; then
    geometry=$(slop -f '%x %y %w %h') || exit 0
    [[ -n $geometry ]] || exit 0
    read -r x y width height <<<"$geometry"
    input_args=(-video_size "${width}x${height}" -i "${DISPLAY:?DISPLAY is required}+${x},${y}")
else
    read -r width height < <(xrandr --current | awk '/\*/ { split($1, size, "x"); print size[1], size[2]; exit }')
    [[ -n ${width:-} && -n ${height:-} ]] || exit 1
    input_args=(-video_size "${width}x${height}" -i "${DISPLAY:?DISPLAY is required}")
fi

nohup ffmpeg -y -f x11grab -framerate 30 "${input_args[@]}" -c:v libx264 -preset veryfast -pix_fmt yuv420p "$output" >"$runtime_dir/dotfiles-x11-recorder.log" 2>&1 &
printf '%s\n' "$!" >"$pid_file"
notify-send -a Recorder 'Grabación iniciada' 'Usa Alt+Shift+R para detenerla.'
