#!/usr/bin/env python3
"""Direct RNNoise controls and a separate experimental personal voice input."""
import argparse
import array
from contextlib import suppress
import fcntl
import json
import math
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import threading
import time
import uuid

HOME = Path.home()
CONFIG = Path(os.getenv('XDG_CONFIG_HOME', HOME / '.config')) / 'voice-isolation'
DATA = Path(os.getenv('XDG_DATA_HOME', HOME / '.local/share')) / 'voice-isolation/personal-voice'
STATE = Path(os.getenv('XDG_RUNTIME_DIR', '/tmp')) / 'dotfiles-microphone.json'
SOURCE = 'dotfiles_personal_voice'
BUS = 'dotfiles_personal_voice_bus'
FILTER = 'dotfiles_voice_isolation'
VOICE_THRESHOLD = 0.60
VOICE_CONTINUE_THRESHOLD = 0.45
VOICE_UNCERTAIN_CHUNKS = 2


def run(*args):
    try:
        return subprocess.check_output(args, text=True, stderr=subprocess.PIPE, timeout=30).strip()
    except FileNotFoundError as error:
        raise RuntimeError('Falta el comando «' + args[0] + '» en el host.') from error
    except subprocess.CalledProcessError as error:
        detail = (error.stderr or error.stdout or '').strip()
        raise RuntimeError('Falló «' + ' '.join(args) + '»: ' +
                           (detail or f'código de salida {error.returncode}')) from error


def pactl(*args):
    return run('pactl', *args)


def sources():
    return json.loads(pactl('-f', 'json', 'list', 'sources'))


def modules():
    items = json.loads(pactl('-f', 'json', 'list', 'modules'))
    if any('index' not in item for item in items):
        # Some pactl versions omit module indices in JSON on PipeWire.
        indices = {}
        for line in pactl('list', 'short', 'modules').splitlines():
            columns = line.split('\t')
            if len(columns) >= 3 and columns[0].isdigit():
                indices[(columns[1], columns[2])] = int(columns[0])
        for item in items:
            if 'index' not in item:
                item['index'] = indices.get((item['name'], item.get('argument', '')))
    return [item for item in items if item.get('index') is not None]


def physical(items):
    return [s for s in items if s.get('properties', {}).get('device.api')
            and not s['name'].endswith('.monitor')
            and str(s.get('properties', {}).get('node.virtual', '')).lower() not in ('true', '1')]


def settings():
    try:
        return json.loads((CONFIG / 'microphone.json').read_text())
    except FileNotFoundError:
        return {'noise': True, 'personal': False, 'source': ''}


def voice_profiles():
    profiles = settings().get('profiles', {})
    if not profiles and (DATA / 'my-voice.npy').exists():
        return {'legacy': {'name': 'Mi voz', 'file': 'my-voice.npy'}}
    return profiles


def selected_profile():
    profiles = voice_profiles()
    key = settings().get('profile')
    return key if key in profiles else next(iter(profiles), None)


def profile_path():
    profile = voice_profiles().get(selected_profile(), {})
    return DATA / Path(profile.get('file', 'missing-profile')).name


def select_profile(key):
    if key not in voice_profiles():
        raise ValueError('El perfil seleccionado ya no existe.')
    config = settings()
    config['profiles'] = voice_profiles()
    config['profile'] = key
    save(config)
    if config.get('personal') and not personal_running():
        change('personal', True)
    print('Perfil seleccionado y guardado: ' + voice_profiles()[key]['name'], flush=True)


def delete_profile(key):
    profiles = voice_profiles()
    if key not in profiles:
        raise ValueError('El perfil seleccionado ya no existe.')
    active = selected_profile() == key
    resume = active and settings().get('personal', False)
    if resume and len(profiles) == 1:
        change('personal', False)
    profile = profiles.pop(key)
    config = settings()
    config['profiles'] = profiles
    if active:
        config['profile'] = next(iter(profiles), None)
    (DATA / Path(profile['file']).name).unlink(missing_ok=True)
    save(config)
    if resume and profiles and not personal_running():
        change('personal', True)
    print('Perfil «' + profile['name'] + '» eliminado. ' +
          ('Selección guardada.' if profiles else 'No quedan perfiles. Solo mi voz está apagado.'), flush=True)


def configure_profile(name):
    name = (name or '').strip()
    if not name or len(name) > 80:
        raise ValueError('Escribe un nombre de perfil de 1 a 80 caracteres.')
    if not model_ready():
        print('Preparando reconocimiento automáticamente; la primera vez puede tardar varios minutos…', flush=True)
        subprocess.run([str(HOME / '.local/libexec/dotfiles-personal-voice-setup')], check=True)
    os.execv(str(DATA / 'venv/bin/python'), [str(DATA / 'venv/bin/python'), __file__, 'enroll', name])


def source_label(source, port=None):
    port = port or source.get('active_port')
    description = next((p.get('description', p['name']) for p in source.get('ports', []) if p['name'] == port), '')
    return source.get('description', source['name']) + (' · ' + description if description else '')


def check_port(source, port):
    if port and not any(p['name'] == port and p.get('availability') != 'not available' for p in source.get('ports', [])):
        raise ValueError('El micrófono de ese conector está desconectado. Elige otra entrada.')


def level_key(source, port=None):
    return json.dumps([source['name'], port or source.get('active_port') or ''])


def channel_levels(source):
    return [v['value'] for v in source.get('volume', {}).values()]


def recording_apps(items=None, streams=None):
    items = sources() if items is None else items
    streams = json.loads(pactl('-f', 'json', 'list', 'source-outputs')) if streams is None else streams
    microphones = {s['index'] for s in items if not s['name'].endswith('.monitor')}
    source_mutes = {s['index']: s.get('mute', False) for s in items}
    groups = {}
    for stream in streams:
        props = stream.get('properties', {})
        if stream.get('source') not in microphones or stream.get('corked', False):
            continue
        if props.get('application.name') == 'dotfiles-microphone' or props.get('node.name') == 'dotfiles_voice_capture':
            continue
        if props.get('node.name', '').startswith(('input.dotfiles_microphone', 'input.dotfiles_personal_voice')):
            continue
        name = props.get('application.name') or props.get('media.name') or 'Aplicación de audio'
        key = (name, props.get('application.process.id', ''))
        app = groups.setdefault(key, {'name': name, 'streams': [], 'muted': True})
        app['streams'].append(stream['index'])
        app['muted'] = app['muted'] and (stream.get('mute', False) or source_mutes.get(stream['source'], False))
    return list(groups.values())


def muted():
    items = sources()
    output = next((s for s in items if s['name'] == FILTER), {})
    return all(s.get('mute', False) for s in physical(items)) or output.get('mute', False)


def microphone_switch(action):
    enabled = muted() if action == 'toggle' else action == 'on'
    config = settings()
    config['muted'] = not enabled
    save(config)
    for source in sources():
        if source in physical([source]) or source['name'] in (SOURCE, FILTER):
            pactl('set-source-mute', source['name'], '0' if enabled else '1')


def bar_status():
    apps = recording_apps()
    is_muted = muted()
    if any(not a['muted'] for a in apps):
        is_muted = False
    if not apps and not is_muted:
        return ''
    names = ', '.join(a['name'] for a in apps)
    names = ''.join(c for c in names if c.isprintable() and c not in '%{}')[:28]
    icon, color = ('󰍭', '#a6adc8') if is_muted else ('󰍬', '#f38ba8')
    return '%{F' + color + '}' + icon + '%{F-}' + ((' ' + names) if names and not is_muted else '')


def save(values):
    CONFIG.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(mode='w', dir=CONFIG, delete=False) as f:
        json.dump(values, f)
    os.replace(f.name, CONFIG / 'microphone.json')


def choose(items, requested, default):
    candidates = physical(items)
    if requested and requested not in [s['name'] for s in candidates]:
        raise ValueError('El micrófono seleccionado está desconectado. Elige otro en el panel.')
    for name in (requested, default):
        if name:
            for source in candidates:
                if source['name'] == name:
                    return source
    if not candidates:
        raise ValueError('No hay micrófono físico disponible.')
    return candidates[0]


def set_filter_source(name):
    path = CONFIG / 'environment'
    lines = path.read_text().splitlines() if path.exists() else []
    lines = [line for line in lines if not line.startswith(('VOICE_ISOLATION_SOURCE=', 'VOICE_ISOLATION_INPUT_VOLUME='))]
    # The mic's own volume is remembered by WirePlumber, independently for each device.
    lines += ['VOICE_ISOLATION_SOURCE=' + json.dumps(name), 'VOICE_ISOLATION_INPUT_VOLUME=keep']
    CONFIG.mkdir(parents=True, exist_ok=True)
    path.write_text('\n'.join(lines) + '\n')


def set_status(**values):
    STATE.write_text(json.dumps(values))


def ensure_endpoint():
    names = [s['name'] for s in sources()]
    if SOURCE not in names:
        sinks = json.loads(pactl('-f', 'json', 'list', 'sinks'))
        if BUS not in [s['name'] for s in sinks]:
            pactl('load-module', 'module-null-sink', 'sink_name=' + BUS, 'channels=1', 'rate=48000',
                  'sink_properties="device.description=Prueba-Solo-mi-voz priority.session=0 node.virtual=true"')
        pactl('load-module', 'module-remap-source', 'master=' + BUS + '.monitor',
              'source_name=' + SOURCE, 'channels=1',
              'source_properties="device.description=Microfono-controlado-Solo-mi-voz node.virtual=true priority.session=0"')
    pactl('set-source-volume', SOURCE, '100%')


def read_exact(stream, size):
    data = bytearray()
    while len(data) < size:
        block = stream.read(size - len(data))
        if not block:
            break
        data.extend(block)
    return bytes(data)


def write_exact(stream, data):
    # Unbuffered audio pipes can write fewer bytes than requested.
    view = memoryview(data)
    while view:
        written = stream.write(view)
        if not written:
            raise BrokenPipeError('La salida del micrófono controlado dejó de aceptar audio.')
        view = view[written:]


class VoiceGate:
    """Pass a recognized speaker with bounded tolerance for brief confidence dips."""
    def __init__(self):
        self.previous = 0.0
        self.uncertain = 0

    def process(self, samples, probability):
        strong = math.isfinite(probability) and probability >= VOICE_THRESHOLD
        continuing = (math.isfinite(probability) and self.previous > 0
                      and probability >= VOICE_CONTINUE_THRESHOLD
                      and self.uncertain < VOICE_UNCERTAIN_CHUNKS)
        if not strong and not continuing:
            self.previous = 0.0
            self.uncertain = 0
            return bytes(len(samples) * 2)
        self.uncertain = 0 if strong else self.uncertain + 1
        out = array.array('h', samples)
        fade = min(80, len(out))
        for i in range(fade):
            gain = self.previous + (1.0 - self.previous) * i / max(1, fade)
            out[i] = int(out[i] * gain)
        self.previous = 1.0
        return out.tobytes()


def load_model():
    import torch
    torch.set_num_threads(min(4, os.cpu_count() or 1))
    sys.path.insert(0, str(DATA / 'nomo-pvad'))
    from nomo_pvad import NomoPVAD, NomoPVADSession
    try:
        backbone = json.loads((DATA / 'ready.json').read_text()).get('backbone')
    except (OSError, ValueError):
        backbone = None
    model = NomoPVAD(str(DATA / 'nomo-pvad/weights/nomo_pvad.pt'), eres2netv2_dir=backbone, device='cpu')
    return model, NomoPVADSession(model)


def model_ready():
    return (DATA / 'venv/bin/python').exists() and (DATA / 'ready.json').exists()


def model_check():
    import numpy as np
    import soundfile as sf
    model, session = load_model()
    audio, rate = sf.read(DATA / 'nomo-pvad/examples/enroll.wav', dtype='float32')
    if rate != 16000:
        raise ValueError('La muestra de prueba no es de 16 kHz')
    session.set_enrollment(audio)
    test, rate = sf.read(DATA / 'nomo-pvad/examples/test.wav', dtype='float32')
    elapsed, probabilities = [], []
    for start in range(0, len(test) - 2559, 2560):
        begin = time.monotonic()
        probabilities.append(float(session.process_chunk(test[start:start + 2560])))
        elapsed.append(time.monotonic() - begin)
    average = sum(elapsed[-10:]) / len(elapsed[-10:])
    if not np.isfinite(probabilities).all() or max(probabilities) < 0.85 or min(probabilities) > 0.45:
        raise ValueError('El modelo no distinguió las voces de prueba; no se habilitó Solo mi voz.')
    if average >= 0.14:
        raise ValueError(f'El modelo tarda {average:.3f}s por bloque: demasiado lento para usarlo en directo.')
    (DATA / 'ready.json').write_text(json.dumps({'seconds_per_chunk': average,
        'probabilities': probabilities, 'backbone': model._eres2netv2_dir,
        'reference': 'tuya/nomo-pvad release-1.1'}))
    print(f'Modelo preparado: {average * 1000:.0f} ms por bloque de 160 ms.', flush=True)


def enroll(name=None):
    import numpy as np
    if not model_ready():
        raise ValueError('Prepara primero el reconocimiento de voz.')
    model, _ = load_model()
    source = choose(sources(), settings().get('source', ''), pactl('get-default-source'))
    check_port(source, settings().get('port'))
    if settings().get('muted') or source.get('mute'):
        raise ValueError('Enciende el micrófono antes de grabar el perfil.')
    # Use the same processed input as live recognition when it is available.
    input_name = FILTER if FILTER in [s['name'] for s in sources()] else source['name']
    for seconds in (3, 2, 1):
        print(f'Empieza a leer en {seconds}…', flush=True)
        time.sleep(1)
    print('GRABANDO · Lee el texto durante 15 segundos.', flush=True)
    p = subprocess.Popen(['parec', '--client-name=dotfiles-microphone', '--device=' + input_name, '--format=s16le', '--rate=16000', '--channels=1'], stdout=subprocess.PIPE)
    try:
        raw = read_exact(p.stdout, 16000 * 2 * 15)
    finally:
        p.terminate(); p.wait(timeout=3)
    samples = np.frombuffer(raw, dtype='<i2').astype(np.float32) / 32768
    if len(samples) < 16000 * 14 or np.sqrt(np.mean(samples ** 2)) < 0.002:
        raise ValueError('La grabación fue demasiado corta o silenciosa. Vuelve a registrar tu voz.')
    if np.mean(np.abs(samples) >= 0.999) > 0.01:
        raise ValueError('El micrófono satura. Baja su volumen y vuelve a registrar tu voz.')
    print('Grabación terminada. Guardando el perfil de voz…', flush=True)
    embedding = model.extract_emb(samples).cpu().numpy()
    if embedding.size != 192 or not np.isfinite(embedding).all():
        raise ValueError('No se pudo obtener un perfil válido. Vuelve a grabar tu voz.')
    DATA.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=DATA, delete=False) as f:
        np.save(f, embedding, allow_pickle=False)
    key = uuid.uuid4().hex
    filename = 'profile-' + key + '.npy'
    os.replace(f.name, DATA / filename)
    config = settings()
    profiles = voice_profiles()
    profiles[key] = {'name': (name or 'Mi voz').strip(), 'file': filename,
                     'created': time.strftime('%Y-%m-%d %H:%M'), 'input': input_name}
    config.update(profiles=profiles, profile=key)
    save(config)
    if config.get('personal') and not personal_running():
        change('personal', True)
    print('Perfil «' + profiles[key]['name'] + '» guardado y seleccionado.', flush=True)


def serve():
    # This service is an optional consumer of RNNoise. It must never restart it,
    # select a different physical port, change its gain, or become the default.
    config = settings()
    if not config.get('personal'):
        return
    if not model_ready() or not profile_path().exists():
        raise ValueError('Registra tu voz antes de activar Solo mi voz.')
    if FILTER not in [s['name'] for s in sources()]:
        raise ValueError('Activa primero el aislamiento de ruido. La entrada normal no se modificó.')
    if Path(sys.prefix) != DATA / 'venv':
        os.execv(str(DATA / 'venv/bin/python'), [str(DATA / 'venv/bin/python'), __file__, 'serve'])
    import numpy as np
    _, session = load_model()
    session.set_enrollment_emb(np.load(profile_path(), allow_pickle=False))
    active_profile = selected_profile()
    capture = playback = None
    def terminate(*_):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, terminate)
    try:
        ensure_endpoint()
        pactl('set-source-mute', SOURCE, '1' if config.get('muted') else '0')
        capture = subprocess.Popen(['parec', '--client-name=dotfiles-microphone',
            '--stream-name=Solo-mi-voz', '--device=' + FILTER,
            '--format=s16le', '--rate=16000', '--channels=1',
            '--latency-msec=20', '--process-time-msec=10'], stdout=subprocess.PIPE, bufsize=0)
        playback = subprocess.Popen(['pacat', '--playback', '--device=' + BUS,
            '--format=s16le', '--rate=16000', '--channels=1', '--latency-msec=20', '--process-time-msec=10'], stdin=subprocess.PIPE, bufsize=0)
        gate = VoiceGate()
        set_status(source=FILTER, description='Solo mi voz · experimental',
                   noise=True, personal=True, state='active')
        slow = 0
        last_status = 0
        while True:
            raw = read_exact(capture.stdout, 5120)
            if len(raw) != 5120:
                raise RuntimeError('La prueba dejó de recibir audio. Aislamiento de voz sigue siendo la entrada normal.')
            begin = time.monotonic()
            if selected_profile() != active_profile:
                session.set_enrollment_emb(np.load(profile_path(), allow_pickle=False))
                active_profile = selected_profile()
                gate = VoiceGate()
            samples = np.frombuffer(raw, dtype='<i2').astype(np.float32) / 32768
            probability = float(session.process_chunk(samples))
            raw = gate.process(array.array('h', raw), probability)
            processing_ms = (time.monotonic() - begin) * 1000
            if time.monotonic() - last_status >= 1:
                set_status(state='active', profile=active_profile, probability=probability,
                           passing=gate.previous > 0, processing_ms=round(processing_ms, 1),
                           chunk_ms=160, capture_buffer_ms=20, playback_buffer_ms=20, updated=time.time())
                last_status = time.monotonic()
            slow = slow + 1 if time.monotonic() - begin > 0.16 else 0
            if slow >= 32:
                raise RuntimeError('La prueba no alcanza tiempo real. Usa Aislamiento de voz.')
            write_exact(playback.stdin, raw)
    finally:
        for process in (capture, playback):
            if process is not None:
                with suppress(ProcessLookupError):
                    process.terminate()
                try:
                    process.wait(timeout=3)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=1)
        try:
            cleanup_endpoint()
        finally:
            set_status(state='stopped', description='Prueba detenida; entrada normal: Aislamiento de voz')


def cleanup_endpoint():
    # Remove only this experiment's modules; never unload the RNNoise filter.
    loaded_modules = modules()
    for module_type, marker in (('module-remap-source', 'source_name=' + SOURCE),
                                ('module-null-sink', 'sink_name=' + BUS)):
        for module in loaded_modules:
            if module.get('name') == module_type and marker in module.get('argument', '').split():
                pactl('unload-module', str(module['index']))


def cleanup_legacy_endpoint():
    """Migrate users of the obsolete bridge before removing its own modules."""
    items = sources()
    if FILTER not in [s['name'] for s in items]:
        raise ValueError('Aislamiento de voz debe estar disponible antes de retirar la entrada anterior.')
    legacy = next((s for s in items if s['name'] == 'dotfiles_microphone'), None)
    if legacy:
        for stream in json.loads(pactl('-f', 'json', 'list', 'source-outputs')):
            if stream.get('source') == legacy['index']:
                pactl('move-source-output', str(stream['index']), FILTER)
        if pactl('get-default-source') == legacy['name']:
            pactl('set-default-source', FILTER)
    loaded_modules = modules()
    for module_type, marker in (('module-remap-source', 'source_name=dotfiles_microphone'),
                                ('module-null-sink', 'sink_name=dotfiles_microphone_bus')):
        for module in loaded_modules:
            if module.get('name') == module_type and marker in module.get('argument', '').split():
                pactl('unload-module', str(module['index']))


def ensure_personal_service():
    unit = CONFIG.parent / 'systemd/user/dotfiles-microphone.service'
    if unit.exists():
        return
    template = Path(__file__).resolve().parents[2] / '.config/systemd/user/dotfiles-microphone.service'
    if not template.exists():
        raise ValueError('Falta el servicio en el host. Reinstala el componente voice-isolation.')
    # systemctl disable can remove Stow's externally linked unit as well as
    # its startup link. Recreate only our missing registration from its source.
    unit.parent.mkdir(parents=True, exist_ok=True)
    if unit.is_symlink():
        unit.unlink()
    unit.symlink_to(template)
    run('systemctl', '--user', 'daemon-reload')


def personal_running():
    return subprocess.run(['systemctl', '--user', 'is-active', '--quiet',
        'dotfiles-microphone.service'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 0


def change(key, value, port=None):
    config = settings()
    if key == 'personal':
        if value:
            if not model_ready() or not profile_path().exists():
                raise ValueError('Registra primero tu voz en el panel.')
            if FILTER not in [s['name'] for s in sources()]:
                raise ValueError('Activa primero el aislamiento de ruido.')
        config[key] = value
        save(config)
        started = time.time()
        try:
            if value:
                ensure_personal_service()
                run('systemctl', '--user', 'enable', 'dotfiles-microphone.service')
                cleanup_legacy_endpoint()
            # Keep the unit registered; serve() reads the saved personal flag.
            run('systemctl', '--user', 'restart' if value else 'stop', 'dotfiles-microphone.service')
            if value:
                # systemctl restart alone only confirms that the process was spawned.
                for _ in range(300):
                    if not personal_running():
                        raise RuntimeError('El reconocimiento no pudo iniciarse. Consulta el estado del servicio.')
                    try:
                        status = json.loads(STATE.read_text())
                    except (OSError, ValueError):
                        status = {}
                    if status.get('state') == 'active' and status.get('updated', 0) >= started:
                        break
                    time.sleep(0.1)
                else:
                    raise RuntimeError('El reconocimiento no recibió audio en 30 segundos. Revisa la entrada.')
        except Exception:
            with suppress(Exception):
                run('systemctl', '--user', 'stop', 'dotfiles-microphone.service')
            config['personal'] = False
            save(config)
            raise
        if value:
            print('Guardado y activo. En tu aplicación selecciona «Microfono-controlado-Solo-mi-voz».')
        else:
            print('Prueba detenida. Aislamiento de voz no se modificó.')
        return
    if key == 'source':
        source = choose(sources(), value, '')
        check_port(source, port)
        if port:
            pactl('set-source-port', source['name'], port)
        config['port'] = port or source.get('active_port')
        config.setdefault('levels', {}).setdefault(level_key(source, port), channel_levels(source))
        set_filter_source(value)
    config[key] = value
    save(config)
    if key == 'noise':
        if value:
            run('systemctl', '--user', 'restart', 'dotfiles-voice-isolation.service')
            if config.get('personal'):
                run('systemctl', '--user', 'restart', 'dotfiles-microphone.service')
        else:
            run('systemctl', '--user', 'stop', 'dotfiles-microphone.service')
            run('systemctl', '--user', 'stop', 'dotfiles-voice-isolation.service')
            source = choose(sources(), config.get('source', ''), '')
            pactl('set-default-source', source['name'])
            config['personal'] = False
            save(config)
    elif key == 'source' and config.get('noise', True):
        run('systemctl', '--user', 'restart', 'dotfiles-voice-isolation.service')
        if config.get('personal'):
            run('systemctl', '--user', 'restart', 'dotfiles-microphone.service')


def change_volume(value):
    value = float(value)
    if not math.isfinite(value) or not 0 <= value <= 100:
        raise ValueError('El volumen debe estar entre 0 y 100.')
    config = settings()
    source = choose(sources(), config.get('source', ''), pactl('get-default-source'))
    pactl('set-source-volume', source['name'], str(value) + '%')
    set_filter_source(source['name'])
    count = len(channel_levels(source)) or 1
    config.setdefault('levels', {})[level_key(source, config.get('port'))] = [round(65536 * value / 100)] * count
    save(config)


def gui(compact=False):
    import gi
    gi.require_version('Gtk', '3.0')
    from gi.repository import Gtk, Gdk, GLib
    lock = open(Path(os.getenv('XDG_RUNTIME_DIR', '/tmp')) / ('dotfiles-mic-mini.lock' if compact else 'dotfiles-mic-panel.lock'), 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return

    class Panel(Gtk.Window):
        def __init__(self):
            super().__init__(title='Micrófono y aislamiento')
            self.set_role('dotfiles-microphone')
            self.set_type_hint(Gdk.WindowTypeHint.DIALOG)
            self.set_position(Gtk.WindowPosition.CENTER)
            self.set_default_size(420 if compact else 570, 380 if compact else 540)
            if compact:
                self.set_decorated(False)
                self.set_skip_taskbar_hint(True)
                self.set_keep_above(True)
            self.set_name('microphone-panel')
            css = Gtk.CssProvider()
            css.load_from_data(b'''
                #microphone-panel { background: #181825; color: #cdd6f4; font-family: Lexend; }
                #microphone-panel button, #microphone-panel combobox { background: #313244; color: #cdd6f4; border-color: #45475a; box-shadow: none; text-shadow: none; border-radius: 8px; }
                #microphone-panel button:hover { background: #45475a; }
                #microphone-panel check { background: #242438; border-color: #585b70; }
                #microphone-panel check:checked { background: #cba6f7; color: #181825; }
                #microphone-panel :disabled { color: #6c7086; }
                #microphone-panel .command-hint { font-family: monospace; font-size: 11px; color: #a6adc8; opacity: 0.65; }
                #microphone-panel button.close-button { background: transparent; border: 0; border-radius: 50%; min-width: 28px; min-height: 28px; padding: 0; color: #a6adc8; }
                #microphone-panel button.close-button:hover { background: #45303c; color: #f38ba8; }
                #microphone-panel button.close-button:active { background: #f38ba8; color: #181825; }
            ''')
            Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10 if compact else 14, margin=18 if compact else 22)
            self.add(box)
            header = Gtk.Box(spacing=10)
            title = Gtk.Label(xalign=0)
            title.set_markup('<b>Micrófono</b>' if compact else '<b>Micrófono y aislamiento</b>')
            header.pack_start(title, True, True, 0)
            close = Gtk.Button()
            close.set_image(Gtk.Image.new_from_icon_name('window-close-symbolic', Gtk.IconSize.MENU))
            close.set_relief(Gtk.ReliefStyle.NONE)
            close.set_tooltip_text('Cerrar · Esc')
            close.get_accessible().set_name('Cerrar')
            close.get_style_context().add_class('close-button')
            close.connect('clicked', lambda _: self.destroy())
            header.pack_end(close, False, False, 0)
            box.pack_start(header, False, False, 0)
            self.info = Gtk.Label(xalign=0, wrap=True)
            box.pack_start(self.info, False, False, 0)
            self.combo = Gtk.ComboBoxText()
            self.combo.connect('changed', self.select)
            box.pack_start(Gtk.Label(label='Micrófono físico de entrada', xalign=0), False, False, 0)
            box.pack_start(self.combo, False, False, 0)
            self.enabled = Gtk.CheckButton(label='Micrófono encendido')
            self.enabled.connect('toggled', lambda w: None if self.refreshing else self.job([__file__, 'on' if w.get_active() else 'off']))
            def command_row(widget, command):
                row = Gtk.Box(spacing=12)
                row.pack_start(widget, True, True, 0)
                hint = Gtk.Label(xalign=1)
                hint.get_style_context().add_class('command-hint')
                def update(w):
                    text = command(w.get_active())
                    hint.set_text(text)
                    hint.set_tooltip_text(text)
                widget.connect('toggled', update)
                update(widget)
                row.pack_end(hint, False, False, 0)
                box.pack_start(row, False, False, 0)
            command_row(self.enabled, lambda active: 'Alt + Ctrl + M')
            box.pack_start(Gtk.Label(label='Volumen del micrófono físico', xalign=0), False, False, 0)
            self.volume = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, 100, 1)
            self.volume.set_digits(0)
            self.volume.connect('button-release-event', lambda w, _: self.job([__file__, 'volume', str(w.get_value())]))
            self.volume.connect('key-release-event', lambda w, _: self.job([__file__, 'volume', str(w.get_value())]))
            box.pack_start(self.volume, False, False, 0)
            self.noise = Gtk.CheckButton(label='Aislamiento de ruido (RNNoise)')
            self.personal = Gtk.CheckButton(label='Solo mi voz · usar el perfil seleccionado')
            self.noise.connect('toggled', lambda w: self.toggle('noise', w))
            self.personal.connect('toggled', lambda w: self.toggle('personal', w))
            command_row(self.noise, lambda active: 'Alt + Ctrl + N')
            command_row(self.personal, lambda active: 'Alt + Ctrl + V')
            help_label = Gtk.Label(label='Para filtrar otras voces, selecciona «Microfono-controlado-Solo-mi-voz» en tu aplicación.\nLos cambios y el perfil seleccionado se guardan automáticamente. No separa voces simultáneas.', xalign=0, wrap=True)
            if not compact:
                box.pack_start(help_label, False, False, 0)
            self.profiles = Gtk.ComboBoxText()
            self.profiles.connect('changed', lambda w: self.job([__file__, 'profile', w.get_active_id()])
                if not self.refreshing and w.get_active_id() else None)
            box.pack_start(Gtk.Label(label='Perfil de voz guardado', xalign=0), False, False, 0)
            profile_row = Gtk.Box(spacing=8)
            profile_row.pack_start(self.profiles, True, True, 0)
            self.delete = Gtk.Button(label='Eliminar perfil')
            self.delete.connect('clicked', self.confirm_delete)
            profile_row.pack_end(self.delete, False, False, 0)
            box.pack_start(profile_row, False, False, 0)
            self.profile_status = Gtk.Label(xalign=0, wrap=True)
            box.pack_start(self.profile_status, False, False, 0)
            if not compact:
                create = Gtk.Button(label='Configurar un nuevo perfil de voz…')
                create.connect('clicked', self.new_profile)
                box.pack_start(create, False, False, 0)
            refresh = Gtk.Button(label='Actualizar micrófonos / audífonos conectados')
            refresh.connect('clicked', lambda _: self.refresh())
            box.pack_start(refresh, False, False, 0)
            if compact:
                configure = Gtk.Button(label='Configuración y registro de mi voz…')
                configure.connect('clicked', lambda _: (subprocess.Popen([__file__]), self.destroy()))
                box.pack_start(configure, False, False, 0)
            box.pack_start(Gtk.Separator(), False, False, 0)
            box.pack_start(Gtk.Label(label='Aplicaciones usando tu micrófono', xalign=0), False, False, 0)
            self.apps_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
            box.pack_start(self.apps_box, False, False, 0)
            self.apps_fingerprint = None
            self.message = Gtk.Label(xalign=0, wrap=True)
            box.pack_start(self.message, False, False, 0)
            self.busy = False
            self.refresh()
            self.connect('destroy', Gtk.main_quit)
            self.connect('key-press-event', lambda _, event: self.destroy() if event.keyval == Gdk.KEY_Escape else False)
            GLib.timeout_add_seconds(2, self.status)

        def confirm_delete(self, _):
            key = self.profiles.get_active_id()
            profile = voice_profiles().get(key)
            if self.busy or not profile:
                return
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                message_type=Gtk.MessageType.QUESTION, buttons=Gtk.ButtonsType.NONE,
                text='¿Eliminar el perfil «' + profile['name'] + '»?')
            dialog.format_secondary_text('Se borrará el perfil guardado. Si es el último, Solo mi voz se apagará.')
            dialog.add_button('Cancelar', Gtk.ResponseType.CANCEL)
            dialog.add_button('Eliminar perfil', Gtk.ResponseType.OK)
            response = dialog.run()
            dialog.destroy()
            if response == Gtk.ResponseType.OK:
                self.job([__file__, 'delete-profile', key])

        def new_profile(self, _):
            if self.busy:
                return
            dialog = Gtk.Dialog(title='Nuevo perfil de voz', transient_for=self, modal=True)
            dialog.set_default_size(540, 370)
            dialog.set_name('microphone-panel')
            dialog.add_button('Cancelar', Gtk.ResponseType.CANCEL)
            dialog.add_button('Grabar y guardar perfil (15 s)', Gtk.ResponseType.OK)
            content = dialog.get_content_area()
            content.set_spacing(14)
            content.set_border_width(20)
            content.pack_start(Gtk.Label(label='Nombre del perfil', xalign=0), False, False, 0)
            entry = Gtk.Entry(placeholder_text='Nombre del perfil, por ejemplo: Carlos · audífonos')
            content.pack_start(entry, False, False, 0)
            content.pack_start(Gtk.Label(label='Al iniciar tendrás 3 segundos para prepararte. Lee con voz normal,\nsin otras personas hablando. Sigue leyendo hasta que termine la grabación de 15 segundos;\nno necesitas terminar todo el texto. El perfil se guarda y selecciona al terminar.',
                                        xalign=0, wrap=True), False, False, 0)
            content.pack_start(Gtk.Label(label='Texto para leer en voz alta', xalign=0), False, False, 0)
            text = Gtk.Label(label='Hoy estoy configurando mi perfil de voz para que el micrófono reconozca '
                'mi manera de hablar. Quiero conversar con claridad, a un volumen natural y sin gritar. '
                'Esta es mi voz cuando trabajo, explico mis ideas y hablo con otras personas cada día. '
                'Por la mañana reviso mis pendientes, organizo mis tareas y preparo lo que necesito para empezar. '
                'A veces hago preguntas, comparto una noticia o cuento algo que me ocurrió durante la semana. '
                'Me gusta hablar con tranquilidad y pronunciar cada palabra de forma natural. '
                'Ahora sigo leyendo este texto mientras el sistema aprende a reconocer las características de mi voz, '
                'con mis pausas habituales y mi tono de conversación.',
                xalign=0, wrap=True, selectable=True)
            text.set_max_width_chars(65)
            content.pack_start(text, True, True, 0)
            progress = Gtk.Label(label='Listo para grabar', xalign=0, wrap=True)
            content.pack_start(progress, False, False, 0)
            dialog.show_all()
            # Keep the reading text visible throughout the recording.
            def response(d, result):
                if result != Gtk.ResponseType.OK:
                    d.destroy()
                elif not entry.get_text().strip():
                    entry.set_placeholder_text('Escribe un nombre para guardar el perfil')
                else:
                    d.get_widget_for_response(Gtk.ResponseType.OK).set_sensitive(False)
                    entry.set_sensitive(False)
                    d.set_modal(False)
                    self.job([__file__, 'configure-profile', entry.get_text().strip()], d.destroy, progress.set_text)
            dialog.connect('response', response)

        def status(self):
            try:
                refreshing = self.refreshing
                self.refreshing = True
                try:
                    self.enabled.set_active(not muted())
                    config = settings()
                    self.noise.set_active(config.get('noise', True))
                    self.personal.set_active(config.get('personal', False))
                    self.personal.set_sensitive(model_ready() and profile_path().exists())
                finally:
                    self.refreshing = refreshing
                apps = recording_apps()
                fingerprint = json.dumps(apps)
                if fingerprint != self.apps_fingerprint:
                    self.apps_fingerprint = fingerprint
                    for child in self.apps_box.get_children(): child.destroy()
                    if not apps:
                        self.apps_box.pack_start(Gtk.Label(label='Ninguna aplicación externa', xalign=0), False, False, 0)
                    for app in apps:
                        button = Gtk.CheckButton(label=app['name'] + (' · silenciada' if app['muted'] else ' · capturando'))
                        button.set_active(not app['muted'])
                        ids = ','.join(map(str, app['streams']))
                        button.connect('toggled', lambda w, ids=ids: self.job([__file__, 'app', ids, 'on' if w.get_active() else 'off']))
                        self.apps_box.pack_start(button, False, False, 0)
                    self.apps_box.show_all()
                normal = next((s for s in sources() if s['name'] == FILTER), None)
                experiment = personal_running()
                self.refreshing = True
                self.personal.set_active(experiment)
                self.refreshing = refreshing
                try:
                    state = json.loads(STATE.read_text())
                except (OSError, ValueError):
                    state = {}
                profile = voice_profiles().get(selected_profile(), {})
                feedback = (' · voz reconocida' if state.get('passing') else ' · esperando la voz del perfil') if experiment else ' · filtro apagado'
                if state.get('state') == 'error':
                    feedback = ' · ' + state.get('error', 'Error al procesar audio')
                self.profile_status.set_text(('Guardado: ' + profile['name'] if profile else 'Crea un perfil para reconocer tu voz') + feedback)
                self.info.set_text(('Entrada normal: Aislamiento de voz' if normal else 'Entrada normal: micrófono físico')
                    + (' · Solo mi voz activo' if experiment else ' · Solo mi voz apagado'))
            except (OSError, ValueError, KeyError, subprocess.SubprocessError):
                self.info.set_text('No se pudo consultar el audio. La entrada normal no se modificó.')
            return True

        def refresh(self):
            self.refreshing = True
            config = settings()
            self.profiles.remove_all()
            for key, profile in voice_profiles().items():
                self.profiles.append(key, profile['name'])
            self.profiles.set_active_id(selected_profile())
            self.delete.set_sensitive(bool(voice_profiles()))
            self.combo.remove_all()
            try:
                items = sources()
                for s in physical(items):
                    ports = [p for p in s.get('ports', []) if p.get('availability') != 'not available']
                    for p in ports or [{'name': ''}]:
                        self.combo.append(json.dumps([s['name'], p['name']]), source_label(s, p['name']))
                try:
                    selected = choose(items, config.get('source', ''), pactl('get-default-source'))
                    self.combo.set_active_id(json.dumps([selected['name'], config.get('port') or selected.get('active_port') or '']))
                    levels = channel_levels(selected)
                    self.volume.set_value(100 * sum(levels) / (len(levels) * 65536) if levels else 100)
                except ValueError:
                    pass
                self.noise.set_active(config.get('noise', True))
                self.enabled.set_active(not muted())
                self.personal.set_active(config.get('personal', False))
                self.personal.set_sensitive(model_ready() and profile_path().exists())
            except Exception as e:
                self.message.set_text(str(e))
            self.refreshing = False
            self.status()

        def select(self, combo):
            if not self.refreshing and combo.get_active_id():
                name, port = json.loads(combo.get_active_id())
                self.job([__file__, 'source', name, port])

        def toggle(self, key, widget):
            if not self.refreshing:
                self.job([__file__, key, 'on' if widget.get_active() else 'off'])

        def job(self, command, callback=None, progress=None):
            if self.busy:
                return
            self.busy = True
            self.message.set_text('Preparando…')
            def work():
                try:
                    p = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
                    last = ''
                    for line in p.stdout:
                        last = line.strip()
                        GLib.idle_add(self.message.set_text, last[-450:])
                        if progress:
                            GLib.idle_add(progress, last[-450:])
                    if p.wait():
                        raise RuntimeError(last or 'No se pudo aplicar el cambio. Revisa el servicio.')
                    GLib.idle_add(self.message.set_text, last[-450:] or 'Cambios guardados automáticamente.')
                except Exception as e:
                    GLib.idle_add(self.message.set_text, str(e))
                finally:
                    GLib.idle_add(done)
            def done():
                self.busy = False
                self.refresh()
                if callback:
                    callback()
                return False
            threading.Thread(target=work, daemon=True).start()

    panel = Panel()
    panel.show_all()
    Gtk.main()


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('command', nargs='?', default='gui', choices=['gui', 'compact', 'bar', 'on', 'off', 'toggle', 'app', 'serve', 'status', 'list', 'source', 'noise', 'personal', 'volume', 'enroll', 'configure-profile', 'profile', 'delete-profile', 'model-check', 'cleanup-legacy'])
    parser.add_argument('value', nargs='?')
    parser.add_argument('port', nargs='?')
    args = parser.parse_args()
    if args.command == 'gui': gui()
    elif args.command == 'compact': gui(True)
    elif args.command == 'bar': print(bar_status())
    elif args.command in ('on', 'off', 'toggle'): microphone_switch(args.command)
    elif args.command == 'app':
        if args.port not in ('on', 'off'): raise ValueError('Usa app ID on u off.')
        for index in args.value.split(','):
            pactl('set-source-output-mute', str(int(index)), '0' if args.port == 'on' else '1')
    elif args.command == 'serve': serve()
    elif args.command == 'cleanup-legacy': cleanup_legacy_endpoint()
    elif args.command == 'status':
        print(STATE.read_text() if STATE.exists() else 'No hay procesamiento activo.')
    elif args.command == 'list':
        for source in physical(sources()): print(source['name'], '\t', source.get('description', ''))
    elif args.command == 'source': change('source', args.value, args.port)
    elif args.command == 'volume': change_volume(args.value)
    elif args.command in ('noise', 'personal'):
        if args.value not in ('on', 'off', 'toggle'): raise ValueError('Usa on, off o toggle.')
        current = personal_running() if args.command == 'personal' and args.value == 'toggle' else settings().get(args.command, True)
        change(args.command, not current if args.value == 'toggle' else args.value == 'on')
    elif args.command == 'enroll': enroll(args.value)
    elif args.command == 'configure-profile': configure_profile(args.value)
    elif args.command == 'profile': select_profile(args.value)
    elif args.command == 'delete-profile': delete_profile(args.value)
    elif args.command == 'model-check': model_check()


if __name__ == '__main__':
    try:
        main()
    except Exception as error:
        if 'serve' in sys.argv[1:]:
            set_status(state='error', error=str(error))
        sys.exit(str(error))
