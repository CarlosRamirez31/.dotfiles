#!/usr/bin/env bash
set -euo pipefail

case ${CONTAINER_ID:-} in
    kalilinux | parrotos) ;;
    *)
        printf 'Unsupported Distrobox profile: %s\n' "${CONTAINER_ID:-<empty>}" >&2
        exit 2
        ;;
esac

source_config=${XDG_CONFIG_HOME:-$HOME/.config}/nvim
[[ -r $source_config/init.lua ]] || {
    printf 'Neovim configuration not found: %s\n' "$source_config" >&2
    exit 1
}

# LazyVim records viewed news in its config directory. Provision from a
# temporary copy so unattended setup never dirties the dotfiles repository;
# plugins and Tree-sitter parsers still install in the normal user data path.
temporary_config=$(mktemp -d)
trap 'rm -rf -- "$temporary_config"' EXIT
cp -aL -- "$source_config" "$temporary_config/nvim"

XDG_CONFIG_HOME=$temporary_config nvim --headless "+Lazy! sync" +qa
XDG_CONFIG_HOME=$temporary_config nvim --headless \
    "+lua require('config.treesitter').install()" +qa

printf 'Neovim plugins and Tree-sitter parsers installed for %s.\n' "$CONTAINER_ID"
