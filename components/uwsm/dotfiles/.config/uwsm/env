export GDK_BACKEND=wayland,x11,*
# Hyprland 0.56.x cannot import GTK's GPU buffers reliably through VMware's
# vmwgfx. Use the safe renderer only there; physical machines and other VMs
# retain normal GPU acceleration.
if [[ -r /sys/class/dmi/id/sys_vendor ]] \
    && grep -qi vmware /sys/class/dmi/id/sys_vendor; then
    export GSK_RENDERER=cairo
fi
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
# User commands managed by these dotfiles live here. Add the directory
# explicitly because display managers can start UWSM with a minimal PATH.
case ":${PATH:-}:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin${PATH:+:$PATH}" ;;
esac
export TERMINAL=dotfiles-terminal
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
export XDG_SESSION_TYPE=wayland
export XCURSOR_THEME=Bibata-Modern-Classic
export XCURSOR_SIZE=24
export HYPRCURSOR_THEME=Bibata-Modern-Classic
export HYPRCURSOR_SIZE=24
export SSH_AUTH_SOCK="$XDG_RUNTIME_DIR/gcr/ssh"
export UWSM_FINALIZE_VARNAMES="PATH GDK_BACKEND GSK_RENDERER MOZ_ENABLE_WAYLAND ELECTRON_OZONE_PLATFORM_HINT TERMINAL XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE XCURSOR_THEME XCURSOR_SIZE HYPRCURSOR_THEME HYPRCURSOR_SIZE SSH_AUTH_SOCK"
