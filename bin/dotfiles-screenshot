#!/usr/bin/env bash
set -euo pipefail

mode=${1:-full}
pictures_dir=$(xdg-user-dir PICTURES 2>/dev/null || true)
[[ -n $pictures_dir ]] || pictures_dir="$HOME/Pictures"
output_dir="$pictures_dir/Screenshots"
destination="$output_dir/$(date +%Y-%m-%d_%H-%M-%S-%N).png"
cache_dir="${XDG_RUNTIME_DIR:?}/dotfiles-screenshots"
mkdir -p -- "$cache_dir"
chmod 700 -- "$cache_dir"
output=$(mktemp "$cache_dir/capture-XXXXXXXX.png")
trap 'if [[ ! -s $output ]]; then rm -f -- "$output"; fi' EXIT
mkdir -p -- "$output_dir"

case $mode in
    full)
        maim "$output"
        ;;
    area)
        geometry=$(slop -f '%x %y %w %h') || exit 0
        [[ -n $geometry ]] || exit 0
        read -r x y width height <<<"$geometry"
        maim -g "${width}x${height}+${x}+${y}" "$output"
        ;;
    *)
        printf 'Usage: %s {full|area}\n' "${0##*/}" >&2
        exit 2
        ;;
esac

xclip -selection clipboard -t image/png -i <"$output"
if ! shown=$(python3 - "$output" "$destination" <<'PY' | awesome-client 2>/dev/null
import os
import sys

path = "".join("\\%03d" % byte for byte in os.fsencode(sys.argv[1]))
destination = "".join("\\%03d" % byte for byte in os.fsencode(sys.argv[2]))
print('return require("screenshot-card").show("' + path + '","' + destination + '")')
PY
) || [[ $shown != *"boolean true"* ]]; then
    notify-send -a Screenshot -i "$output" 'Captura en el portapapeles; pendiente de guardar' "$(basename -- "$output")"
fi
