#!/usr/bin/env bash
set -euo pipefail

command -v brightnessctl >/dev/null 2>&1 || exit 0
brightnessctl --list 2>/dev/null | grep -q . || exit 0

state_dir=${XDG_RUNTIME_DIR:-/tmp}
state_file="$state_dir/dotfiles-idle-brightness-${UID}"

case ${1:-} in
    dim)
        brightnessctl get >"$state_file"
        brightnessctl --quiet set 10%
        ;;
    restore)
        if [[ -s $state_file ]]; then
            brightnessctl --quiet set "$(<"$state_file")"
            rm -f -- "$state_file"
        fi
        ;;
    *)
        printf 'Usage: %s {dim|restore}\n' "${0##*/}" >&2
        exit 2
        ;;
esac
